# Cloudflare Pages/Workers build environment
NODE_VERSION=22.16.0
PNPM_VERSION=10.16.1
PUBLIC_SITE_URL=https://payrentax.me

# Monetization (all optional — features stay dormant until set)
# Set to true after Google AdSense approves the site to render ad slots.
PUBLIC_ADS_ENABLED=false
# AdSense client ID, e.g. ca-pub-1234567890123456. Enables the AdSense script tag.
PUBLIC_ADSENSE_CLIENT=
# Affiliate tracking URLs from CJ/Impact. Leave empty to hide the tax-filing CTA.
PUBLIC_AFF_TURBOTAX_URL=
PUBLIC_AFF_HRBLOCK_URL=
PUBLIC_AFF_FREETAXUSA_URL=

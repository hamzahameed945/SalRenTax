---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import RelatedCalculators from '../../../../components/content/RelatedCalculators.astro';
import GrDoroCalculator from '../../../../components/islands/GrDoroCalculator';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'el-GR' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'Δώρο Χριστουγέννων 2026: Υπολογισμός — PayRenTax',
  'Υπολογίστε το δώρο Χριστουγέννων 2026: με μισθό €1.500 και πλήρη απασχόληση δικαιούστε €1.562,50 μικτά. Αναλογικός υπολογισμός, προθεσμία 21 Δεκεμβρίου.',
  '/el-gr/labor/doro-hristougennon-calculator/',
);

const faqItems = [
  {
    question: 'Πότε καταβάλλεται το δώρο Χριστουγέννων 2026;',
    answer:
      'Το δώρο Χριστουγέννων 2026 πρέπει να καταβληθεί το αργότερο έως τις 21 Δεκεμβρίου 2026. Ο εργοδότης μπορεί να το καταβάλει και νωρίτερα, αλλά όχι αργότερα από αυτή την ημερομηνία. Αν δεν καταβληθεί εγκαίρως, μπορείτε να απευθυνθείτε στην Επιθεώρηση Εργασίας.',
  },
  {
    question: 'Πώς υπολογίζεται το δώρο με αναλογία;',
    answer:
      'Για κάθε 19 ημέρες εργασιακής σχέσης μέσα στην περίοδο 1 Μαΐου – 31 Δεκεμβρίου δικαιούστε ποσό ίσο με τα 2/25 του μηνιαίου μισθού σας. Ακόμη και για διάστημα μικρότερο των 19 ημερών δικαιούστε αναλογικό κλάσμα. Το ποσό πολλαπλασιάζεται με 1,041666 για το επίδομα αδείας. Παράδειγμα: με μισθό €1.500 και 100 ημέρες εργασίας, το δώρο είναι περίπου €657,89 μικτά.',
  },
  {
    question: 'Δικαιούνται δώρο οι δημόσιοι υπάλληλοι;',
    answer:
      'Όχι. Το δώρο Χριστουγέννων με αυτόν τον υπολογισμό ισχύει μόνο για τον ιδιωτικό τομέα. Το δώρο των δημοσίων υπαλλήλων και των συνταξιούχων έχει καταργηθεί.',
  },
  {
    question: 'Με ποιον μισθό υπολογίζεται το δώρο;',
    answer:
      'Βάση για τον υπολογισμό είναι οι τακτικές αποδοχές που καταβάλλονται στις 10 Δεκεμβρίου. Αν η εργασιακή σχέση έχει λυθεί πριν από αυτή την ημερομηνία, λαμβάνονται υπόψη οι αποδοχές που καταβάλλονταν την ημέρα που λύθηκε η εργασιακή σχέση.',
  },
  {
    question: 'Το δώρο Χριστουγέννων φορολογείται;',
    answer:
      'Ναι. Το δώρο υπόκειται σε ασφαλιστικές εισφορές ΕΦΚΑ και σε φόρο μισθωτών υπηρεσιών, όπως ακριβώς και οι τακτικές αποδοχές. Η αριθμομηχανή δείχνει το μικτό ποσό — το καθαρό ποσό που θα λάβετε είναι μικρότερο μετά τις κρατήσεις.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: t.navigation.labor, href: buildLocalePath(locale, 'labor') },
      {
        label: 'Δώρο Χριστουγέννων',
        href: buildLocalePath(locale, 'labor/doro-hristougennon-calculator'),
      },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">Υπολογιστής Δώρου Χριστουγέννων 2026</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      Με μηνιαίο μισθό <strong>€1.500</strong> και απασχόληση όλη την περίοδο 1 Μαΐου – 31
      Δεκεμβρίου, το δώρο Χριστουγέννων 2026 είναι
      <strong>€1.562,50</strong> μικτά. Καταβάλλεται το αργότερο έως τις
      <strong>21 Δεκεμβρίου 2026</strong> και ισχύει για τον <strong>ιδιωτικό τομέα</strong>.
    </p>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold">Παράδειγμα: δώρο με μισθό €1.500 (2026)</h2>
      <table class="mt-4 w-full text-sm">
        <tbody>
          <tr>
            <td>Πλήρες δώρο (1 μηνιαίος μισθός)</td>
            <td>€1.500,00</td>
          </tr>
          <tr>
            <td>Επίδομα αδείας (×1,041666)</td>
            <td>€62,50</td>
          </tr>
          <tr class="font-semibold">
            <td>Σύνολο μικτό δώρο</td>
            <td>€1.562,50</td>
          </tr>
        </tbody>
      </table>
      <p class="mt-4 text-xs text-slate-500">
        Όποιος εργάστηκε όλη την περίοδο 1/5–31/12 δικαιούται έναν ολόκληρο μισθό· για μικρότερο
        διάστημα δικαιούται τα 2/25 του μισθού για κάθε 19 ημέρες εργασίας, με προσαύξηση 1,041666
        για το επίδομα αδείας. Βάση είναι οι τακτικές αποδοχές της 10ης Δεκεμβρίου. Δοκιμάστε άλλα
        σενάρια στην αριθμομηχανή.
      </p>
    </div>

    <div class="mt-8">
      <InContentAd slotId="gr-doro-1" />
    </div>

    <div class="mt-10">
      <h2 class="text-xl font-semibold">Υπολογίστε το δώρο σας</h2>
      <div class="mt-4">
        <GrDoroCalculator client:load initialSalary={1500} />
      </div>
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.dataSource} Οι τιμές είναι εκτιμήσεις για το 2026· η
      μισθοδοσία του εργοδότη σας είναι η καθοριστική.
    </p>

    <CalculatorFAQ heading="Δώρο Χριστουγέννων 2026: συχνές ερωτήσεις" items={faqItems} />

    <RelatedCalculators
      heading={t.common.relatedCalculators}
      links={[
        { label: t.labor.categoryTitle, href: '/el-gr/labor/' },
        { label: 'Αρχική — Ελλάδα', href: '/el-gr/' },
      ]}
    />
  </article>
</BaseLayout>

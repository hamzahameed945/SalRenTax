---
import CalculatorResource from '../../../../components/content/CalculatorResource.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import PayFrequencyConverter from '../../../../components/islands/PayFrequencyConverter';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'es-MX' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'Conversor de Periodo de Pago México — PayRenTax',
  t.salary.payFrequency.intro,
  '/es-mx/salary/conversor-periodo-pago/',
);

const faqItems = [
  {
    question: '¿Con qué frecuencia se paga el salario en México?',
    answer:
      'La Ley Federal del Trabajo establece que el salario debe pagarse en períodos no mayores a una semana para trabajo a destajo, y no mayores a 15 días (quincenales) para los demás trabajadores. El pago quincenal (dos veces al mes) es el más común en México.',
  },
  {
    question: '¿Cómo convierto mi sueldo quincenal a mensual?',
    answer:
      'Multiplica tu sueldo quincenal por 2 para obtener el mensual base. Sin embargo, algunos meses tienen 3 quincenas de pago según el calendario, por lo que el cálculo anualizado exacto es: sueldo quincenal × 24 = sueldo anual.',
  },
  {
    question: '¿Cómo se calcula el ISR con pago quincenal?',
    answer:
      'Para el ISR de pago quincenal, el SAT utiliza la tarifa mensual y la divide entre 2 para obtener la tarifa quincenal aplicable. El resultado anual es el mismo que con pago mensual. Usa nuestra calculadora de ISR para el cálculo detallado.',
  },
  {
    question: '¿Qué es el período de nómina en México?',
    answer:
      'El período de nómina es el lapso de tiempo al que corresponde el pago del salario. Los más comunes en México son: semanal (7 días), quincenal (15 días) y mensual (30 días). El período debe quedar establecido en el contrato colectivo o individual de trabajo.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  equivalentPageGroup="pay-frequency"
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: t.navigation.salary, href: buildLocalePath(locale, 'salary') },
      { label: t.salary.payFrequency.title, href: buildLocalePath(locale, 'salary/conversor-periodo-pago') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">{t.salary.payFrequency.h1}</h1>
    <p class="mt-3 max-w-2xl text-slate-600">{t.salary.payFrequency.intro}</p>

    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <PayFrequencyConverter client:load t={t} locale={locale} />
    </div>

    <div class="mt-8">
      <InContentAd slotId="mx-pay-freq-1" />
    </div>

    <div class="mt-10 prose prose-slate max-w-none">
      <h2>Tabla de conversión de períodos de pago — México</h2>
      <table>
        <thead>
          <tr>
            <th>Período</th>
            <th>Períodos al año</th>
            <th>Fórmula desde salario anual</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>Semanal</td><td>52</td><td>Anual ÷ 52</td></tr>
          <tr><td>Quincenal</td><td>24</td><td>Anual ÷ 24</td></tr>
          <tr><td>Mensual</td><td>12</td><td>Anual ÷ 12</td></tr>
          <tr><td>Anual</td><td>1</td><td>—</td></tr>
        </tbody>
      </table>
      <p class="text-sm text-slate-500 mt-4">
        Nota: En México el pago quincenal divide el año en 24 períodos, no 26. Asegúrate de usar el divisor correcto.
      </p>
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.verifyProfessional} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="Preguntas frecuentes sobre períodos de pago en México" items={faqItems} />
  </article>
  <CalculatorResource locale="es-MX" category="salary" />
</BaseLayout>

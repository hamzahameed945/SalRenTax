---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import MexicoSalaryCalculator from '../../../../components/islands/MexicoSalaryCalculator';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'es-MX' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  t.meta.paycheckTitle,
  t.meta.paycheckDescription,
  '/es-mx/salary/calculadora-isr/',
);

const faqItems = [
  {
    question: '¿Qué es el ISR y cómo se calcula?',
    answer: 'El Impuesto Sobre la Renta (ISR) es el impuesto federal sobre los ingresos por sueldos y salarios. Se calcula aplicando la tarifa progresiva del Art. 96 de la LISR (7 tramos, de 1,92% a 35%) al ingreso gravable mensual.',
  },
  {
    question: '¿Cuál es el ISR máximo en 2026?',
    answer: 'La tasa marginal máxima del ISR en México es del 35%, aplicable a ingresos mensuales superiores a $425,641.99 MXN. La tasa efectiva depende de tus ingresos totales anuales.',
  },
  {
    question: '¿Qué es el IMSS Cesantía y Vejez?',
    answer: 'Es la cuota obrera al seguro de Cesantía en Edad Avanzada y Vejez del IMSS, equivalente al 1.125% del salario base. Esta calculadora solo descuenta esta cuota; otras ramas del IMSS no están incluidas.',
  },
  {
    question: '¿El resultado incluye el subsidio al empleo?',
    answer: 'No. El subsidio al empleo reduce el ISR a pagar para trabajadores de bajos ingresos, pero no está calculado en esta herramienta. Tu sueldo neto real puede ser mayor si aplica el subsidio.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  equivalentPageGroup="isr-calculator-mx"
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: t.navigation.salary, href: buildLocalePath(locale, 'salary') },
      { label: t.salary.isr.title, href: buildLocalePath(locale, 'salary/calculadora-isr') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">{t.salary.isr.h1}</h1>
    <p class="mt-3 max-w-2xl text-slate-600">{t.salary.isr.intro}</p>

    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <MexicoSalaryCalculator client:load locale={locale} />
    </div>

    <div class="mt-8">
      <InContentAd slotId="mx-isr-1" />
    </div>

    <div class="mt-10 prose prose-slate max-w-none">
      <h2>Tarifa ISR 2026 — Art. 96 LISR (tramos principales)</h2>
      <table>
        <thead><tr><th>Límite inferior (MXN)</th><th>Tasa aplicable</th></tr></thead>
        <tbody>
          <tr><td>$0.01 – $844.59</td><td>1.92%</td></tr>
          <tr><td>$844.60 – $7,168.51</td><td>6.40%</td></tr>
          <tr><td>$7,168.52 – $12,598.02</td><td>10.88%</td></tr>
          <tr><td>$12,598.03 – $14,644.64</td><td>16.00%</td></tr>
          <tr><td>$14,644.65 – $17,533.64</td><td>17.92%</td></tr>
          <tr><td>$35,362.84 – $55,736.68</td><td>23.52%</td></tr>
          <tr><td>Sobre $425,642.00</td><td>35.00%</td></tr>
        </tbody>
      </table>
      <p class="text-sm">Fuente: SAT — Resolución Miscelánea Fiscal 2026, Anexo 8 (Art. 96 LISR).</p>
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.verifyProfessional} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="Preguntas frecuentes sobre ISR en México" items={faqItems} />
  </article>
</BaseLayout>

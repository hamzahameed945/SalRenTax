---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import { buildLocalePath } from '../../../../i18n/utils';
import MexicoSalaryCalculator from '../../../../components/islands/MexicoSalaryCalculator';
const locale = 'es-MX' as const;
---
<BaseLayout locale={locale} title="Sueldo Bruto y Neto 2026 — SalRenTax" description="Compara sueldo bruto y sueldo neto estimado en México." canonical="/es-mx/salary/sueldo-bruto-y-neto/">
  <Breadcrumbs locale={locale} trail={[{label:'Calculadoras de sueldo',href:buildLocalePath(locale,'salary')}]} />
  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">Sueldo Bruto y Neto 2026</h1>
    <p class="mt-3 max-w-2xl text-slate-600">La herramienta reutiliza el motor salarial de México y muestra ISR e IMSS estimados.</p>
    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><MexicoSalaryCalculator client:load locale={locale} /></div>
    <div class="mt-8"><InContentAd slotId="mx-bruto-neto-1" /></div>
    <div class="mt-10 prose prose-slate max-w-none"><h2>Sueldo bruto y neto</h2><p>La herramienta reutiliza el motor salarial de México y muestra ISR e IMSS estimados.</p></div>
  </article>
</BaseLayout>

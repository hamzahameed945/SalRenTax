---
import CalculatorResource from '../../../../components/content/CalculatorResource.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import SalaryToHourlyCalculator from '../../../../components/islands/SalaryToHourlyCalculator';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'es-MX' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'Calculadora de Salario a Hora México — PayRenTax',
  t.salary.salaryToHourly.intro,
  '/es-mx/salary/calculadora-salario-hora/',
);

const faqItems = [
  {
    question: '¿Cómo calculo mi salario por hora en México?',
    answer:
      'En México el salario se expresa típicamente como salario diario. Para obtener el por hora, divide el salario diario entre las horas de la jornada laboral (máximo 8 horas en jornada diurna). Para convertir salario anual a por hora: divide el salario anual entre 365 días y luego entre las horas diarias.',
  },
  {
    question: '¿Cuál es el salario mínimo general en México en 2026?',
    answer:
      'El salario mínimo general en México para 2026 es determinado por la CONASAMI (Comisión Nacional de Salarios Mínimos). Para 2025 fue de $278.80 pesos diarios ($347.56 en la Zona Libre de la Frontera Norte). Consulta el DOF o conasami.gob.mx para el valor vigente en 2026.',
  },
  {
    question: '¿Cuántas horas semanales es la jornada laboral en México?',
    answer:
      'La Ley Federal del Trabajo establece: jornada diurna máxima de 8 horas (48 horas semanales), jornada nocturna de 7 horas, y jornada mixta de 7.5 horas. La jornada semanal máxima es de 48 horas para jornada diurna.',
  },
  {
    question: '¿El salario por hora incluye las prestaciones de ley?',
    answer:
      'El salario por hora calculado aquí es el salario base bruto, sin incluir el valor monetario de las prestaciones de ley como aguinaldo (15 días mínimo), vacaciones, prima vacacional (25%) e IMSS. El costo total para el empleador (salario integrado) es mayor.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  equivalentPageGroup="salary-to-hourly"
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: t.navigation.salary, href: buildLocalePath(locale, 'salary') },
      { label: t.salary.salaryToHourly.title, href: buildLocalePath(locale, 'salary/calculadora-salario-hora') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">{t.salary.salaryToHourly.h1}</h1>
    <p class="mt-3 max-w-2xl text-slate-600">{t.salary.salaryToHourly.intro}</p>

    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <SalaryToHourlyCalculator client:load locale={locale} currency="MXN" />
    </div>

    <div class="mt-8">
      <InContentAd slotId="mx-salary-hourly-1" />
    </div>

    <div class="mt-10 prose prose-slate max-w-none">
      <h2>Ejemplos de salario por hora — México 2026</h2>
      <table>
        <thead>
          <tr>
            <th>Salario anual bruto</th>
            <th>$/hora (48h/semana)</th>
            <th>$/hora (40h/semana)</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>$120,000</td><td>$48.08</td><td>$57.69</td></tr>
          <tr><td>$180,000</td><td>$72.12</td><td>$86.54</td></tr>
          <tr><td>$240,000</td><td>$96.15</td><td>$115.38</td></tr>
          <tr><td>$360,000</td><td>$144.23</td><td>$173.08</td></tr>
        </tbody>
      </table>
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.verifyProfessional} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="Preguntas frecuentes sobre el salario por hora en México" items={faqItems} />
  </article>
  <CalculatorResource locale="es-MX" category="salary" />
</BaseLayout>

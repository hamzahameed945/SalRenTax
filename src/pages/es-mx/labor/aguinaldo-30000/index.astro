---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import MxAguinaldoCalculator from '../../../../components/islands/MxAguinaldoCalculator';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'es-MX' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'Aguinaldo de $30,000 en 2026 — PayRenTax',
  'Aguinaldo de $30,000 en 2026: recibes $14,109.89 netos (bruto $15,000.00, ISR $890.11). Pago antes del 20 de diciembre. Calcula el tuyo.',
  '/es-mx/labor/aguinaldo-30000/',
);

const faqItems = [
    {
      question: '¿Cuánto me toca de aguinaldo con sueldo de $30,000?',
      answer:
        'Con sueldo mensual de $30,000.00 y 12 meses trabajados, tu aguinaldo 2026 es de $15,000.00 brutos (15 días de salario). Después del ISR ($890.11 sobre el excedente de 30 UMAs), recibes $14,109.89 netos.'
    },
    {
      question: '¿Cuándo pagan el aguinaldo en 2026?',
      answer:
        'Por ley (Artículo 87 de la LFT), el aguinaldo debe pagarse antes del 20 de diciembre de 2026. Muchas empresas lo pagan en dos partes: una en noviembre y otra en diciembre.'
    },
    {
      question: '¿El aguinaldo paga ISR?',
      answer:
        'Sí, parcialmente. El aguinaldo está exento de ISR hasta 30 UMAs ($3,519.30 en 2026) y solo el excedente paga ISR. Con sueldo de $30,000, el ISR de tu aguinaldo es de $890.11.'
    },
    {
      question: '¿Cuánto ISR me quitan del aguinaldo con sueldo de $30,000?',
      answer:
        'Aproximadamente $890.11. De los $15,000.00 brutos, $3,519.30 están exentos (30 UMAs de 2026) y solo la parte gravada ($11,480.70) paga ISR con la tarifa mensual del Artículo 96 de la LISR. Es una estimación: la retención real depende del procedimiento de tu patrón y de tu ingreso total de diciembre.'
    }
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: 'Derechos laborales', href: buildLocalePath(locale, 'labor') },
      { label: 'Aguinaldo de $30,000', href: buildLocalePath(locale, 'labor/aguinaldo-30000') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">Aguinaldo de $30,000 en 2026: ¿cuánto te toca?</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      Con sueldo de <strong>$30,000.00</strong> al mes y 12 meses trabajados, tu aguinaldo
      en 2026 es de <strong>$15,000.00</strong> brutos. Después del ISR
      (<strong>$890.11</strong>), recibes <strong>$14,109.89 netos</strong>.
    </p>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold">Desglose de tu aguinaldo 2026</h2>
      <table class="mt-4 w-full text-sm">
        <tbody>
          <tr><td>Aguinaldo bruto (15 días de salario)</td><td>$15,000.00</td></tr>
          <tr><td>ISR (sobre el excedente de 30 UMAs)</td><td>$890.11</td></tr>
          <tr class="font-semibold"><td>Aguinaldo neto que recibes</td><td>$14,109.89</td></tr>
        </tbody>
      </table>
      <p class="mt-4 text-xs text-slate-500">
        La Ley Federal del Trabajo (Art. 87) establece un mínimo de 15 días de salario y el pago
        antes del 20 de diciembre. El aguinaldo está exento de ISR hasta 30 UMAs
        ($3,519.30 en 2026); solo el excedente paga ISR. Simula otros escenarios
        en la calculadora.
      </p>
    </div>

    <div class="mt-8">
      <InContentAd slotId="mx-aguinaldo-30000" />
    </div>

    <div class="mt-10">
      <h2 class="text-xl font-semibold">Calcula tu aguinaldo</h2>
      <div class="mt-4">
        <MxAguinaldoCalculator client:load initialSalary={30000} />
      </div>
    </div>

    <nav class="mt-10" aria-label="Aguinaldo por sueldo">
      <h2 class="text-xl font-semibold">Aguinaldo por sueldo</h2>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/es-mx/labor/aguinaldo-10000/">Aguinaldo de $10,000</a></li>
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/es-mx/labor/aguinaldo-15000/">Aguinaldo de $15,000</a></li>
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/es-mx/labor/aguinaldo-20000/">Aguinaldo de $20,000</a></li>
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/es-mx/labor/aguinaldo-50000/">Aguinaldo de $50,000</a></li>
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/es-mx/labor/aguinaldo-75000/">Aguinaldo de $75,000</a></li>
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/es-mx/labor/aguinaldo-100000/">Aguinaldo de $100,000</a></li>
      </ul>
    </nav>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.dataSource} Valores estimados con las tablas
      oficiales 2026; tu nómina real puede variar. La retención real de ISR depende del procedimiento de tu patrón y de tu ingreso total de diciembre.
    </p>

    <CalculatorFAQ heading="Aguinaldo de $30,000: preguntas frecuentes" items={faqItems} />
  </article>
</BaseLayout>

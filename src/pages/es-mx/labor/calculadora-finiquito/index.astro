---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import MexicoFiniquitoCalculator from '../../../../components/islands/MexicoFiniquitoCalculator';
import { buildLocalePath } from '../../../../i18n/utils';

const locale = 'es-MX' as const;
const title = 'Calculadora de Finiquito 2026 — SalRenTax';
const description = 'Calcula una liquidación laboral estimada en México 2026.';
const canonical = '/es-mx/labor/calculadora-finiquito/';
const faqItems = [{ question: '¿Qué incluye el cálculo?', answer: 'Estimación de aguinaldo proporcional, vacaciones, prima vacacional y conceptos de indemnización para un escenario de terminación laboral.' }];
---
<BaseLayout locale={locale} title={title} description={description} canonical={canonical}>
  <Breadcrumbs locale={locale} trail={[
    { label: 'Calculadora de Finiquito', href: buildLocalePath(locale, 'labor/calculadora-finiquito') },
  ]} />
  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">Calculadora de Finiquito 2026</h1>
    <p class="mt-3 max-w-2xl text-slate-600">Estimación de aguinaldo proporcional, vacaciones, prima vacacional y conceptos de indemnización para un escenario de terminación laboral.</p>
    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <MexicoFiniquitoCalculator client:load />
    </div>
    <div class="mt-8"><InContentAd slotId="es-mx-labor-calculadora-finiquito-1" /></div>
    <div class="mt-10 prose prose-slate max-w-none">
      <h2>Información importante</h2>
      <p>Este calculador usa un modelo explícito y simplificado para apoyar una estimación inicial. Los casos reales pueden variar por deducciones, convenios, topes legales y otros datos personales.</p>
    </div>
    <CalculatorFAQ heading="Preguntas frecuentes" items={faqItems} />
  </article>
</BaseLayout>

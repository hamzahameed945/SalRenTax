---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'es-MX' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'Calculadora de Finiquito y Liquidación México 2026 — SalRenTax',
  'Calcula tu finiquito o liquidación laboral en México 2026 conforme a la Ley Federal del Trabajo. Incluye aguinaldo proporcional, vacaciones e indemnización.',
  '/es-mx/labor/calculadora-finiquito/',
);

const faqItems = [
  {
    question: '¿Cuál es la diferencia entre finiquito y liquidación en México?',
    answer: 'El finiquito es el pago de conceptos proporcionales al terminar la relación laboral (aguinaldo, vacaciones). La liquidación incluye adicionalmente la indemnización constitucional de 3 meses más 20 días por año, que solo procede en despido injustificado.',
  },
  {
    question: '¿Cuánto es la indemnización por despido injustificado?',
    answer: 'La indemnización constitucional es de 3 meses de salario (90 días) más 20 días de salario por año trabajado, más la prima de antigüedad (12 días por año).',
  },
  {
    question: '¿Qué es el salario diario integrado?',
    answer: 'El salario diario integrado (SDI) incluye el salario base más las partes alícuotas de aguinaldo, vacaciones y prima vacacional. Para el cálculo de liquidación, se debe usar el SDI, no solo el salario nominal.',
  },
  {
    question: '¿Cuánto es el aguinaldo en México?',
    answer: 'Por ley, el aguinaldo equivale a 15 días de salario por año completo trabajado, proporcional a los meses trabajados.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout locale={locale} title={meta.title} description={meta.description} canonical={meta.canonical}>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: t.navigation.labor, href: buildLocalePath(locale, 'labor') },
      { label: 'Calculadora de finiquito', href: buildLocalePath(locale, 'labor/calculadora-finiquito') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">{t.salary.finiquito.h1}</h1>
    <p class="mt-3 max-w-2xl text-slate-600">{t.salary.finiquito.intro}</p>

    <!-- JS-driven calculator -->
    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm" id="finiquito-calc">
      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">{t.salary.finiquito.fields.dailyWage} (MXN)</label>
          <input id="dailyWage" type="number" value="400" class="w-full rounded-md border border-slate-300 px-3 py-2 text-slate-900" placeholder="p. ej. 400" />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">{t.salary.finiquito.fields.yearsWorked}</label>
          <input id="yearsWorked" type="number" value="2" class="w-full rounded-md border border-slate-300 px-3 py-2 text-slate-900" placeholder="p. ej. 2" />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">{t.salary.finiquito.fields.daysVacationPending}</label>
          <input id="daysVacation" type="number" value="6" class="w-full rounded-md border border-slate-300 px-3 py-2 text-slate-900" placeholder="p. ej. 6" />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">{t.salary.finiquito.fields.dismissalType}</label>
          <select id="dismissalType" class="w-full rounded-md border border-slate-300 px-3 py-2 text-slate-900">
            <option value="voluntary">Renuncia voluntaria</option>
            <option value="justifiedDismissal">Despido justificado</option>
            <option value="unjustifiedDismissal">Despido injustificado</option>
          </select>
        </div>
      </div>
      <button id="calcBtn" class="mt-6 rounded-md bg-accent px-6 py-2 font-semibold text-white hover:bg-accent-dark">Calcular</button>
      <div id="result" class="mt-6 rounded-xl bg-slate-50 p-6 hidden">
        <p class="text-sm text-slate-500 mb-2">Total estimado:</p>
        <p id="total" class="text-4xl font-bold text-accent"></p>
        <dl id="breakdown" class="mt-4 space-y-2 text-sm text-slate-700"></dl>
        <p class="mt-4 text-xs text-slate-500">* Resultado en pesos mexicanos (MXN). Basado en SDI proporcionado. Consulta con un abogado laboral para tu caso específico.</p>
      </div>
    </div>

    <div class="mt-8">
      <InContentAd slotId="mx-finiquito-1" />
    </div>

    <div class="mt-10 prose prose-slate max-w-none">
      <h2>¿Qué incluye la liquidación laboral en México?</h2>
      <table>
        <thead><tr><th>Concepto</th><th>¿Siempre aplica?</th></tr></thead>
        <tbody>
          <tr><td>Aguinaldo proporcional (15 días/año)</td><td>✅ Siempre</td></tr>
          <tr><td>Vacaciones proporcionales + prima vacacional</td><td>✅ Siempre</td></tr>
          <tr><td>Indemnización constitucional (90 días)</td><td>Solo despido injustificado</td></tr>
          <tr><td>Prima de antigüedad (12 días/año)</td><td>Despido injust. o ≥15 años voluntario</td></tr>
        </tbody>
      </table>
    </div>

    <p class="mt-6 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.verifyProfessional}
    </p>

    <CalculatorFAQ heading="Preguntas frecuentes sobre finiquito y liquidación en México" items={faqItems} />
  </article>
</BaseLayout>

<script>
  document.getElementById('calcBtn')?.addEventListener('click', () => {
    const daily = parseFloat((document.getElementById('dailyWage') as HTMLInputElement).value);
    const years = parseFloat((document.getElementById('yearsWorked') as HTMLInputElement).value);
    const vacDays = parseFloat((document.getElementById('daysVacation') as HTMLInputElement).value) || 0;
    const type = (document.getElementById('dismissalType') as HTMLSelectElement).value;

    if (!daily || daily <= 0) return;
    const y = Math.max(0, years || 0);

    const aguinaldo = daily * 15 * (y > 0 ? 1 : 0.5);
    const vacaciones = daily * vacDays;
    const primaVacacional = vacaciones * 0.25;
    const severance = type === 'unjustifiedDismissal' ? daily * 90 : 0;
    const seniority = (type === 'unjustifiedDismissal' || (type === 'voluntary' && y >= 15)) ? daily * 12 * y : 0;
    const total = aguinaldo + vacaciones + primaVacacional + severance + seniority;

    const fmt = (v: number) => new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(v);
    document.getElementById('result')!.classList.remove('hidden');
    document.getElementById('total')!.textContent = fmt(total);
    document.getElementById('breakdown')!.innerHTML = `
      <div class="flex justify-between border-b border-slate-200 pb-1"><dt>Aguinaldo proporcional</dt><dd>${fmt(aguinaldo)}</dd></div>
      <div class="flex justify-between border-b border-slate-200 pb-1"><dt>Vacaciones proporcionales</dt><dd>${fmt(vacaciones)}</dd></div>
      <div class="flex justify-between border-b border-slate-200 pb-1"><dt>Prima vacacional</dt><dd>${fmt(primaVacacional)}</dd></div>
      ${severance > 0 ? `<div class="flex justify-between border-b border-slate-200 pb-1"><dt>Indemnización constitucional</dt><dd>${fmt(severance)}</dd></div>` : ''}
      ${seniority > 0 ? `<div class="flex justify-between border-b border-slate-200 pb-1"><dt>Prima de antigüedad</dt><dd>${fmt(seniority)}</dd></div>` : ''}
    `;
  });
</script>

---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import { buildLocalePath } from '../../../../i18n/utils';
import MexicoFiniquitoCalculator from '../../../../components/islands/MexicoFiniquitoCalculator';
const locale = 'es-MX' as const;
---
<BaseLayout locale={locale} title="Calculadora de Liquidación 2026 — SalRenTax" description="Estima la liquidación laboral en México para escenarios de terminación." canonical="/es-mx/labor/calculadora-liquidacion/">
  <Breadcrumbs locale={locale} trail={[{label:'Calculadoras laborales',href:buildLocalePath(locale,'labor')}]} />
  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">Calculadora de Liquidación 2026</h1>
    <p class="mt-3 max-w-2xl text-slate-600">La herramienta incluye aguinaldo proporcional, vacaciones, prima vacacional e indemnización estimada.</p>
    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><MexicoFiniquitoCalculator client:load /></div>
    <div class="mt-8"><InContentAd slotId="mx-liquidacion-1" /></div>
    <div class="mt-10 prose prose-slate max-w-none"><h2>Liquidación laboral</h2><p>La herramienta incluye aguinaldo proporcional, vacaciones, prima vacacional e indemnización estimada.</p></div>
  </article>
</BaseLayout>

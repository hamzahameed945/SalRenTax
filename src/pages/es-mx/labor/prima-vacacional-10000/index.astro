---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import MxPrimaVacacionalCalculator from '../../../../components/islands/MxPrimaVacacionalCalculator';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'es-MX' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'Prima vacacional de $10,000 en 2026 — PayRenTax',
  'Prima vacacional de $10,000 en 2026: $1,000.00 netos (bruta $1,000.00, ISR $0.00). 25% sobre 12 días de vacaciones. Calcula la tuya.',
  '/es-mx/labor/prima-vacacional-10000/',
);

const faqItems = [
    {
      question: '¿Cuánto me toca de prima vacacional con sueldo de $10,000?',
      answer:
        'Con sueldo de $10,000.00, tu prima vacacional 2026 es de $1,000.00 brutos (25% de 12 días de salario diario). Como no excede 15 UMAs ($1,759.65), no paga ISR: recibes $1,000.00 netos.'
    },
    {
      question: '¿La prima vacacional paga ISR?',
      answer:
        'Solo sobre el excedente de 15 UMAs ($1,759.65 en 2026). Con sueldo de $10,000, la prima es de $1,000.00 y el ISR es de $0.00.'
    },
    {
      question: '¿Cuántos días de vacaciones me tocan?',
      answer:
        'La LFT otorga un mínimo de 12 días de vacaciones al cumplir un año trabajado, y la prima vacacional es del 25% sobre el salario correspondiente a esos días (Art. 80). Los días de vacaciones aumentan con tu antigüedad.'
    }
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: 'Derechos laborales', href: buildLocalePath(locale, 'labor') },
      { label: 'Prima vacacional de $10,000', href: buildLocalePath(locale, 'labor/prima-vacacional-10000') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">Prima vacacional de $10,000 en 2026: ¿cuánto recibes?</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      Con sueldo de <strong>$10,000.00</strong> al mes, tu prima vacacional en 2026 es de
      <strong>$1,000.00</strong> brutos (25% de 12 días). Después del ISR
      (<strong>$0.00</strong>), recibes <strong>$1,000.00 netos</strong>.
    </p>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold">Desglose de tu prima vacacional 2026</h2>
      <table class="mt-4 w-full text-sm">
        <tbody>
          <tr><td>Prima bruta (25% de 12 días de salario)</td><td>$1,000.00</td></tr>
          <tr><td>ISR (sobre el excedente de 15 UMAs)</td><td>$0.00</td></tr>
          <tr class="font-semibold"><td>Prima neta que recibes</td><td>$1,000.00</td></tr>
        </tbody>
      </table>
      <p class="mt-4 text-xs text-slate-500">
        La LFT (Art. 80) establece una prima mínima del 25% sobre el salario de tus días de
        vacaciones. Está exenta de ISR hasta 15 UMAs ($1,759.65 en 2026); solo el
        excedente paga ISR. Simula otros escenarios en la calculadora.
      </p>
    </div>

    <div class="mt-8">
      <InContentAd slotId="mx-prima-10000" />
    </div>

    <div class="mt-10">
      <h2 class="text-xl font-semibold">Calcula tu prima vacacional</h2>
      <div class="mt-4">
        <MxPrimaVacacionalCalculator client:load initialSalary={10000} />
      </div>
    </div>

    <nav class="mt-10" aria-label="Prima vacacional por sueldo">
      <h2 class="text-xl font-semibold">Prima vacacional por sueldo</h2>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/es-mx/labor/prima-vacacional-15000/">Prima vacacional de $15,000</a></li>
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/es-mx/labor/prima-vacacional-20000/">Prima vacacional de $20,000</a></li>
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/es-mx/labor/prima-vacacional-30000/">Prima vacacional de $30,000</a></li>
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/es-mx/labor/prima-vacacional-50000/">Prima vacacional de $50,000</a></li>
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/es-mx/labor/prima-vacacional-75000/">Prima vacacional de $75,000</a></li>
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/es-mx/labor/prima-vacacional-100000/">Prima vacacional de $100,000</a></li>
      </ul>
    </nav>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.dataSource} Valores estimados con las tablas
      oficiales 2026; tu nómina real puede variar.
    </p>

    <CalculatorFAQ heading="Prima vacacional de $10,000: preguntas frecuentes" items={faqItems} />
  </article>
</BaseLayout>

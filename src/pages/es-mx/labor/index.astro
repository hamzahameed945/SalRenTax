---
import CategoryResource from '../../../components/content/CategoryResource.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/navigation/Breadcrumbs.astro';
import { getDictionary } from '../../../i18n/dictionaries';
import { getActivePagesForLocale } from '../../../seo/page-registry';
import { buildPageMetadata } from '../../../lib/seo/metadata';
import { buildLocalePath } from '../../../i18n/utils';

const locale = 'es-MX' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  `${t.labor.categoryTitle} — ${t.meta.siteTitleSuffix}`,
  t.labor.categoryIntro,
  '/es-mx/labor/',
);
const pages = getActivePagesForLocale(locale).filter(
  (p) => p.category === 'labor' && p.pageType === 'calculator',
);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <Breadcrumbs
    locale={locale}
    trail={[{ label: t.navigation.labor, href: buildLocalePath(locale, 'labor') }]}
  />
  <section class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">{t.labor.categoryTitle}</h1>
    <p class="mt-3 text-slate-600">{t.labor.categoryIntro}</p>
    <ul class="mt-8 space-y-3">
      {pages.map((page) => (
        <li class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm hover:border-accent transition-colors">
          <a
            href={buildLocalePath(locale, page.slug)}
            class="font-semibold text-accent hover:underline"
          >
            {page.primaryKeyword}
          </a>
        </li>
      ))}
    </ul>
    <nav class="mt-10" aria-label="Aguinaldo según tu sueldo">
      <h2 class="text-xl font-semibold">Aguinaldo según tu sueldo</h2>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
        <li><a class="text-blue-700 underline hover:text-blue-900" href="/es-mx/labor/aguinaldo-10000/">Aguinaldo de $10,000 en 2026</a></li>
        <li><a class="text-blue-700 underline hover:text-blue-900" href="/es-mx/labor/aguinaldo-15000/">Aguinaldo de $15,000 en 2026</a></li>
        <li><a class="text-blue-700 underline hover:text-blue-900" href="/es-mx/labor/aguinaldo-20000/">Aguinaldo de $20,000 en 2026</a></li>
        <li><a class="text-blue-700 underline hover:text-blue-900" href="/es-mx/labor/aguinaldo-30000/">Aguinaldo de $30,000 en 2026</a></li>
        <li><a class="text-blue-700 underline hover:text-blue-900" href="/es-mx/labor/aguinaldo-50000/">Aguinaldo de $50,000 en 2026</a></li>
        <li><a class="text-blue-700 underline hover:text-blue-900" href="/es-mx/labor/aguinaldo-75000/">Aguinaldo de $75,000 en 2026</a></li>
        <li><a class="text-blue-700 underline hover:text-blue-900" href="/es-mx/labor/aguinaldo-100000/">Aguinaldo de $100,000 en 2026</a></li>
      </ul>
    </nav>
    <nav class="mt-10" aria-label="Prima vacacional según tu sueldo">
      <h2 class="text-xl font-semibold">Prima vacacional según tu sueldo</h2>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
        <li><a class="text-blue-700 underline hover:text-blue-900" href="/es-mx/labor/prima-vacacional-10000/">Prima vacacional de $10,000 en 2026</a></li>
        <li><a class="text-blue-700 underline hover:text-blue-900" href="/es-mx/labor/prima-vacacional-15000/">Prima vacacional de $15,000 en 2026</a></li>
        <li><a class="text-blue-700 underline hover:text-blue-900" href="/es-mx/labor/prima-vacacional-20000/">Prima vacacional de $20,000 en 2026</a></li>
        <li><a class="text-blue-700 underline hover:text-blue-900" href="/es-mx/labor/prima-vacacional-30000/">Prima vacacional de $30,000 en 2026</a></li>
        <li><a class="text-blue-700 underline hover:text-blue-900" href="/es-mx/labor/prima-vacacional-50000/">Prima vacacional de $50,000 en 2026</a></li>
        <li><a class="text-blue-700 underline hover:text-blue-900" href="/es-mx/labor/prima-vacacional-75000/">Prima vacacional de $75,000 en 2026</a></li>
        <li><a class="text-blue-700 underline hover:text-blue-900" href="/es-mx/labor/prima-vacacional-100000/">Prima vacacional de $100,000 en 2026</a></li>
      </ul>
    </nav>
  </section>
  <CategoryResource locale="es-MX" category="labor" />
</BaseLayout>

---
import CalculatorResource from '../../../../components/content/CalculatorResource.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import MxPrimaVacacionalCalculator from '../../../../components/islands/MxPrimaVacacionalCalculator';
import { buildLocalePath } from '../../../../i18n/utils';

const locale = 'es-MX' as const;
const title = 'Calculadora de Prima Vacacional 2026 — PayRenTax';
const description =
  'Calcula tu prima vacacional 2026 en México: 25% de tus días de vacaciones, ISR exento hasta 15 UMAs y neto estimado con la tarifa mensual del SAT.';
const canonical = '/es-mx/labor/calculadora-prima-vacacional/';
const faqItems = [
  {
    question: '¿Cómo se calcula la prima vacacional?',
    answer:
      'La prima vacacional es el 25% del salario correspondiente a tus días de vacaciones (Artículo 80 de la LFT): tu salario diario (sueldo mensual entre 30) por los días de vacaciones, por 0.25, ajustado por los meses trabajados en el año. Ejemplo: con sueldo mensual de $20,000 y 12 días de vacaciones, tu prima bruta es de $2,000.00.',
  },
  {
    question: '¿Cuántos días de vacaciones me tocan?',
    answer:
      'El mínimo legal es de 12 días de vacaciones en el primer año de trabajo (Artículo 76 de la LFT). Los días aumentan con la antigüedad, y la prima se calcula sobre los días que te corresponden.',
  },
  {
    question: '¿La prima vacacional paga ISR?',
    answer:
      'Sí, parcialmente. La prima vacacional está exenta de ISR hasta 15 UMAs ($1,759.65 en 2026) y solo el excedente paga ISR con la tarifa mensual del Artículo 96 de la LISR. Ejemplo: de una prima bruta de $2,000.00, $1,759.65 están exentos y solo $240.35 forman la base gravada.',
  },
  {
    question: '¿Qué pasa si trabajé menos de un año?',
    answer:
      'Te corresponde la parte proporcional de la prima conforme a los meses trabajados en el año: la prima se ajusta por los meses trabajados entre 12. Si trabajaste 6 meses, tu prima es la mitad de la que corresponde a un año completo.',
  },
];
---

<BaseLayout locale={locale} title={title} description={description} canonical={canonical}>
  <Breadcrumbs
    locale={locale}
    trail={[
      {
        label: 'Calculadora de Prima Vacacional',
        href: buildLocalePath(locale, 'labor/calculadora-prima-vacacional'),
      },
    ]}
  />
  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">Calculadora de Prima Vacacional 2026</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      Calcula tu prima vacacional en México 2026: 25% del salario de tus días de vacaciones,
      ISR exento hasta 15 UMAs y neto estimado.
    </p>
    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <MxPrimaVacacionalCalculator client:load />
    </div>
    <div class="mt-8">
      <InContentAd slotId="es-mx-labor-calculadora-prima-vacacional-1" />
    </div>
    <div class="mt-10 prose prose-slate max-w-none">
      <h2>Información importante</h2>
      <p>
        La Ley Federal del Trabajo (Artículo 80) establece que la prima vacacional es como
        mínimo el 25% del salario correspondiente a los días de vacaciones. El mínimo legal
        de vacaciones es de 12 días en el primer año (Artículo 76 de la LFT). La prima bruta
        se calcula como tu salario diario (sueldo mensual entre 30) por los días de
        vacaciones, por 0.25, ajustado por los meses trabajados en el año.
      </p>
      <p>
        La prima vacacional está exenta de ISR hasta 15 UMAs, es decir $1,759.65 en 2026
        (UMA diaria de $117.31, INEGI, vigente desde el 1 de febrero de 2026). Solo el
        excedente paga ISR, estimado con la tarifa mensual del Artículo 96 de la LISR. Es
        una estimación: la retención real que aplica el patrón depende de su procedimiento
        de nómina.
      </p>
    </div>
    <nav class="mt-10" aria-label="Prima vacacional por sueldo">
      <h2 class="text-xl font-semibold">Prima vacacional por sueldo</h2>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/es-mx/labor/prima-vacacional-10000/">Prima vacacional de $10,000</a></li>
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/es-mx/labor/prima-vacacional-15000/">Prima vacacional de $15,000</a></li>
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/es-mx/labor/prima-vacacional-20000/">Prima vacacional de $20,000</a></li>
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/es-mx/labor/prima-vacacional-30000/">Prima vacacional de $30,000</a></li>
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/es-mx/labor/prima-vacacional-50000/">Prima vacacional de $50,000</a></li>
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/es-mx/labor/prima-vacacional-75000/">Prima vacacional de $75,000</a></li>
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/es-mx/labor/prima-vacacional-100000/">Prima vacacional de $100,000</a></li>
      </ul>
    </nav>
    <CalculatorFAQ heading="Preguntas frecuentes" items={faqItems} />
  </article>
  <CalculatorResource locale="es-MX" category="labor" />
</BaseLayout>

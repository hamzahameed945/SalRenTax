---
import CalculatorResource from '../../../../../components/content/CalculatorResource.astro';
import RelatedCalculators from '../../../../../components/content/RelatedCalculators.astro';
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../../components/seo/JsonLd.astro';
import FrBruttoNettoCalculator from '../../../../../components/islands/FrBruttoNettoCalculator';
import { getDictionary } from '../../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../../lib/seo/structuredData';

const locale = 'fr-FR' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  t.salary.frBruttoNetto.title,
  t.salary.frBruttoNetto.metaDescription,
  '/fr-fr/salary/salaire-brut-net/',
);

const faqItems = [
  {
    question: 'Quelle est la différence entre le salaire brut et le salaire net ?',
    answer:
      'Le salaire brut est le salaire avant toute déduction. Le salaire net est ce qui reste après les cotisations salariales (vieillesse, retraite complémentaire Agirc-Arrco, CEG, CET et CSG/CRDS). L’impôt sur le revenu n’est pas encore déduit à ce stade.',
  },
  {
    question: 'Le prélèvement à la source est-il déduit par ce calculateur ?',
    answer:
      'Non. En France, le salaire net est le brut moins les cotisations salariales, avant le prélèvement à la source. L’impôt sur le revenu est calculé annuellement par foyer fiscal (quotient familial) et prélevé à la source à un taux propre à chaque foyer. Ce calculateur affiche donc le net avant impôt.',
  },
  {
    question: 'Qu’est-ce que le plafond annuel de la Sécurité sociale (PASS) en 2026 ?',
    answer:
      'Le plafond mensuel de la Sécurité sociale (PMSS) est de 4 005 € en 2026, soit 48 060 € par an. Il sépare la tranche 1 (jusqu’au plafond) de la tranche 2 (au-delà) pour la retraite complémentaire Agirc-Arrco et la CEG.',
  },
  {
    question: 'Quels sont les taux Agirc-Arrco 2026 pour le salarié ?',
    answer:
      'En tranche 1, le taux d’appel est de 7,87 %, soit 3,15 % à la charge du salarié (60 % du taux d’appel, le reste étant à la charge de l’employeur). En tranche 2, le taux d’appel est de 21,59 %, soit 8,64 % pour le salarié. La CEG est de 0,86 % en tranche 1 et de 1,08 % en tranche 2 pour le salarié.',
  },
  {
    question: 'Qu’est-ce que la CET et quand s’applique-t-elle ?',
    answer:
      'La contribution d’équilibre technique (CET) est de 0,14 % pour le salarié. Elle ne s’applique que lorsque le salaire brut dépasse le plafond mensuel de la Sécurité sociale (4 005 € en 2026), et elle est alors calculée sur l’intégralité du salaire brut.',
  },
  {
    question: 'Combien représente la CSG/CRDS ?',
    answer:
      'La CSG (9,2 %) et la CRDS (0,5 %) totalisent 9,70 %, calculées sur 98,25 % du salaire brut. Une partie de la CSG (6,80 points) est déductible du revenu imposable.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  equivalentPageGroup="fr-brutto-netto"
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: t.navigation.salary, href: buildLocalePath(locale, 'salary') },
      { label: t.salary.frBruttoNetto.title, href: buildLocalePath(locale, 'salary/salaire-brut-net') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">{t.salary.frBruttoNetto.h1}</h1>
    <p class="mt-3 max-w-2xl text-slate-600">{t.salary.frBruttoNetto.intro}</p>

    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <FrBruttoNettoCalculator client:load locale={locale} />
    </div>

    <div class="mt-8">
      <InContentAd slotId="fr-bruttonetto-1" />
    </div>

    <div class="mt-10 prose prose-slate max-w-none">
      <h2>Cotisations salariales 2026 — France</h2>
      <p>
        Les cotisations salariales déduites ici sont celles d’un salarié du secteur privé,
        hors cadres spécifiques (APEC, cadres uniquement, non incluse) et hors dispositifs
        particuliers. Le plafond mensuel de la Sécurité sociale (PMSS) 2026 est de 4 005 €.
      </p>
      <table>
        <thead>
          <tr><th>Cotisation</th><th>Assiette</th><th>Taux salarié</th></tr>
        </thead>
        <tbody>
          <tr><td>Vieillesse plafonnée</td><td>Tranche 1 (jusqu’à 4 005 €)</td><td>6,90 %</td></tr>
          <tr><td>Vieillesse déplafonnée</td><td>Totalité du brut</td><td>0,40 %</td></tr>
          <tr><td>Agirc-Arrco</td><td>Tranche 1 : 3,15 % · Tranche 2 : 8,64 %</td><td>Selon tranche</td></tr>
          <tr><td>CEG</td><td>Tranche 1 : 0,86 % · Tranche 2 : 1,08 %</td><td>Selon tranche</td></tr>
          <tr><td>CET</td><td>Totalité du brut, seulement si brut &gt; 4 005 €</td><td>0,14 %</td></tr>
          <tr><td>CSG / CRDS</td><td>98,25 % du brut</td><td>9,70 %</td></tr>
        </tbody>
      </table>
      <p>
        Les cotisations maladie (0 %) et chômage (0 %) à la charge du salarié sont nulles
        depuis les réformes récentes ; elles ne figurent donc pas dans le calcul.
      </p>

      <h2>Barème de l’impôt sur le revenu 2026 (revenus 2025, par part)</h2>
      <p>
        À titre informatif uniquement — l’impôt n’est pas déduit par ce calculateur,
        car il dépend du foyer fiscal (quotient familial, parts, déductions).
      </p>
      <table>
        <thead>
          <tr><th>Revenu imposable par part</th><th>Taux</th></tr>
        </thead>
        <tbody>
          <tr><td>Jusqu’à 11 600 €</td><td>0 %</td></tr>
          <tr><td>De 11 601 € à 29 579 €</td><td>11 %</td></tr>
          <tr><td>De 29 580 € à 84 577 €</td><td>30 %</td></tr>
          <tr><td>De 84 578 € à 181 917 €</td><td>41 %</td></tr>
          <tr><td>Au-delà de 181 917 €</td><td>45 %</td></tr>
        </tbody>
      </table>
      <p class="text-sm">
        Sources : URSSAF, Agirc-Arrco, loi de finances 2026 (promulguée le 19 février 2026).
        Voir la page <a href="/fr-fr/data-sources/">Sources de données</a> pour les liens officiels.
      </p>

      <h2>Exemples vérifiés</h2>
      <ul>
        <li><strong>3 000 € brut :</strong> cotisations 625,21 € → net 2 374,79 € (79,2 % du brut).</li>
        <li><strong>6 000 € brut :</strong> cotisations 1 235,07 € → net 4 764,93 € (dont CET, le brut dépassant le plafond).</li>
      </ul>
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.verifyProfessional} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="Questions fréquentes sur le salaire brut net" items={faqItems} />

    <RelatedCalculators
      heading="Calculateurs associés"
      links={[
        { label: 'Calculateurs de salaire France', href: buildLocalePath(locale, 'salary') },
      ]}
    />
  </article>
  <CalculatorResource locale="fr-FR" category="salary" />
</BaseLayout>

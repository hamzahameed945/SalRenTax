---
import CalculatorResource from '../../../../components/content/CalculatorResource.astro';
import RelatedCalculators from '../../../../components/content/RelatedCalculators.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import PayFrequencyConverter from '../../../../components/islands/PayFrequencyConverter';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'fr-FR' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  t.salary.payFrequency.title,
  t.salary.payFrequency.intro,
  '/fr-fr/salary/convertisseur-periode-de-paiement/',
);

const faqItems = [
  {
    question: 'Comment convertir un salaire mensuel en salaire annuel ?',
    answer:
      'Multipliez votre salaire mensuel par 12 pour le montant annuel de base. En France, le salaire est généralement versé mensuellement, en 12 mensualités.',
  },
  {
    question: 'Le convertisseur tient-il compte des cotisations ?',
    answer:
      'Non, il convertit uniquement le montant entre périodes de paiement. Pour le net après cotisations, utilisez le calculateur salaire brut net.',
  },
  {
    question: 'Quelle est la différence entre brut et net par période ?',
    answer:
      'Le brut est le salaire avant cotisations salariales ; le net est ce que vous recevez réellement. Le convertisseur travaille sur le montant que vous entrez, brut ou net selon votre choix.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  equivalentPageGroup="pay-frequency"
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: t.navigation.salary, href: buildLocalePath(locale, 'salary') },
      { label: t.salary.payFrequency.title, href: buildLocalePath(locale, 'salary/convertisseur-periode-de-paiement') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">{t.salary.payFrequency.h1}</h1>
    <p class="mt-3 max-w-2xl text-slate-600">{t.salary.payFrequency.intro}</p>

    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <PayFrequencyConverter
        client:load
        t={t}
        locale={locale}
        currency="EUR"
        labels={{
          payAmount: 'Montant du salaire (€)',
          currentFrequency: 'Période de paiement actuelle',
          hoursPerWeek: 'Heures par semaine',
          resultsHeading: 'Équivalents par période',
          annually: 'Annuel',
          monthly: 'Mensuel',
          semimonthly: 'Bimensuel (deux fois par mois)',
          biweekly: 'Quinzomadaire (toutes les deux semaines)',
          weekly: 'Hebdomadaire',
          daily: 'Quotidien',
          hourly: 'Horaire',
          placeholder: 'Entrez votre salaire et sa période pour voir tous les équivalents.',
        }}
      />
    </div>

    <div class="mt-8">
      <InContentAd slotId="fr-payfrequency-1" />
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.verifyProfessional}
    </p>

    <CalculatorFAQ heading="Questions fréquentes sur les périodes de paiement" items={faqItems} />

    <RelatedCalculators
      heading="Calculateurs associés"
      links={[
        { label: 'Calculateur salaire brut net France', href: buildLocalePath(locale, 'salary/salaire-brut-net') },
        { label: 'Salaire annuel vers taux horaire', href: buildLocalePath(locale, 'salary/salaire-annuel-vers-taux-horaire') },
      ]}
    />
  </article>
  <CalculatorResource locale="fr-FR" category="salary" />
</BaseLayout>

---
import CalculatorResource from '../../../../components/content/CalculatorResource.astro';
import RelatedCalculators from '../../../../components/content/RelatedCalculators.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import SalaryToHourlyCalculator from '../../../../components/islands/SalaryToHourlyCalculator';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'it-IT' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  t.salary.salaryToHourly.title,
  t.salary.salaryToHourly.intro,
  '/it-it/salary/stipendio-annuo-in-tariffa-oraria/',
);

const faqItems = [
  {
    question: 'Come si calcola la tariffa oraria dallo stipendio annuo?',
    answer:
      'Dividi lo stipendio annuo lordo per il numero di ore lavorate all’anno. Esempio: 40 000 € ÷ 2 080 ore (40 ore a settimana per 52 settimane) = circa 19,23 € all’ora.',
  },
  {
    question: 'Si tratta di una tariffa oraria lorda o netta?',
    answer:
      'Questo calcolatore parte dallo stipendio annuo lordo e fornisce una tariffa oraria lorda. La tariffa oraria netta è inferiore, dopo i contributi INPS e l’IRPEF. Usa il calcolatore lordo netto per il calcolo netto.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  equivalentPageGroup="salary-to-hourly"
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: t.navigation.salary, href: buildLocalePath(locale, 'salary') },
      { label: t.salary.salaryToHourly.title, href: buildLocalePath(locale, 'salary/stipendio-annuo-in-tariffa-oraria') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">{t.salary.salaryToHourly.h1}</h1>
    <p class="mt-3 max-w-2xl text-slate-600">{t.salary.salaryToHourly.intro}</p>

    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <SalaryToHourlyCalculator
        client:load
        t={{ errors: { 'errors.invalidNumber': 'Inserisci un numero valido.' } }}
        locale={locale}
        currency="EUR"
        labels={{
          annualSalary: 'Stipendio annuo lordo (€)',
          hoursPerWeek: 'Ore settimanali',
          weeksPerYear: 'Settimane all’anno',
          resultsHeading: 'Equivalenti orari',
          hourlyWage: 'Tariffa oraria',
          daily: 'Giornaliero',
          weekly: 'Settimanale',
          biweekly: 'Quindicinale',
          monthly: 'Mensile',
          placeholder: 'Inserisci il tuo stipendio annuo e le ore per vedere gli equivalenti.',
        }}
      />
    </div>

    <div class="mt-8">
      <InContentAd slotId="it-salaryhourly-1" />
    </div>

    <div class="mt-10 prose prose-slate max-w-none">
      <h2>Formula</h2>
      <p>
        Tariffa oraria = stipendio annuo lordo ÷ (ore settimanali × settimane all’anno).
        A 40 ore a settimana per 52 settimane, un anno conta 2 080 ore.
      </p>
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.verifyProfessional}
    </p>

    <CalculatorFAQ heading="Domande frequenti sulla tariffa oraria" items={faqItems} />

    <RelatedCalculators
      heading="Calcolatori correlati"
      links={[
        { label: 'Calcolatore stipendio lordo netto Italia', href: buildLocalePath(locale, 'salary/stipendio-lordo-netto') },
        { label: 'Convertitore di periodo di pagamento', href: buildLocalePath(locale, 'salary/convertitore-periodo-di-pagamento') },
      ]}
    />
  </article>
  <CalculatorResource locale="it-IT" category="salary" />
</BaseLayout>

---
import CalculatorResource from '../../../../components/content/CalculatorResource.astro';
import RelatedCalculators from '../../../../components/content/RelatedCalculators.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import PayFrequencyConverter from '../../../../components/islands/PayFrequencyConverter';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'it-IT' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  t.salary.payFrequency.title,
  t.salary.payFrequency.intro,
  '/it-it/salary/convertitore-periodo-di-pagamento/',
);

const faqItems = [
  {
    question: 'Come si converte uno stipendio mensile in stipendio annuo?',
    answer:
      'Moltiplica lo stipendio mensile per 12 per l’importo annuo di base. In Italia la retribuzione è spesso corrisposta in 13 o 14 mensilità a seconda del contratto (CCNL): in quel caso il totale annuo va diviso per il numero di mensilità previste.',
  },
  {
    question: 'Il convertitore tiene conto dei contributi?',
    answer:
      'No, converte solo l’importo tra periodi di pagamento. Per il netto dopo i contributi, usa il calcolatore lordo netto.',
  },
  {
    question: 'Qual è la differenza tra lordo e netto per periodo?',
    answer:
      'Il lordo è lo stipendio prima dei contributi; il netto è quello che ricevi realmente. Il convertitore lavora sull’importo che inserisci, lordo o netto a tua scelta.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  equivalentPageGroup="pay-frequency"
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: t.navigation.salary, href: buildLocalePath(locale, 'salary') },
      { label: t.salary.payFrequency.title, href: buildLocalePath(locale, 'salary/convertitore-periodo-di-pagamento') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">{t.salary.payFrequency.h1}</h1>
    <p class="mt-3 max-w-2xl text-slate-600">{t.salary.payFrequency.intro}</p>

    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <PayFrequencyConverter
        client:load
        t={{ errors: { 'errors.invalidNumber': 'Inserisci un numero valido.' } }}
        locale={locale}
        currency="EUR"
        labels={{
          payAmount: 'Importo dello stipendio (€)',
          currentFrequency: 'Periodo di pagamento attuale',
          hoursPerWeek: 'Ore settimanali',
          resultsHeading: 'Equivalenti per periodo',
          annually: 'Annuale',
          monthly: 'Mensile',
          semimonthly: 'Quindicinale (due volte al mese)',
          biweekly: 'Bisettimanale (ogni due settimane)',
          weekly: 'Settimanale',
          daily: 'Giornaliero',
          hourly: 'Orario',
          placeholder: 'Inserisci il tuo stipendio e il periodo per vedere tutti gli equivalenti.',
        }}
      />
    </div>

    <div class="mt-8">
      <InContentAd slotId="it-payfrequency-1" />
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.verifyProfessional}
    </p>

    <CalculatorFAQ heading="Domande frequenti sui periodi di pagamento" items={faqItems} />

    <RelatedCalculators
      heading="Calcolatori correlati"
      links={[
        { label: 'Calcolatore stipendio lordo netto Italia', href: buildLocalePath(locale, 'salary/stipendio-lordo-netto') },
        { label: 'Stipendio annuo in tariffa oraria', href: buildLocalePath(locale, 'salary/stipendio-annuo-in-tariffa-oraria') },
      ]}
    />
  </article>
  <CalculatorResource locale="it-IT" category="salary" />
</BaseLayout>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/navigation/Breadcrumbs.astro';
const locale = 'it-IT' as const;

const blogPosts = [
  {
    title: 'Come Calcolare lo Stipendio Netto in Italia 2026',
    slug: 'come-calcolare-lo-stipendio-netto-in-italia-2026',
    excerpt: 'Guida passo passo per capire la busta paga: contributi INPS, scaglioni IRPEF 2026 e addizionali, con le aliquote 2026 e due esempi verificati.',
    date: '2026-11-02',
    category: 'Stipendio',
    readTime: '10 min',
    image: '/og-default.png'
  }
];

const schemaWebPage = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Blog PayRenTax Italia",
  "description": "Guide complete sullo stipendio netto, i contributi INPS e gli scaglioni IRPEF in Italia",
  "url": "https://payrentax.me/it-it/blog/",
  "inLanguage": "it-IT"
};
---

<BaseLayout
  locale={locale}
  title="Blog PayRenTax Italia | Guide Stipendio Netto, INPS, IRPEF"
  description="Guide complete sul calcolo dello stipendio netto in Italia, i contributi INPS e gli scaglioni IRPEF 2026."
  canonical="/it-it/blog/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schemaWebPage)} />
  </Fragment>

  <Breadcrumbs locale={locale} trail={[]} />

  <div class="mx-auto max-w-6xl px-4 py-10">
    <header class="mb-12">
      <h1 class="text-4xl font-bold text-slate-900 mb-4">Blog PayRenTax Italia</h1>
      <p class="text-xl text-slate-600 max-w-3xl">
        Guide complete e aggiornate sullo stipendio netto, i contributi INPS e l’IRPEF in Italia.
      </p>
    </header>

    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {blogPosts.map((post) => (
        <article class="rounded-xl border border-slate-200 bg-white overflow-hidden shadow-sm hover:shadow-md transition-shadow">
          <img
            src={post.image}
            alt={post.title}
            class="w-full h-48 object-cover"
          />
          <div class="p-6">
            <div class="flex items-center gap-3 text-sm text-slate-500 mb-3">
              <span class="font-medium text-blue-600">{post.category}</span>
              <span>•</span>
              <time datetime={post.date}>
                {new Date(post.date).toLocaleDateString('it-IT', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}
              </time>
              <span>•</span>
              <span>{post.readTime}</span>
            </div>
            <h2 class="text-xl font-bold text-slate-900 mb-3">
              <a href={`/it-it/blog/${post.slug}/`} class="hover:text-blue-600 transition-colors">
                {post.title}
              </a>
            </h2>
            <p class="text-slate-600 mb-4">
              {post.excerpt}
            </p>
            <a
              href={`/it-it/blog/${post.slug}/`}
              class="inline-flex items-center text-blue-600 font-medium hover:text-blue-700 transition-colors"
            >
              Leggi la guida →
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

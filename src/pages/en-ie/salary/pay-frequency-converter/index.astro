---
import CalculatorResource from '../../../../components/content/CalculatorResource.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import PayFrequencyConverter from '../../../../components/islands/PayFrequencyConverter';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'en-IE' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'Pay Frequency Converter Ireland — PayRenTax',
  t.salary.payFrequency.intro,
  '/en-ie/salary/pay-frequency-converter/',
);

const faqItems = [
  {
    question: 'How do I convert my annual salary to a monthly amount in Ireland?',
    answer:
      'Divide your annual gross salary by 12 to get your gross monthly pay. For example, €48,000 ÷ 12 = €4,000 per month before PAYE, USC, and PRSI deductions.',
  },
  {
    question: 'Is weekly or monthly pay more common in Ireland?',
    answer:
      'Monthly pay is the most common frequency in Ireland for salaried employees. Weekly pay is more common in manual trades, retail, and hospitality. Some employers pay fortnightly (every two weeks).',
  },
  {
    question: 'How are Irish tax deductions applied to different pay frequencies?',
    answer:
      'Revenue Ireland applies PAYE, USC, and PRSI based on your pay period credits and cut-off points. Monthly employees receive 1/12 of their annual tax credit per month; weekly employees receive 1/52 per week. The annual tax liability is the same regardless of pay frequency.',
  },
  {
    question: 'Does pay frequency affect my USC or PRSI?',
    answer:
      'USC is charged on gross income with weekly/monthly thresholds applied proportionally, so the annual amount is effectively the same. PRSI is charged at 4% on gross weekly earnings above €352 (Class A), making the annual PRSI bill equal regardless of pay frequency.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  equivalentPageGroup="pay-frequency"
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: t.navigation.salary, href: buildLocalePath(locale, 'salary') },
      { label: t.salary.payFrequency.title, href: buildLocalePath(locale, 'salary/pay-frequency-converter') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">{t.salary.payFrequency.h1}</h1>
    <p class="mt-3 max-w-2xl text-slate-600">{t.salary.payFrequency.intro}</p>

    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <PayFrequencyConverter client:load t={t} locale={locale} />
    </div>

    <div class="mt-8">
      <InContentAd slotId="ie-pay-freq-1" />
    </div>

    <div class="mt-10 prose prose-slate max-w-none">
      <h2>Pay Period Conversion Table — Ireland</h2>
      <table>
        <thead>
          <tr>
            <th>Pay Period</th>
            <th>Periods per year</th>
            <th>Formula from annual</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>Weekly</td><td>52</td><td>Annual ÷ 52</td></tr>
          <tr><td>Fortnightly</td><td>26</td><td>Annual ÷ 26</td></tr>
          <tr><td>Monthly</td><td>12</td><td>Annual ÷ 12</td></tr>
          <tr><td>Annually</td><td>1</td><td>—</td></tr>
        </tbody>
      </table>
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.verifyProfessional} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="Frequently asked questions" items={faqItems} />
  </article>
  <CalculatorResource locale="en-IE" category="salary" />
</BaseLayout>

---
import CalculatorResource from '../../../../components/content/CalculatorResource.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import SalaryRaiseCalculator from '../../../../components/islands/SalaryRaiseCalculator';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'en-IE' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'Salary Raise Calculator Ireland — PayRenTax',
  t.salary.salaryRaise.intro,
  '/en-ie/salary/salary-raise/',
);

const faqItems = [
  {
    question: 'How do I calculate my new salary after a pay increase in Ireland?',
    answer:
      'Multiply your current salary by (1 + the percentage / 100). For a 6% increase on €45,000: €45,000 × 1.06 = €47,700.',
  },
  {
    question: 'What is a typical pay increase in Ireland?',
    answer:
      'Irish pay growth has been strong in recent years, averaging 5–8% in many sectors during 2023–25 in response to high inflation. Technology and professional services sectors have seen higher increases, while public sector pay is negotiated through centralised agreements.',
  },
  {
    question: 'How does a pay rise affect my PAYE and USC in Ireland?',
    answer:
      'Because PAYE uses a standard rate band (20% up to €44,000 for a single person) with the remainder taxed at 40%, part of any raise above the cut-off will be taxed at the higher rate. Your net increase will be less than the gross increase once PAYE, USC, and PRSI are applied.',
  },
  {
    question: 'Does a salary increase affect my pension contributions in Ireland?',
    answer:
      'If you are enrolled in an employer pension scheme, both your own contributions and your employer\'s contributions may be calculated as a percentage of your salary, so a raise typically increases total pension contributions too. Age-related revenue limits apply for tax relief on pension contributions.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  equivalentPageGroup="salary-raise"
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: t.navigation.salary, href: buildLocalePath(locale, 'salary') },
      { label: t.salary.salaryRaise.title, href: buildLocalePath(locale, 'salary/salary-raise') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">{t.salary.salaryRaise.h1}</h1>
    <p class="mt-3 max-w-2xl text-slate-600">{t.salary.salaryRaise.intro}</p>

    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <SalaryRaiseCalculator client:load t={t} locale={locale} />
    </div>

    <div class="mt-8">
      <InContentAd slotId="ie-salary-raise-1" />
    </div>

    <div class="mt-10 prose prose-slate max-w-none">
      <h2>Pay rise examples — Irish salaries 2026</h2>
      <table>
        <thead>
          <tr>
            <th>Current salary</th>
            <th>3% rise</th>
            <th>5% rise</th>
            <th>10% rise</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>€30,000</td><td>€30,900</td><td>€31,500</td><td>€33,000</td></tr>
          <tr><td>€45,000</td><td>€46,350</td><td>€47,250</td><td>€49,500</td></tr>
          <tr><td>€60,000</td><td>€61,800</td><td>€63,000</td><td>€66,000</td></tr>
          <tr><td>€80,000</td><td>€82,400</td><td>€84,000</td><td>€88,000</td></tr>
        </tbody>
      </table>
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.verifyProfessional} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="Frequently asked questions" items={faqItems} />
  </article>
  <CalculatorResource locale="en-IE" category="salary" />
</BaseLayout>

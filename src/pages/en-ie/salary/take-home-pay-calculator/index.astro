---
import CalculatorResource from '../../../../components/content/CalculatorResource.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import IrelandPaycheckCalculator from '../../../../components/islands/IrelandPaycheckCalculator';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'en-IE' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  t.meta.paycheckTitle,
  t.meta.paycheckDescription,
  '/en-ie/salary/take-home-pay-calculator/',
);

const faqItems = [
  {
    question: 'How does Irish PAYE income tax work?',
    answer:
      'PAYE is charged at 20% on income up to €44,000 (single person) and 40% on the balance. A Personal Tax Credit of €1,875 directly reduces the tax owed. Married couples get a higher standard rate band.',
  },
  {
    question: 'What is the Universal Social Charge (USC)?',
    answer:
      'USC is a tax on gross income above €13,000. Rates: 0.5% up to €12,012; 2% up to €22,920; 4.5% up to €70,044; 8% above that. Medical card holders pay reduced rates.',
  },
  {
    question: 'What is PRSI?',
    answer:
      'Pay Related Social Insurance (PRSI) is a contribution to the Social Insurance Fund. Most employees pay Class A PRSI at 4% on gross earnings above €352 per week.',
  },
  {
    question: 'Are the 2026 rates confirmed?',
    answer:
      'This calculator uses the latest published Revenue Ireland rates. The 2025 Budget figures (effective from January 2025) are used as the 2026 rates. Verify against Revenue.ie for any changes.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  equivalentPageGroup="paycheck-calculator"
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: t.navigation.salary, href: buildLocalePath(locale, 'salary') },
      {
        label: t.salary.takeHomePay.title,
        href: buildLocalePath(locale, 'salary/take-home-pay-calculator'),
      },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">{t.salary.takeHomePay.h1}</h1>
    <p class="mt-3 max-w-2xl text-slate-600">{t.salary.takeHomePay.intro}</p>

    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <IrelandPaycheckCalculator client:load locale={locale} />
    </div>

    <div class="mt-8">
      <InContentAd slotId="ie-takehome-1" />
    </div>

    <div class="mt-10 prose prose-slate max-w-none">
      <h2>Irish Tax Rates 2026 — PAYE, USC &amp; PRSI</h2>
      <h3>Income Tax (PAYE)</h3>
      <table>
        <thead>
          <tr>
            <th>Income</th>
            <th>Rate</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>First €44,000 (single)</td>
            <td>20% (standard rate)</td>
          </tr>
          <tr>
            <td>Balance</td>
            <td>40% (higher rate)</td>
          </tr>
        </tbody>
      </table>
      <h3>Universal Social Charge (USC)</h3>
      <table>
        <thead>
          <tr>
            <th>Income band</th>
            <th>Rate</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Up to €12,012</td>
            <td>0.5%</td>
          </tr>
          <tr>
            <td>€12,012 – €22,920</td>
            <td>2%</td>
          </tr>
          <tr>
            <td>€22,920 – €70,044</td>
            <td>4.5%</td>
          </tr>
          <tr>
            <td>Over €70,044</td>
            <td>8%</td>
          </tr>
        </tbody>
      </table>
      <p class="text-sm">
        Source: Revenue Ireland. Personal Tax Credit: €1,875 (single) / €3,750 (married).
      </p>
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.verifyProfessional} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="Frequently asked questions about Irish tax" items={faqItems} />
  </article>
  <CalculatorResource locale="en-IE" category="salary" />
</BaseLayout>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/navigation/Breadcrumbs.astro';
const locale = 'pt-BR' as const;

const blogPosts = [
  {
    title: 'Salário Líquido 2026: Guia Completo com Nova Lei de Isenção até R$ 5.000',
    slug: 'salario-liquido-2026',
    excerpt: 'A maior novidade de 2026 para trabalhadores brasileiros: isenção total de Imposto de Renda para quem ganha até R$ 5.000. Entenda como calcular seu salário líquido com as novas regras, tabelas INSS e IRRF atualizadas.',
    date: '2026-09-25',
    category: 'Salário',
    readTime: '12 min',
    image: '/og-default.png'
  }
];

const schemaWebPage = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Blog PayRenTax Brasil",
  "description": "Guias completos sobre salário, impostos, direitos trabalhistas e finanças pessoais no Brasil",
  "url": "https://payrentax.me/pt-br/blog/",
  "inLanguage": "pt-BR"
};
---

<BaseLayout
  locale={locale}
  title="Blog PayRenTax Brasil | Guias de Salário, Impostos e Direitos Trabalhistas"
  description="Guias completos sobre cálculo de salário líquido, INSS, IRRF, rescisão trabalhista e direitos do trabalhador. Informações atualizadas para 2026."
  canonical="/pt-br/blog/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schemaWebPage)} />
  </Fragment>
  
  <Breadcrumbs locale={locale} trail={[]} />
  
  <div class="mx-auto max-w-6xl px-4 py-10">
    <header class="mb-12">
      <h1 class="text-4xl font-bold text-slate-900 mb-4">Blog PayRenTax Brasil</h1>
      <p class="text-xl text-slate-600 max-w-3xl">
        Guias completos e atualizados sobre salário, impostos, direitos trabalhistas e finanças pessoais no Brasil.
      </p>
    </header>

    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {blogPosts.map((post) => (
        <article class="rounded-xl border border-slate-200 bg-white overflow-hidden shadow-sm hover:shadow-md transition-shadow">
          <img 
            src={post.image} 
            alt={post.title}
            class="w-full h-48 object-cover"
          />
          <div class="p-6">
            <div class="flex items-center gap-3 text-sm text-slate-500 mb-3">
              <span class="font-medium text-blue-600">{post.category}</span>
              <span>•</span>
              <time datetime={post.date}>
                {new Date(post.date).toLocaleDateString('pt-BR', { 
                  year: 'numeric', 
                  month: 'long', 
                  day: 'numeric' 
                })}
              </time>
              <span>•</span>
              <span>{post.readTime}</span>
            </div>
            <h2 class="text-xl font-bold text-slate-900 mb-3">
              <a href={`/pt-br/blog/${post.slug}/`} class="hover:text-blue-600 transition-colors">
                {post.title}
              </a>
            </h2>
            <p class="text-slate-600 mb-4">
              {post.excerpt}
            </p>
            <a 
              href={`/pt-br/blog/${post.slug}/`}
              class="inline-flex items-center text-blue-600 font-medium hover:text-blue-700 transition-colors"
            >
              Ler artigo completo
              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-16 rounded-xl bg-blue-50 border border-blue-100 p-8">
      <h2 class="text-2xl font-bold text-slate-900 mb-4">Calculadoras Grátis</h2>
      <p class="text-slate-600 mb-6">
        Use nossas calculadoras para conferir seus direitos e planejar suas finanças:
      </p>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        <a href="/pt-br/salary/calculadora-salario-liquido/" class="block p-4 bg-white rounded-lg border border-slate-200 hover:border-blue-300 hover:shadow-sm transition-all">
          <h3 class="font-semibold text-slate-900 mb-1">Salário Líquido 2026</h3>
          <p class="text-sm text-slate-600">Calcule INSS e IRRF</p>
        </a>
        <a href="/pt-br/labor/calcular-rescisao/" class="block p-4 bg-white rounded-lg border border-slate-200 hover:border-blue-300 hover:shadow-sm transition-all">
          <h3 class="font-semibold text-slate-900 mb-1">Rescisão Trabalhista</h3>
          <p class="text-sm text-slate-600">Seus direitos na demissão</p>
        </a>
        <a href="/pt-br/labor/calcular-decimo-terceiro/" class="block p-4 bg-white rounded-lg border border-slate-200 hover:border-blue-300 hover:shadow-sm transition-all">
          <h3 class="font-semibold text-slate-900 mb-1">Décimo Terceiro</h3>
          <p class="text-sm text-slate-600">13º salário proporcional</p>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

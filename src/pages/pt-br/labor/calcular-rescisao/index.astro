---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import BrRescisaoCalculator from '../../../../components/islands/BrRescisaoCalculator';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'pt-BR' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  t.meta.paycheckTitle,
  t.meta.paycheckDescription,
  '/pt-br/labor/calcular-rescisao/',
);

const faqItems = [
  {
    question: 'O que é incluído no cálculo da rescisão?',
    answer: 'A rescisão inclui: saldo de salário, férias proporcionais (+ 1/3), 13º salário proporcional, aviso prévio (se aplicável) e multa de 40% do FGTS (apenas em demissão sem justa causa).',
  },
  {
    question: 'Qual é a multa do FGTS na demissão sem justa causa?',
    answer: 'A multa do FGTS equivale a 40% do saldo da conta vinculada do FGTS. Como não temos acesso ao saldo real, estimamos com base em 8% de depósito mensal pelos meses trabalhados.',
  },
  {
    question: 'Tenho direito ao aviso prévio se pedir demissão?',
    answer: 'Ao pedir demissão (pedido de exoneração), o trabalhador deve cumprir o aviso prévio. Se o empregador dispensar o cumprimento, não há pagamento adicional. Em demissão sem justa causa pelo empregador, o trabalhador recebe o aviso prévio indenizado.',
  },
  {
    question: 'Como é calculado o 13º salário proporcional?',
    answer: 'O 13º salário proporcional é calculado multiplicando o salário mensal pela fração de meses trabalhados no ano. Por exemplo, 8 meses = (8/12) × salário.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout locale={locale} title={meta.title} description={meta.description} canonical={meta.canonical}>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: t.navigation.labor, href: buildLocalePath(locale, 'labor') },
      { label: t.labor.rescisao.title, href: buildLocalePath(locale, 'labor/calcular-rescisao') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">{t.labor.rescisao.h1}</h1>
    <p class="mt-3 max-w-2xl text-slate-600">{t.labor.rescisao.intro}</p>

    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <BrRescisaoCalculator client:load locale={locale} />
    </div>

    <div class="mt-8">
      <InContentAd slotId="br-rescisao-1" />
    </div>

    <div class="mt-10 prose prose-slate max-w-none">
      <h2>O que você recebe em cada tipo de rescisão?</h2>
      <table>
        <thead>
          <tr><th>Conceito</th><th>Pedido de demissão</th><th>Demissão sem justa causa</th><th>Justa causa</th></tr>
        </thead>
        <tbody>
          <tr><td>Saldo de salário</td><td>✅</td><td>✅</td><td>✅</td></tr>
          <tr><td>Férias proporcionais + 1/3</td><td>✅</td><td>✅</td><td>✅</td></tr>
          <tr><td>13º proporcional</td><td>✅</td><td>✅</td><td>❌</td></tr>
          <tr><td>Aviso prévio</td><td>Cumpre</td><td>Indenizado</td><td>❌</td></tr>
          <tr><td>Multa 40% FGTS</td><td>❌</td><td>✅</td><td>❌</td></tr>
          <tr><td>Seguro-desemprego</td><td>❌</td><td>✅</td><td>❌</td></tr>
        </tbody>
      </table>
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.verifyProfessional} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="Perguntas frequentes sobre rescisão trabalhista" items={faqItems} />
  </article>
</BaseLayout>

---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import BrDecimoTerceiroCalculator from '../../../../components/islands/BrDecimoTerceiroCalculator';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'pt-BR' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'Décimo terceiro de R$ 15.000 em 2026: quanto você recebe? — PayRenTax',
  'Décimo terceiro de R$ 15.000 em 2026: R$ 7.500,00 na 1ª parcela (novembro) e R$ 7.500,00 na 2ª (dezembro). Calcule o seu.',
  '/pt-br/labor/decimo-terceiro-15000/',
);

const faqItems = [
    {
      question: 'Quanto recebo de décimo terceiro com salário de R$ 15.000?',
      answer:
        'Com salário de R$ 15.000 e 12 meses trabalhados, o décimo terceiro de 2026 é R$ 15.000,00: R$ 7.500,00 na primeira parcela e R$ 7.500,00 na segunda.'
    },
    {
      question: 'Quando cai a primeira parcela do décimo terceiro em 2026?',
      answer:
        'A primeira parcela do décimo terceiro de 2026 deve ser paga até 30 de novembro, sem descontos de INSS ou Imposto de Renda. A segunda parcela cai até 20 de dezembro.'
    },
    {
      question: 'Tem desconto no décimo terceiro de R$ 15.000?',
      answer:
        'Na primeira parcela (R$ 7.500,00) não há descontos. Na segunda parcela (R$ 7.500,00) incidem INSS e Imposto de Renda, conforme as tabelas oficiais de 2026.'
    },
    {
      question: 'Como calcular o décimo terceiro proporcional?',
      answer:
        'A fórmula é: salário bruto ÷ 12 × meses trabalhados. Exemplo com salário de R$ 15.000: se você trabalhou 8 meses em 2026, o cálculo é R$ 15.000 ÷ 12 × 8 = R$ 10.000,00 brutos. Só entra na conta o mês em que você trabalhou 15 dias ou mais (Lei 4.090/1962). INSS e IRRF incidem sobre o valor total e são descontados apenas na 2ª parcela.'
    },
    {
      question: 'Trabalhei menos de 12 meses em 2026: como conto os meses para o 13º?',
      answer:
        'Conte como mês inteiro todo mês em que você trabalhou 15 dias ou mais; meses com menos de 15 dias ficam de fora. Exemplo: contratado em 20 de maio — maio não conta (apenas 12 dias), então junho a dezembro somam 7 meses: R$ 15.000 ÷ 12 × 7 = R$ 8.750,00 brutos de 13º proporcional.'
    },
    {
      question: 'Fui demitido antes de dezembro: recebo o 13º proporcional?',
      answer:
        'Sim. Na demissão sem justa causa (ou no pedido de demissão) você recebe o 13º proporcional aos meses trabalhados no ano, pago junto com as demais verbas na rescisão. Exemplo: salário de R$ 15.000 com 5 meses trabalhados = R$ 15.000 ÷ 12 × 5 = R$ 6.250,00 brutos. A exceção é a demissão por justa causa, que faz você perder o 13º proporcional.'
    },
    {
      question: 'Quando a empresa tem que pagar o 13º em 2026?',
      answer:
        'A 1ª parcela (metade do valor bruto, sem descontos) deve ser paga até 30 de novembro de 2026. A 2ª parcela (o restante, com descontos de INSS e IRRF calculados sobre o total) vence em 20 de dezembro — como em 2026 essa data cai num domingo, na prática o pagamento deve sair até sexta-feira, 18 de dezembro.'
    },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: 'Direitos trabalhistas', href: buildLocalePath(locale, 'labor') },
      { label: 'Décimo terceiro de R$ 15.000', href: buildLocalePath(locale, 'labor/decimo-terceiro-15000') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">Décimo terceiro de R$ 15.000 em 2026: quanto você recebe?</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      Com salário de <strong>R$ 15.000,00</strong> por mês, seu décimo terceiro em 2026 é de
      <strong>R$ 15.000,00</strong>: R$ 7.500,00 na 1ª parcela (até 30 de novembro) e
      R$ 7.500,00 na 2ª parcela (até 20 de dezembro).
    </p>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold">Parcelas do décimo terceiro em 2026</h2>
      <table class="mt-4 w-full text-sm">
        <tbody>
          <tr><td>1ª parcela (até 30 de novembro)</td><td>R$ 7.500,00</td></tr>
          <tr><td>2ª parcela (até 20 de dezembro)</td><td>R$ 7.500,00</td></tr>
          <tr class="font-semibold"><td>Total do décimo terceiro</td><td>R$ 15.000,00</td></tr>
        </tbody>
      </table>
      <p class="mt-4 text-xs text-slate-500">
        Valores brutos para 12 meses trabalhados. A 1ª parcela não tem descontos;
        na 2ª incidem INSS e IRRF. Simule na calculadora abaixo.
      </p>
    </div>

    <div class="mt-8">
      <InContentAd slotId="br-decimo-15000" />
    </div>

    <div class="mt-10">
      <h2 class="text-xl font-semibold">Calcule seu décimo terceiro</h2>
      <div class="mt-4">
        <BrDecimoTerceiroCalculator client:load />
      </div>
    </div>

    <nav class="mt-10" aria-label="Décimo terceiro por salário">
      <h2 class="text-xl font-semibold">Décimo terceiro por salário</h2>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/pt-br/labor/decimo-terceiro-2000/">Décimo terceiro de R$ 2.000</a></li>
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/pt-br/labor/decimo-terceiro-3000/">Décimo terceiro de R$ 3.000</a></li>
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/pt-br/labor/decimo-terceiro-5000/">Décimo terceiro de R$ 5.000</a></li>
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/pt-br/labor/decimo-terceiro-8000/">Décimo terceiro de R$ 8.000</a></li>
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/pt-br/labor/decimo-terceiro-10000/">Décimo terceiro de R$ 10.000</a></li>
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/pt-br/labor/decimo-terceiro-20000/">Décimo terceiro de R$ 20.000</a></li>
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/pt-br/labor/calcular-decimo-terceiro/">Calculadora de décimo terceiro</a></li>
      </ul>
    </nav>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="Décimo terceiro de R$ 15.000: perguntas frequentes" items={faqItems} />
  </article>
</BaseLayout>

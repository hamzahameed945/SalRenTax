---
import CalculatorResource from '../../../../components/content/CalculatorResource.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import { buildLocalePath } from '../../../../i18n/utils';
import BrHorasExtrasCalculator from '../../../../components/islands/BrHorasExtrasCalculator';
const locale = 'pt-BR' as const;
---

<BaseLayout
  locale={locale}
  title="Calculadora de Horas Extras 2026 — PayRenTax"
  description="Calcule o valor das horas extras a partir do salário, jornada mensal e adicional informado."
  canonical="/pt-br/labor/calculadora-horas-extras/"
>
  <Breadcrumbs
    locale={locale}
    trail={[{ label: 'Calculadoras trabalhistas', href: buildLocalePath(locale, 'labor') }]}
  />
  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">Calculadora de Horas Extras 2026</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      O adicional padrão é 50%, mas pode ser ajustado para o seu acordo.
    </p>
    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <BrHorasExtrasCalculator client:load />
    </div>
    <div class="mt-8">
      <InContentAd slotId="br-horas-extras-1" />
    </div>
    <div class="mt-10 prose prose-slate max-w-none">
      <h2>Horas extras</h2>
      <p>O adicional padrão é 50%, mas pode ser ajustado para o seu acordo.</p>
    </div>
  </article>
  <CalculatorResource locale="pt-BR" category="labor" />
</BaseLayout>

---
import CalculatorResource from '../../../../components/content/CalculatorResource.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import { buildLocalePath } from '../../../../i18n/utils';
import BrFeriasCalculator from '../../../../components/islands/BrFeriasCalculator';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
const locale = 'pt-BR' as const;

const schemaWebApp = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Calculadora de Férias CLT 2026",
  "description": "Calculadora gratuita para calcular férias no Brasil com 1/3 constitucional, abono pecuniário e descontos.",
  "url": "https://payrentax.me/pt-br/labor/calcular-ferias/",
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "Any",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "BRL"
  },
  "inLanguage": "pt-BR",
  "featureList": "Cálculo de férias integrais, férias proporcionais, 1/3 constitucional, abono pecuniário, descontos INSS e IRRF"
};

const faqItems = [
  {
    question: 'Como é calculado o valor das férias?',
    answer: 'O valor das férias é o salário multiplicado por 1,333 (que representa o salário + 1/3 constitucional obrigatório). Por exemplo, salário de R$ 3.000 = férias brutas de R$ 4.000. Depois são descontados INSS e IRRF.',
  },
  {
    question: 'O que é o 1/3 constitucional?',
    answer: 'É um adicional obrigatório de um terço do salário pago durante as férias, garantido pela Constituição de 1988. Serve para que o trabalhador tenha recursos extras durante o período de descanso. Não pode ser negociado ou removido.',
  },
  {
    question: 'Posso vender dias das minhas férias?',
    answer: 'Sim! Você pode vender até 10 dias (1/3 do período de 30 dias) através do abono pecuniário. É preciso solicitar ao empregador no início do período aquisitivo. Você recebe os 10 dias em dinheiro (com 1/3) e descansa apenas 20 dias.',
  },
  {
    question: 'Quando tenho direito a férias?',
    answer: 'Você tem direito a 30 dias de férias após completar 12 meses de trabalho (período aquisitivo). As férias devem ser gozadas nos 12 meses seguintes (período concessivo). Se o empregador não conceder, deve pagar em dobro.',
  },
  {
    question: 'Como funcionam as férias proporcionais?',
    answer: 'Férias proporcionais são calculadas quando há rescisão do contrato antes de completar 12 meses. A fórmula é: (Salário ÷ 12) × Meses Trabalhados × 1,333. Por exemplo, 6 meses trabalhados com salário de R$ 3.000 = R$ 1.666,50 de férias proporcionais.',
  },
];
---

<BaseLayout
  locale={locale}
  title="Calcular Férias CLT 2026 | Com 1/3 Constitucional | PayRenTax"
  description="Calculadora de férias 2026: calcule quanto você vai receber com 1/3 constitucional, abono pecuniário e descontos. CLT atualizada."
  canonical="/pt-br/labor/calcular-ferias/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schemaWebApp)} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.answer
        }
      }))
    })} />
  </Fragment>
  <Breadcrumbs
    locale={locale}
    trail={[{ label: 'Calculadoras trabalhistas', href: buildLocalePath(locale, 'labor') }]}
  />
  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">Calculadora de Férias CLT 2026</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      Calcule quanto você vai receber de férias com 1/3 constitucional, abono pecuniário (venda de dias) e descontos de INSS e IRRF.
    </p>
    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <BrFeriasCalculator client:load />
    </div>
    <div class="mt-8">
      <InContentAd slotId="br-ferias-1" />
    </div>
    <div class="mt-10 prose prose-slate max-w-none">
      <h2>Como Calcular Férias CLT 2026</h2>
      <p>
        As <strong>férias remuneradas</strong> são um direito constitucional de todo trabalhador CLT. Após <strong>12 meses de trabalho</strong> (período aquisitivo), você tem direito a <strong>30 dias de descanso remunerado</strong>.
      </p>

      <h3>Composição do Pagamento de Férias</h3>
      <p>O valor que você recebe nas férias é composto por:</p>
      <ol>
        <li><strong>Salário das férias</strong> (proporcional aos dias de descanso)</li>
        <li><strong>+ 1/3 constitucional</strong> (adicional obrigatório)</li>
        <li><strong>+ Abono pecuniário</strong> (se vendeu dias, opcional)</li>
        <li><strong>− Descontos</strong> (INSS e IRRF)</li>
      </ol>

      <h3>Fórmula Básica de Cálculo</h3>
      <pre>Férias = Salário × (Dias de Férias ÷ 30) × 1,333</pre>
      <p>O <strong>1,333</strong> representa o salário + 1/3 constitucional.</p>

      <h3>Tipos de Férias</h3>

      <h4>1. Férias Integrais (30 dias)</h4>
      <pre>Valor Bruto = Salário × 1,333</pre>
      <p><strong>Exemplo:</strong> Salário R$ 3.000 → Férias brutas R$ 4.000</p>

      <h4>2. Férias com Venda de Dias (Abono Pecuniário)</h4>
      <p>Você pode <strong>vender até 10 dias</strong> (1/3 do período):</p>
      <pre>Férias (20 dias) = Salário × (20 ÷ 30) × 1,333
Abono (10 dias) = Salário × (10 ÷ 30) × 1,333
Total = Férias + Abono</pre>
      <p><strong>Exemplo:</strong> Salário R$ 4.500</p>
      <ul>
        <li>Férias (20 dias): R$ 4.000</li>
        <li>Abono (10 dias): R$ 2.000</li>
        <li><strong>Total bruto:</strong> R$ 6.000</li>
      </ul>

      <h4>3. Férias Proporcionais (Rescisão)</h4>
      <p>Calculadas quando há rescisão antes de completar o período aquisitivo:</p>
      <pre>Férias Proporcionais = (Salário ÷ 12) × Meses × 1,333</pre>
      <p><strong>Exemplo:</strong> Salário R$ 3.000, 6 meses trabalhados → R$ 1.666,50</p>

      <h3>O Que é o 1/3 Constitucional?</h3>
      <p>
        O <strong>adicional de 1/3</strong> (um terço do salário) é obrigatório e foi criado pela Constituição de 1988 para garantir que o trabalhador tenha <strong>recursos extras durante as férias</strong>. Não pode ser negociado ou removido.
      </p>
      <p><strong>Exemplo prático:</strong></p>
      <ul>
        <li>Salário: R$ 3.000</li>
        <li>1/3 de R$ 3.000 = R$ 1.000</li>
        <li><strong>Total férias brutas:</strong> R$ 4.000</li>
      </ul>

      <h3>Abono Pecuniário (Venda de Férias)</h3>
      <p>
        Você pode <strong>vender até 10 dias</strong> das suas férias e receber em dinheiro. Regras:
      </p>
      <ul>
        <li>✅ Solicitar ao empregador no <strong>início do período aquisitivo</strong></li>
        <li>✅ Recebe os 10 dias em dinheiro (com adicional de 1/3)</li>
        <li>✅ Descansa apenas 20 dias</li>
        <li>❌ Não pode vender mais de 10 dias</li>
      </ul>
      <p><strong>Cálculo do abono:</strong></p>
      <pre>Abono = (Salário ÷ 30) × 10 × 1,333</pre>
      <p><strong>Vale a pena vender?</strong> Você receberá mais dinheiro, mas terá menos dias de descanso. A decisão é pessoal e depende da sua necessidade financeira.</p>

      <h3>Descontos nas Férias</h3>

      <h4>INSS sobre Férias</h4>
      <p>O INSS incide sobre o valor <strong>total</strong> das férias (salário + 1/3):</p>
      <pre>Base INSS = Salário + (Salário ÷ 3)</pre>
      <p><strong>Tabela INSS 2026:</strong></p>
      <table>
        <thead>
          <tr>
            <th>Faixa</th>
            <th>Alíquota</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Até R$ 1.621,00</td>
            <td>7,5%</td>
          </tr>
          <tr>
            <td>R$ 1.621,01 a R$ 2.902,84</td>
            <td>9%</td>
          </tr>
          <tr>
            <td>R$ 2.902,85 a R$ 4.354,27</td>
            <td>12%</td>
          </tr>
          <tr>
            <td>R$ 4.354,28 a R$ 8.475,55</td>
            <td>14%</td>
          </tr>
        </tbody>
      </table>

      <h4>IRRF sobre Férias</h4>
      <p>O IRRF também incide sobre o total das férias:</p>
      <pre>Base IRRF = (Salário + 1/3) − INSS</pre>
      <p><strong>Tabela IRRF 2026:</strong></p>
      <table>
        <thead>
          <tr>
            <th>Base</th>
            <th>Alíquota</th>
            <th>Dedução</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Até R$ 2.428,80</td>
            <td>Isento</td>
            <td>-</td>
          </tr>
          <tr>
            <td>R$ 2.428,81 a R$ 2.826,65</td>
            <td>7,5%</td>
            <td>R$ 182,16</td>
          </tr>
          <tr>
            <td>R$ 2.826,66 a R$ 3.751,05</td>
            <td>15%</td>
            <td>R$ 394,16</td>
          </tr>
          <tr>
            <td>R$ 3.751,06 a R$ 4.664,68</td>
            <td>22,5%</td>
            <td>R$ 675,49</td>
          </tr>
          <tr>
            <td>Acima de R$ 4.664,68</td>
            <td>27,5%</td>
            <td>R$ 908,73</td>
          </tr>
        </tbody>
      </table>

      <h3>Exemplos Completos de Cálculo</h3>

      <h4>Exemplo 1: Férias Integrais (30 dias)</h4>
      <ul>
        <li><strong>Salário:</strong> R$ 3.000</li>
        <li><strong>Férias brutas:</strong> R$ 4.000</li>
        <li><strong>INSS:</strong> R$ 380,01</li>
        <li><strong>IRRF:</strong> R$ 157,30</li>
        <li><strong>Férias líquidas:</strong> R$ 3.462,69</li>
      </ul>

      <h4>Exemplo 2: Vendeu 10 Dias</h4>
      <ul>
        <li><strong>Salário:</strong> R$ 4.500</li>
        <li>Férias (20 dias): R$ 4.000</li>
        <li>Abono (10 dias): R$ 2.000</li>
        <li><strong>Total bruto:</strong> R$ 6.000</li>
        <li><strong>INSS:</strong> R$ 642,01</li>
        <li><strong>IRRF:</strong> R$ 440,17</li>
        <li><strong>Total líquido:</strong> R$ 4.917,82</li>
      </ul>

      <h4>Exemplo 3: Férias Proporcionais (6 meses)</h4>
      <ul>
        <li><strong>Salário:</strong> R$ 2.500</li>
        <li><strong>Meses trabalhados:</strong> 6</li>
        <li><strong>Férias proporcionais brutas:</strong> R$ 1.666,50</li>
        <li><strong>INSS:</strong> R$ 149,99</li>
        <li><strong>IRRF:</strong> R$ 0 (isento)</li>
        <li><strong>Férias líquidas:</strong> R$ 1.516,51</li>
      </ul>

      <h3>Período Aquisitivo e Concessivo</h3>
      <ul>
        <li><strong>Período aquisitivo:</strong> 12 meses de trabalho que geram o direito a férias</li>
        <li><strong>Período concessivo:</strong> 12 meses seguintes em que o empregador deve conceder as férias</li>
      </ul>
      <p>
        <strong>Importante:</strong> Se o empregador não conceder as férias dentro do período concessivo, deve pagar em <strong>dobro</strong>.
      </p>

      <h3>Férias Fracionadas</h3>
      <p>Desde a Reforma Trabalhista (2017), as férias podem ser divididas em até <strong>3 períodos</strong>:</p>
      <ul>
        <li>Um período deve ter <strong>no mínimo 14 dias</strong></li>
        <li>Os demais períodos devem ter <strong>no mínimo 5 dias</strong> cada</li>
        <li>É preciso acordo entre empregador e empregado</li>
      </ul>

      <h3>Quando Você Tem Direito às Férias</h3>
      <table>
        <thead>
          <tr>
            <th>Situação</th>
            <th>Direito</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Completou 12 meses</td>
            <td>30 dias de férias integrais</td>
          </tr>
          <tr>
            <td>Faltou até 5 dias no ano</td>
            <td>30 dias de férias</td>
          </tr>
          <tr>
            <td>Faltou 6 a 14 dias</td>
            <td>24 dias de férias</td>
          </tr>
          <tr>
            <td>Faltou 15 a 23 dias</td>
            <td>18 dias de férias</td>
          </tr>
          <tr>
            <td>Faltou 24 a 32 dias</td>
            <td>12 dias de férias</td>
          </tr>
          <tr>
            <td>Faltou mais de 32 dias</td>
            <td>Perde o direito às férias</td>
          </tr>
        </tbody>
      </table>

      <h3>Prazo de Pagamento</h3>
      <p>
        O pagamento das férias deve ser feito <strong>até 2 dias antes</strong> do início do período de descanso. O atraso gera multa para o empregador.
      </p>
    </div>
    <CalculatorFAQ heading="Perguntas frequentes sobre férias CLT" items={faqItems} />
  </article>
  <CalculatorResource locale="pt-BR" category="labor" />
</BaseLayout>

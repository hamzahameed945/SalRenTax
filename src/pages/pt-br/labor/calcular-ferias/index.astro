---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import { buildLocalePath } from '../../../../i18n/utils';
import BrFeriasCalculator from '../../../../components/islands/BrFeriasCalculator';
const locale = 'pt-BR' as const;
---
<BaseLayout locale={locale} title="Calculadora de Férias 2026 — SalRenTax" description="Calcule férias brutas e o adicional constitucional de 1/3." canonical="/pt-br/labor/calcular-ferias/">
  <Breadcrumbs locale={locale} trail={[{label:'Calculadoras trabalhistas',href:buildLocalePath(locale,'labor')}]} />
  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">Calculadora de Férias 2026</h1>
    <p class="mt-3 max-w-2xl text-slate-600">A estimativa calcula remuneração proporcional aos dias de férias e adiciona 1/3 constitucional.</p>
    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><BrFeriasCalculator client:load /></div>
    <div class="mt-8"><InContentAd slotId="br-ferias-1" /></div>
    <div class="mt-10 prose prose-slate max-w-none"><h2>Cálculo de férias</h2><p>A estimativa calcula remuneração proporcional aos dias de férias e adiciona 1/3 constitucional.</p></div>
  </article>
</BaseLayout>

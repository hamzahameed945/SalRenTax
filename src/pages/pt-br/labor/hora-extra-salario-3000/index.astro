---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import BrHorasExtrasCalculator from '../../../../components/islands/BrHorasExtrasCalculator';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'pt-BR' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'Hora extra com salário de R$ 3.000 em 2026: quanto vale? — PayRenTax',
  'Hora extra com salário de R$ 3.000: R$ 20,45 com 50% e R$ 27,27 com 100% em 2026. Veja quanto você recebe.',
  '/pt-br/labor/hora-extra-salario-3000/',
);

const faqItems = [
    {
      question: 'Quanto vale uma hora extra com salário de R$ 3.000?',
      answer:
        'Com salário de R$ 3.000, a hora extra vale R$ 20,45 com adicional de 50% e R$ 27,27 com adicional de 100% em 2026.'
    },
    {
      question: 'Como calcular hora extra com salário de R$ 3.000?',
      answer:
        'Divida o salário por 220 (jornada de 44h semanais): R$ 3.000 ÷ 220 = R$ 13,64 por hora normal. Multiplique por 1,5 para o adicional de 50%: R$ 20,45 por hora extra.'
    },
    {
      question: 'Quanto recebo por 10 horas extras ganhando R$ 3.000?',
      answer:
        'Com salário de R$ 3.000, 10 horas extras com adicional de 50% rendem R$ 204,55 em 2026.'
    }
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: 'Direitos trabalhistas', href: buildLocalePath(locale, 'labor') },
      { label: 'Hora extra com salário de R$ 3.000', href: buildLocalePath(locale, 'labor/hora-extra-salario-3000') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">Hora extra com salário de R$ 3.000 em 2026: quanto vale?</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      Com salário de <strong>R$ 3.000,00</strong> por mês, cada hora extra vale
      <strong>R$ 20,45 com adicional de 50%</strong> e <strong>R$ 27,27 com adicional de 100%</strong>
      em 2026. Veja o cálculo completo abaixo.
    </p>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold">Valor da hora extra em 2026: salário de R$ 3.000</h2>
      <table class="mt-4 w-full text-sm">
        <tbody>
          <tr><td>Valor da hora normal (salário ÷ 220)</td><td>R$ 13,64</td></tr>
          <tr><td>Hora extra com 50% (dias úteis)</td><td>R$ 20,45</td></tr>
          <tr><td>Hora extra com 100% (domingos e feriados)</td><td>R$ 27,27</td></tr>
          <tr class="font-semibold"><td>10 horas extras a 50%</td><td>R$ 204,55</td></tr>
        </tbody>
      </table>
      <p class="mt-4 text-xs text-slate-500">
        Divisor de 220 horas mensais (jornada de 44h semanais, art. 7º, XIII da Constituição).
        Convenções coletivas podem fixar divisor ou adicional diferentes. Simule na calculadora abaixo.
      </p>
    </div>

    <div class="mt-8">
      <InContentAd slotId="br-horaextra-3000" />
    </div>

    <div class="mt-10">
      <h2 class="text-xl font-semibold">Calcule suas horas extras</h2>
      <div class="mt-4">
        <BrHorasExtrasCalculator client:load />
      </div>
    </div>

    <nav class="mt-10" aria-label="Hora extra por salário">
      <h2 class="text-xl font-semibold">Hora extra por salário</h2>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/pt-br/labor/hora-extra-salario-2000/">Hora extra com salário de R$ 2.000</a></li>
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/pt-br/labor/hora-extra-salario-5000/">Hora extra com salário de R$ 5.000</a></li>
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/pt-br/labor/hora-extra-salario-8000/">Hora extra com salário de R$ 8.000</a></li>
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/pt-br/labor/hora-extra-salario-10000/">Hora extra com salário de R$ 10.000</a></li>
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/pt-br/labor/hora-extra-salario-15000/">Hora extra com salário de R$ 15.000</a></li>
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/pt-br/labor/hora-extra-salario-20000/">Hora extra com salário de R$ 20.000</a></li>
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/pt-br/labor/calculadora-horas-extras/">Calculadora de horas extras</a></li>
      </ul>
    </nav>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="Hora extra com salário de R$ 3.000: perguntas frequentes" items={faqItems} />
  </article>
</BaseLayout>

---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import BrFeriasCalculator from '../../../../components/islands/BrFeriasCalculator';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'pt-BR' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'Férias de R$ 5.000 em 2026: quanto você recebe? — PayRenTax',
  'Férias de R$ 5.000 em 2026: R$ 6.666,67 brutos (R$ 5.000,00 + R$ 1.666,67 do terço). Calcule as suas.',
  '/pt-br/labor/ferias-5000/',
);

const faqItems = [
    {
      question: 'Quanto recebo de férias com salário de R$ 5.000?',
      answer:
        'Com salário de R$ 5.000, as férias de 30 dias em 2026 valem R$ 6.666,67 brutos: R$ 5.000,00 de férias mais R$ 1.666,67 do terço constitucional.'
    },
    {
      question: 'O que é o terço de férias?',
      answer:
        'É o adicional de 1/3 sobre o salário garantido pela Constituição (art. 7º, XVII). Com salário de R$ 5.000, o terço vale R$ 1.666,67.'
    },
    {
      question: 'Quando devo receber o pagamento das férias?',
      answer:
        'O pagamento das férias deve ser feito até 2 dias antes do início do período de descanso (CLT, art. 145).'
    }
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: 'Direitos trabalhistas', href: buildLocalePath(locale, 'labor') },
      { label: 'Férias de R$ 5.000', href: buildLocalePath(locale, 'labor/ferias-5000') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">Férias de R$ 5.000 em 2026: quanto você recebe?</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      Com salário de <strong>R$ 5.000,00</strong> por mês, suas férias de 30 dias em 2026 valem
      <strong>R$ 6.666,67 brutos</strong>: R$ 5.000,00 de férias mais R$ 1.666,67 do terço constitucional.
    </p>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold">Cálculo das férias em 2026: salário de R$ 5.000</h2>
      <table class="mt-4 w-full text-sm">
        <tbody>
          <tr><td>Férias base (30 dias)</td><td>R$ 5.000,00</td></tr>
          <tr><td>Terço constitucional (+1/3)</td><td>R$ 1.666,67</td></tr>
          <tr class="font-semibold"><td>Total bruto das férias</td><td>R$ 6.666,67</td></tr>
        </tbody>
      </table>
      <p class="mt-4 text-xs text-slate-500">
        Valores brutos, sem descontos de INSS e IRRF. O pagamento deve cair até 2 dias
        antes do início das férias (CLT, art. 145). Simule na calculadora abaixo.
      </p>
    </div>

    <div class="mt-8">
      <InContentAd slotId="br-ferias-5000" />
    </div>

    <div class="mt-10">
      <h2 class="text-xl font-semibold">Calcule suas férias</h2>
      <div class="mt-4">
        <BrFeriasCalculator client:load />
      </div>
    </div>

    <nav class="mt-10" aria-label="Férias por salário">
      <h2 class="text-xl font-semibold">Férias por salário</h2>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/pt-br/labor/ferias-2000/">Férias de R$ 2.000</a></li>
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/pt-br/labor/ferias-3000/">Férias de R$ 3.000</a></li>
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/pt-br/labor/ferias-8000/">Férias de R$ 8.000</a></li>
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/pt-br/labor/ferias-10000/">Férias de R$ 10.000</a></li>
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/pt-br/labor/ferias-15000/">Férias de R$ 15.000</a></li>
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/pt-br/labor/ferias-20000/">Férias de R$ 20.000</a></li>
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/pt-br/labor/calcular-ferias/">Calculadora de férias</a></li>
      </ul>
    </nav>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="Férias de R$ 5.000: perguntas frequentes" items={faqItems} />
  </article>
</BaseLayout>

---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import BrSalarioLiquidoCalculator from '../../../../components/islands/BrSalarioLiquidoCalculator';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'pt-BR' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'Salário de R$ 15.000: quanto fica líquido em 2026? — PayRenTax',
  'Um salário de R$ 15.000 em 2026 fica R$ 11.067,36 líquido por mês, após INSS (R$ 988,09) e IRRF (R$ 2.944,54). Veja o cálculo completo.',
  '/pt-br/salary/salario-liquido-15000/',
);

const faqItems = [
    {
      question: 'Quanto fica líquido um salário de R$ 15.000 em 2026?',
      answer:
        'Um salário de R$ 15.000 fica R$ 11.067,36 líquido por mês em 2026, após descontar R$ 988,09 de INSS e R$ 2.944,54 de Imposto de Renda.'
    },
    {
      question: 'Quanto é descontado de INSS em um salário de R$ 15.000?',
      answer:
        'O desconto do INSS em um salário de R$ 15.000 é R$ 988,09 por mês em 2026, calculado pelas alíquotas progressivas oficiais (7,5% a 14%).'
    },
    {
      question: 'Quanto é o Imposto de Renda em um salário de R$ 15.000?',
      answer:
        'O Imposto de Renda retido na fonte em um salário de R$ 15.000 é R$ 2.944,54 por mês em 2026, após a dedução do INSS e a faixa de isenção até R$ 5.000.'
    }
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: 'Calculadoras de salário', href: buildLocalePath(locale, 'salary') },
      { label: 'Salário de R$ 15.000 líquido', href: buildLocalePath(locale, 'salary/salario-liquido-15000') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">Salário de R$ 15.000: quanto fica líquido em 2026?</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      Um salário bruto de <strong>R$ 15.000,00</strong> por mês fica <strong>R$ 11.067,36 líquido</strong> em 2026,
      após os descontos de INSS (R$ 988,09) e Imposto de Renda (R$ 2.944,54).
    </p>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold">Descontos em 2026: salário de R$ 15.000</h2>
      <table class="mt-4 w-full text-sm">
        <tbody>
          <tr><td>Salário bruto mensal</td><td>R$ 15.000,00</td></tr>
          <tr><td>INSS (progressivo)</td><td>R$ 988,09</td></tr>
          <tr><td>IRRF (Imposto de Renda)</td><td>R$ 2.944,54</td></tr>
          <tr class="font-semibold"><td>Salário líquido mensal</td><td>R$ 11.067,36</td></tr>
        </tbody>
      </table>
      <p class="mt-4 text-xs text-slate-500">
        Cálculo para 2026 sem dependentes, com tabelas oficiais de INSS e IRRF.
        Valores estimados — ajuste na calculadora abaixo.
      </p>
    </div>

    <div class="mt-8">
      <InContentAd slotId="br-salario-15000" />
    </div>

    <div class="mt-10">
      <h2 class="text-xl font-semibold">Calcule seu salário líquido</h2>
      <div class="mt-4">
        <BrSalarioLiquidoCalculator client:load />
      </div>
    </div>

    <nav class="mt-10" aria-label="Outros salários">
      <h2 class="text-xl font-semibold">Outros salários</h2>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/pt-br/salary/salario-liquido-2000/">Salário de R$ 2.000 líquido</a></li>
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/pt-br/salary/salario-liquido-3000/">Salário de R$ 3.000 líquido</a></li>
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/pt-br/salary/salario-liquido-5000/">Salário de R$ 5.000 líquido</a></li>
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/pt-br/salary/salario-liquido-8000/">Salário de R$ 8.000 líquido</a></li>
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/pt-br/salary/salario-liquido-10000/">Salário de R$ 10.000 líquido</a></li>
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/pt-br/salary/salario-liquido-20000/">Salário de R$ 20.000 líquido</a></li>
        <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/pt-br/salary/calculadora-salario-liquido/">Calculadora de salário líquido</a></li>
      </ul>
    </nav>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="Salário de R$ 15.000: perguntas frequentes" items={faqItems} />
  </article>
</BaseLayout>

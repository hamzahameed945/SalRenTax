---
import CalculatorResource from '../../../../components/content/CalculatorResource.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import { buildLocalePath } from '../../../../i18n/utils';
import BrSalarioLiquidoCalculator from '../../../../components/islands/BrSalarioLiquidoCalculator';
const locale = 'pt-BR' as const;
---

<BaseLayout
  locale={locale}
  title="Calculadora de Salário Líquido 2026 — PayRenTax"
  description="Calcule o salário líquido mensal no Brasil com INSS e IRRF 2026. Inclui dedução de dependentes e detalhamento completo por faixas."
  canonical="/pt-br/salary/calculadora-salario-liquido/"
>
  <Breadcrumbs
    locale={locale}
    trail={[{ label: 'Calculadoras de salário', href: buildLocalePath(locale, 'salary') }]}
  />
  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">Calculadora de Salário Líquido 2026</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      Calcule o salário líquido mensal com INSS progressivo, IRRF 2026 e dedução de dependentes. 
      Veja o detalhamento completo por faixas de contribuição.
    </p>
    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <BrSalarioLiquidoCalculator client:load />
    </div>
    <div class="mt-8">
      <InContentAd slotId="br-salario-liquido-1" />
    </div>
    <div class="mt-10 prose prose-slate max-w-none">
      <h2>Como funciona o cálculo</h2>
      <p>
        A calculadora aplica as tabelas oficiais de INSS e IRRF de 2026. O INSS é calculado 
        progressivamente por faixas (7,5% a 14%), e o IRRF considera a nova regra de isenção 
        até R$ 5.000 mensais com redução gradual até R$ 7.350.
      </p>
      <p>
        Cada dependente deduz R$ 189,59 mensais da base de cálculo do IRRF, reduzindo o imposto devido.
      </p>
      <h3>INSS 2026</h3>
      <ul>
        <li>Até R$ 1.621,00: 7,5%</li>
        <li>De R$ 1.621,01 até R$ 2.902,84: 9%</li>
        <li>De R$ 2.902,85 até R$ 4.354,27: 12%</li>
        <li>De R$ 4.354,28 até R$ 8.475,55 (teto): 14%</li>
      </ul>
      <h3>IRRF 2026</h3>
      <p>
        A partir de 2026, salários até R$ 5.000 mensais são isentos de IRRF. Entre R$ 5.000,01 
        e R$ 7.350,00 há uma redução gradual do imposto. Acima disso, aplicam-se as alíquotas 
        progressivas de 7,5% a 27,5%.
      </p>
    </div>
  </article>
  <CalculatorResource locale="pt-BR" category="salary" />
</BaseLayout>

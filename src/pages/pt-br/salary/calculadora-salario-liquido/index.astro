---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import { buildLocalePath } from '../../../../i18n/utils';
import BrSalarioLiquidoCalculator from '../../../../components/islands/BrSalarioLiquidoCalculator';
const locale = 'pt-BR' as const;
---
<BaseLayout locale={locale} title="Calculadora de Salário Líquido 2026 — SalRenTax" description="Calcule uma estimativa do salário líquido mensal no Brasil com INSS e IRRF 2026." canonical="/pt-br/salary/calculadora-salario-liquido/">
  <Breadcrumbs locale={locale} trail={[{label:'Calculadoras de salário',href:buildLocalePath(locale,'salary')}]} />
  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">Calculadora de Salário Líquido 2026</h1>
    <p class="mt-3 max-w-2xl text-slate-600">O cálculo estima INSS progressivo e IRRF mensal de 2026. Não inclui dependentes ou outras deduções pessoais.</p>
    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><BrSalarioLiquidoCalculator client:load /></div>
    <div class="mt-8"><InContentAd slotId="br-salario-liquido-1" /></div>
    <div class="mt-10 prose prose-slate max-w-none"><h2>Salário líquido</h2><p>O cálculo estima INSS progressivo e IRRF mensal de 2026. Não inclui dependentes ou outras deduções pessoais.</p></div>
  </article>
</BaseLayout>

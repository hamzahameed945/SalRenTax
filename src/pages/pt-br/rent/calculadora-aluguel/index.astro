---
import CalculatorResource from '../../../../components/content/CalculatorResource.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import RentAffordabilityCalculator from '../../../../components/islands/RentAffordabilityCalculator';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'pt-BR' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'Calculadora de Quanto Posso Pagar de Aluguel — PayRenTax',
  t.rent.rentAffordability.intro,
  '/pt-br/rent/calculadora-aluguel/',
);

const faqItems = [
  {
    question: 'Quanto da minha renda devo gastar com aluguel?',
    answer:
      'A regra dos 30% recomenda gastar no máximo 30% da renda bruta com aluguel. No Brasil, o Código Civil permite ao proprietário exigir comprovação de renda equivalente a 3 vezes o valor do aluguel (ou seja, aluguel de até 33% da renda). Em São Paulo e Rio de Janeiro, muitos inquilinos gastam 35–40% da renda.',
  },
  {
    question: 'O que são os índices de reajuste de aluguel no Brasil?',
    answer:
      'Os aluguéis residenciais são reajustados anualmente pelo IGP-M (Índice Geral de Preços do Mercado) ou pelo IPCA (Índice de Preços ao Consumidor Amplo), conforme acordado em contrato. O IGP-M é publicado pela FGV e o IPCA pelo IBGE.',
  },
  {
    question: 'Quais são os custos além do aluguel que preciso considerar?',
    answer:
      'Além do valor do aluguel, considere: IPTU (imposto predial), condomínio, água, luz e gás. Em muitas cidades, esses custos adicionais representam 20–40% do valor do aluguel. Inclua esses valores no seu planejamento financeiro.',
  },
  {
    question: 'Como funciona a garantia locatícia no Brasil?',
    answer:
      'A Lei do Inquilinato (Lei 8.245/91) prevê quatro tipos de garantia: fiador, caução (depósito de até 3 meses), seguro-fiança e cessão fiduciária de quotas. O proprietário só pode exigir um tipo de garantia por contrato.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  equivalentPageGroup="rent-affordability"
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: t.navigation.rent, href: buildLocalePath(locale, 'rent') },
      { label: t.rent.rentAffordability.title, href: buildLocalePath(locale, 'rent/calculadora-aluguel') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">{t.rent.rentAffordability.h1}</h1>
    <p class="mt-3 max-w-2xl text-slate-600">{t.rent.rentAffordability.intro}</p>

    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <RentAffordabilityCalculator client:load locale={locale} />
    </div>

    <div class="mt-8">
      <InContentAd slotId="br-rent-affordability-1" />
    </div>

    <div class="mt-10 prose prose-slate max-w-none">
      <h2>Comprometimento de renda com aluguel — regra dos 30%</h2>
      <table>
        <thead>
          <tr>
            <th>Renda bruta mensal</th>
            <th>Aluguel máx. (30%)</th>
            <th>Aluguel máx. (33%)</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>R$ 3.000</td><td>R$ 900</td><td>R$ 990</td></tr>
          <tr><td>R$ 5.000</td><td>R$ 1.500</td><td>R$ 1.650</td></tr>
          <tr><td>R$ 8.000</td><td>R$ 2.400</td><td>R$ 2.640</td></tr>
          <tr><td>R$ 12.000</td><td>R$ 3.600</td><td>R$ 3.960</td></tr>
          <tr><td>R$ 20.000</td><td>R$ 6.000</td><td>R$ 6.600</td></tr>
        </tbody>
      </table>
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.verifyProfessional} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="Perguntas frequentes sobre aluguel" items={faqItems} />
  </article>
  <CalculatorResource locale="pt-BR" category="rent" />
</BaseLayout>

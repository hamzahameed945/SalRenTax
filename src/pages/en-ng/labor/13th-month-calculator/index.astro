---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import RelatedCalculators from '../../../../components/content/RelatedCalculators.astro';
import NgThirteenthMonthCalculator from '../../../../components/islands/NgThirteenthMonthCalculator';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'en-NG' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  '13th Month Salary Calculator Nigeria 2026: Net Bonus After PAYE — PayRenTax',
  'Estimate your Nigeria 13th month salary bonus for 2026: one month’s gross salary minus PAYE at your marginal rate under the Nigeria Tax Act 2025 bands. For example, a ₦500,000 monthly salary nets an estimated ₦410,000 bonus after ₦90,000 PAYE.',
  '/en-ng/labor/13th-month-calculator/',
);

const faqItems = [
  {
    question: 'Is 13th month salary mandatory in Nigeria?',
    answer:
      'No. Unlike the Philippines, where 13th month pay is a legal requirement, in Nigeria the 13th month is customary rather than statutory. Employers decide whether to pay it, how it is calculated, and who qualifies — so confirm what your own employer offers.',
  },
  {
    question: 'How much tax will I pay on my 13th month salary in Nigeria?',
    answer:
      'The bonus is treated as employment income, so PAYE is withheld at your marginal rate under the Nigeria Tax Act 2025 bands: the first ₦800,000 of annual income at 0%, then 15% up to ₦3 million, 18% up to ₦12 million, 21% up to ₦25 million, 23% up to ₦50 million, and 25% above that. For example, with a ₦500,000 monthly salary (₦6 million a year), your marginal rate is 18%, so PAYE on a ₦500,000 bonus is ₦90,000 and the estimated net bonus is ₦410,000.',
  },
  {
    question: 'How is the 13th month salary calculated in Nigeria?',
    answer:
      'It is typically one full month’s gross salary, paid on top of your regular pay. The calculator takes your monthly gross salary as the gross bonus and estimates PAYE from your annual salary (excluding the bonus) using your marginal band under the Nigeria Tax Act 2025, then subtracts the tax to give the net bonus.',
  },
  {
    question: 'When is 13th month salary usually paid in Nigeria?',
    answer:
      'Employers that pay a 13th month usually do so in December, before Christmas. Because it is customary rather than mandatory, the exact timing is at the employer’s discretion — confirm the payment date with your HR or payroll department.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: t.navigation.labor, href: buildLocalePath(locale, 'labor') },
      { label: '13th Month Salary Calculator', href: buildLocalePath(locale, 'labor/13th-month-calculator') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">Nigeria 13th Month Salary Calculator 2026</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      Estimate your <strong>13th month salary bonus</strong>: one month’s gross salary, minus
      PAYE at your marginal rate under the <strong>Nigeria Tax Act 2025</strong> bands.
    </p>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold">Worked example: ₦500,000 monthly salary</h2>
      <table class="mt-4 w-full text-sm">
        <tbody>
          <tr><td>Monthly gross salary</td><td>₦500,000</td></tr>
          <tr><td>Gross 13th month (1 × monthly salary)</td><td>₦500,000</td></tr>
          <tr><td>Annual salary (excl. bonus): ₦6,000,000 → marginal rate 18%</td><td>—</td></tr>
          <tr><td>PAYE on bonus (18%)</td><td>₦90,000</td></tr>
          <tr class="font-semibold"><td>Estimated net bonus</td><td>₦410,000</td></tr>
        </tbody>
      </table>
      <p class="mt-4 text-xs text-slate-500">
        The Nigeria Tax Act 2025 bands (effective 1 January 2026) tax the first ₦800,000 of
        annual income at 0%, then 15% to ₦3 million, 18% to ₦12 million, 21% to ₦25 million,
        23% to ₦50 million, and 25% above that. The 13th month is customary in Nigeria — not
        legally required — so your employer’s own scheme may differ.
      </p>
    </div>

    <div class="mt-8">
      <InContentAd slotId="ng-13th-month-1" />
    </div>

    <div class="mt-10">
      <h2 class="text-xl font-semibold">Calculate your 13th month bonus</h2>
      <div class="mt-4">
        <NgThirteenthMonthCalculator client:load initialSalary={500000} />
      </div>
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} 2026 estimate only; your employer’s 13th month scheme and payroll
      treatment may differ. The 13th month is customary in Nigeria, not a legal requirement.
    </p>

    <RelatedCalculators
      heading={t.common.relatedCalculators}
      links={[
        { label: t.labor.categoryTitle, href: buildLocalePath(locale, 'labor') },
        { label: 'Nigeria calculators home', href: buildLocalePath(locale) },
      ]}
    />

    <CalculatorFAQ heading="13th month salary Nigeria: frequently asked questions" items={faqItems} />
  </article>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDictionary } from '../../i18n/dictionaries';
import { buildPageMetadata } from '../../lib/seo/metadata';
import TiltCard from '../../components/islands/TiltCard';
import { categoryMeta } from '../../data/categoryMeta';

const locale = 'en-NG' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(t.meta.localeHomeTitle, t.meta.localeHomeDescription, '/en-ng/');

const calculators = [
  {
    slug: 'labor/13th-month-calculator',
    title: '13th Month Salary Calculator',
    desc: 'Gross bonus of one month’s salary, PAYE, and your net bonus for 2026',
  },
];
const cm = categoryMeta['labor'] ?? categoryMeta['salary'];
---

<BaseLayout locale={locale} title={meta.title} description={meta.description} canonical={meta.canonical}>
  <section class="relative overflow-hidden bg-gradient-to-br from-slate-50 via-white to-slate-50">
    <div class="relative z-10 mx-auto max-w-5xl px-4 pt-16 pb-20 text-center sm:pt-24 sm:pb-28">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent">Calculators 2026</p>
      <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
        Nigeria 13th Month Salary Calculators
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-slate-600 leading-relaxed">
        {t.meta.localeHomeDescription}
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-16 sm:py-20">
    <h2 class="text-2xl font-bold text-slate-900 sm:text-3xl mb-2">{t.common.popularCalculators}</h2>
    <p class="text-slate-500 mb-8">Estimate your 13th month bonus under the Nigeria Tax Act 2025 PAYE bands.</p>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {calculators.map((page, i) => (
        <div class="perspective-1000" style={`animation-delay: ${i * 80}ms;`}>
          <TiltCard client:visible href={`/en-ng/${page.slug}/`} glowColor={cm.glow}>
            <div class="p-6">
              <div class={`mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br ${cm.gradient} text-xl shadow-md`}>
                <span class="drop-shadow-sm">{cm.icon}</span>
              </div>
              <h3 class="text-base font-bold text-slate-900 leading-snug">
                {page.title}
              </h3>
              <p class="mt-1 text-sm text-slate-500 leading-snug">{page.desc}</p>
              <div class="mt-4 flex items-center gap-1.5 text-sm font-semibold text-accent">
                Calculate
                <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </div>
            </div>
          </TiltCard>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 pb-16">
    <h2 class="text-xl font-semibold text-slate-900 mb-4">13th Month Salary Nigeria 2026</h2>
    <div class="space-y-4 text-slate-600">
      <p>
        A <strong>13th month salary</strong> is an extra month’s pay many Nigerian employers
        give their staff at the end of the year — typically paid before Christmas. Unlike the
        Philippines’ 13th month pay, it is <strong>customary, not legally mandatory</strong>:
        employers vary in whether they pay it, how it is calculated, and who qualifies.
      </p>
      <p>
        The bonus counts as employment income, so <strong>PAYE applies</strong>. This
        calculator estimates the tax using the Nigeria Tax Act 2025 bands (first ₦800,000 of
        annual income at 0%, then 15%, 18%, 21%, 23%, and 25% above ₦50 million) applied at
        your marginal rate.
      </p>
    </div>
  </section>
</BaseLayout>

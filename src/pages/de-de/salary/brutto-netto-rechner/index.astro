---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import BruttoNettoCalculator from '../../../../components/islands/BruttoNettoCalculator';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'de-DE' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'Brutto-Netto-Rechner 2026 — Sozialversicherung — SalRenTax',
  'Berechnen Sie Ihre Sozialversicherungsbeiträge (Renten-, Kranken-, Arbeitslosen- und Pflegeversicherung) für 2026 mit verifizierten Werten.',
  '/de-de/salary/brutto-netto-rechner/',
);

const faqItems = [
  {
    question: 'Was zeigt der Brutto-Netto-Rechner?',
    answer: 'Dieser Rechner zeigt die Arbeitnehmeranteile der Sozialversicherungsbeiträge (Renten-, Kranken-, Arbeitslosen- und Pflegeversicherung) für 2026. Die Lohnsteuer ist noch nicht enthalten.',
  },
  {
    question: 'Warum fehlt die Lohnsteuer im Ergebnis?',
    answer: 'Die Berechnung der Lohnsteuer nach § 32a EStG erfordert die offizielle Tarifformel des BMF, die für 2026 noch verifiziert wird. Das Ergebnis zeigt den Betrag vor Abzug der Lohnsteuer.',
  },
  {
    question: 'Wie hoch ist der Rentenversicherungsbeitrag 2026?',
    answer: 'Der Gesamtbeitrag zur Rentenversicherung beträgt 18,6 %, davon trägt der Arbeitnehmer die Hälfte (9,3 %). Die Beitragsbemessungsgrenze liegt bei 8.450 € monatlich (West).',
  },
  {
    question: 'Was ist der Zusatzbeitrag zur Krankenversicherung?',
    answer: 'Der durchschnittliche Zusatzbeitrag zur gesetzlichen Krankenversicherung beträgt 2026 ca. 2,9 %. Der genaue Betrag hängt von Ihrer Krankenkasse ab.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  equivalentPageGroup="brutto-netto-rechner"
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: t.navigation.salary, href: buildLocalePath(locale, 'salary') },
      { label: t.salary.bruttoNetto.title, href: buildLocalePath(locale, 'salary/brutto-netto-rechner') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">{t.salary.bruttoNetto.h1}</h1>
    <p class="mt-3 max-w-2xl text-slate-600">{t.salary.bruttoNetto.intro}</p>

    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <BruttoNettoCalculator client:load locale={locale} />
    </div>

    <div class="mt-8">
      <InContentAd slotId="de-bruttonetto-1" />
    </div>

    <div class="mt-10 prose prose-slate max-w-none">
      <h2>Sozialversicherungsbeiträge 2026 im Überblick</h2>
      <table>
        <thead>
          <tr><th>Versicherung</th><th>Gesamtbeitrag</th><th>Arbeitnehmeranteil</th></tr>
        </thead>
        <tbody>
          <tr><td>Rentenversicherung</td><td>18,6 %</td><td>9,3 %</td></tr>
          <tr><td>Arbeitslosenversicherung</td><td>2,6 %</td><td>1,3 %</td></tr>
          <tr><td>Krankenversicherung</td><td>14,6 % + Zusatz</td><td>Hälfte</td></tr>
          <tr><td>Pflegeversicherung</td><td>3,6 %</td><td>variiert</td></tr>
        </tbody>
      </table>
      <p>
        Die Beitragsbemessungsgrenzen: <strong>8.450 €/Monat</strong> für Renten- und Arbeitslosenversicherung,
        <strong>5.812,50 €/Monat</strong> für Kranken- und Pflegeversicherung.
      </p>
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="Häufig gestellte Fragen" items={faqItems} />
  </article>
</BaseLayout>

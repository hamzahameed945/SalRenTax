---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import { buildLocalePath } from '../../../../i18n/utils';
import DePartTimeSalaryCalculator from '../../../../components/islands/DePartTimeSalaryCalculator';
const locale = 'de-DE' as const;
---
<BaseLayout locale={locale} title="Gehaltsrechner Teilzeit — SalRenTax" description="Berechnen Sie ein geschätztes Teilzeit-Bruttogehalt aus Vollzeitgehalt und Wochenstunden." canonical="/de-de/salary/gehaltsrechner-teilzeit/">
  <Breadcrumbs locale={locale} trail={[{label:'Gehaltsrechner',href:buildLocalePath(locale,'salary')}]} />
  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">Gehaltsrechner Teilzeit</h1>
    <p class="mt-3 max-w-2xl text-slate-600">Der Rechner skaliert das Vollzeit-Bruttogehalt proportional zu den Arbeitsstunden.</p>
    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><DePartTimeSalaryCalculator client:load /></div>
    <div class="mt-8"><InContentAd slotId="de-teilzeit-1" /></div>
    <div class="mt-10 prose prose-slate max-w-none"><h2>Teilzeitgehalt</h2><p>Der Rechner skaliert das Vollzeit-Bruttogehalt proportional zu den Arbeitsstunden.</p></div>
  </article>
</BaseLayout>

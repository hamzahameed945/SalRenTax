---
import CalculatorResource from '../../../../components/content/CalculatorResource.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import BruttoNettoCalculator from '../../../../components/islands/BruttoNettoCalculator';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'de-DE' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'Brutto-Netto-Rechner NRW 2026 — Kirchensteuer 9 % — PayRenTax',
  'Berechnen Sie Ihr Nettogehalt in Nordrhein-Westfalen 2026 inklusive Kirchensteuer 9 %, Lohnsteuer, Solidaritätszuschlag und Sozialversicherung.',
  '/de-de/salary/brutto-netto-rechner-nrw/',
);

const faqItems = [
  {
    question: 'Wie hoch ist die Kirchensteuer in NRW?',
    answer:
      'In Nordrhein-Westfalen — wie in allen Bundesländern außer Bayern — beträgt die Kirchensteuer 9 % der Lohnsteuer. Sie zahlen sie nur als Mitglied einer steuererhebenden Religionsgemeinschaft.',
  },
  {
    question: 'Was unterscheidet den NRW-Rechner vom allgemeinen Brutto-Netto-Rechner?',
    answer:
      'Der Rechner für NRW wählt automatisch Kirchensteuer 9 % vor. Das entspricht dem Kirchensteuersatz aller Bundesländer außer Bayern. Sie können die Kirchensteuer deaktivieren, wenn Sie kein Kirchenmitglied sind.',
  },
  {
    question: 'Gibt es weitere regionale Unterschiede beim Nettogehalt in NRW?',
    answer:
      'Nein — abgesehen von der Kirchensteuer sind Lohnsteuer, Sozialversicherungsbeiträge und Solidaritätszuschlag in Deutschland einheitlich. Der einzige weitere regionale Sonderfall betrifft Sachsen, wo die Pflegeversicherung anders aufgeteilt wird.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  equivalentPageGroup="de-brutto-netto-rechner-nrw"
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: t.navigation.salary, href: buildLocalePath(locale, 'salary') },
      { label: 'Brutto-Netto-Rechner', href: buildLocalePath(locale, 'salary/brutto-netto-rechner') },
      { label: 'NRW', href: buildLocalePath(locale, 'salary/brutto-netto-rechner-nrw') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">Brutto-Netto-Rechner NRW 2026</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      Berechnen Sie Ihr Nettogehalt in Nordrhein-Westfalen 2026 — inklusive Kirchensteuer 9 %,
      Lohnsteuer nach § 32a EStG, Solidaritätszuschlag und allen Steuerklassen. Die Kirchensteuer
      ist vorausgewählt; deaktivieren Sie sie bei Nicht-Kirchenmitgliedschaft.
    </p>

    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <BruttoNettoCalculator client:load locale={locale} defaultKirchensteuer="other" />
    </div>

    <div class="mt-8">
      <InContentAd slotId="de-nrw-1" />
    </div>

    <div class="mt-10 prose prose-slate max-w-none">
      <h2>Kirchensteuer in NRW</h2>
      <p>
        Nordrhein-Westfalen erhebt Kirchensteuer in Höhe von <strong>9 % der Lohnsteuer</strong>.
        Das gilt für alle Bundesländer außer Bayern (8 %). Die Kirchensteuer ist eine Annexsteuer
        zur Lohnsteuer: Fällt keine Lohnsteuer an, entsteht auch keine Kirchensteuer.
      </p>
      <p>
        NRW ist das bevölkerungsreichste Bundesland Deutschlands mit Städten wie Köln, Düsseldorf,
        Dortmund und Essen. Das Durchschnittsgehalt in NRW liegt bei rund 3.800 € brutto monatlich.
      </p>
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.verifyProfessional} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="Häufig gestellte Fragen — NRW" items={faqItems} />
  </article>
  <CalculatorResource locale="de-DE" category="salary" />
</BaseLayout>

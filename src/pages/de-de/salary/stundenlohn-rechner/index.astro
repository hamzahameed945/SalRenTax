---
import CalculatorResource from '../../../../components/content/CalculatorResource.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';
import DeStundenlohnCalculator from '../../../../components/islands/DeStundenlohnCalculator';
const locale = 'de-DE' as const;

const faqItems = [
  {
    question: 'Wie berechnet man den Stundenlohn aus dem Monatsgehalt?',
    answer:
      'Stundenlohn = Monatsgehalt × 12 ÷ (Wochenstunden × 52). Beispiel: 3.500 € Monatsgehalt bei 40 Wochenstunden ergeben 3.500 × 12 ÷ (40 × 52) = 42.000 ÷ 2.080 ≈ 20,19 € pro Stunde. Noch einfacher geht es mit dem Rechner oben auf dieser Seite.',
  },
  {
    question: 'Stundenlohn brutto vs. netto — was bleibt übrig?',
    answer:
      'Brutto ist der Stundenlohn vor Lohnsteuer und Sozialabgaben, netto das, was nach allen Abzügen übrig bleibt. Wie viel netto von Ihrem Stundenlohn bleibt, hängt unter anderem von Steuerklasse, Bundesland, Kirchensteuer und Krankenkasse ab. Mit unserem Brutto-Netto-Rechner können Sie das für Ihr Gehalt prüfen.',
  },
  {
    question: 'Was ist ein guter Stundenlohn 2026?',
    answer:
      'Die absolute Untergrenze bildet der gesetzliche Mindestlohn: 13,90 € pro Stunde im Jahr 2026. Ob ein Stundenlohn darüber hinaus als gut gilt, hängt von Beruf, Qualifikation, Region und Arbeitszeit ab — als Orientierung liegt ein guter Stundenlohn in der Regel deutlich über dem Mindestlohn.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title="Stundenlohn Rechner 2026 — PayRenTax"
  description="Berechnen Sie Ihren Stundenlohn für 2026 aus Gehalt und Arbeitszeiten — mit Formel, Beispiel und Brutto-Netto-Einordnung."
  canonical="/de-de/salary/stundenlohn-rechner/"
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[{ label: 'Gehaltsrechner', href: buildLocalePath(locale, 'salary') }]}
  />
  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">Stundenlohn Rechner 2026</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      Geben Sie Jahresgehalt, Wochenstunden und Arbeitswochen ein, um Ihren rechnerischen
      Stundenlohn zu schätzen.
    </p>
    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <DeStundenlohnCalculator client:load />
    </div>
    <div class="mt-8">
      <InContentAd slotId="de-stundenlohn-1" />
    </div>
    <div class="mt-10 prose prose-slate max-w-none">
      <h2>Stundenlohn aus Gehalt berechnen</h2>
      <p>
        Geben Sie Jahresgehalt, Wochenstunden und Arbeitswochen ein, um Ihren rechnerischen
        Stundenlohn zu schätzen.
      </p>
    </div>
    <CalculatorFAQ heading="Häufig gestellte Fragen" items={faqItems} />
  </article>
  <CalculatorResource locale="de-DE" category="salary" />
</BaseLayout>

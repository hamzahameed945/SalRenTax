---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import { buildLocalePath } from '../../../../i18n/utils';
import BruttoNettoCalculator from '../../../../components/islands/BruttoNettoCalculator';
const locale = 'de-DE' as const;
---
<BaseLayout locale={locale} title="Brutto Netto Rechner Bayern 2026 — SalRenTax" description="Berechnen Sie Sozialversicherungsbeiträge für ein Bruttogehalt in Bayern." canonical="/de-de/salary/brutto-netto-rechner-bayern/">
  <Breadcrumbs locale={locale} trail={[{label:'Brutto-Netto-Rechner',href:buildLocalePath(locale,'salary/brutto-netto-rechner')}]} />
  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">Brutto Netto Rechner Bayern 2026</h1>
    <p class="mt-3 max-w-2xl text-slate-600">Dieses Modell berechnet die versicherten Arbeitnehmerbeiträge wie der allgemeine 2026-Rechner; regionale Steuerbesonderheiten werden nicht vollständig modelliert.</p>
    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><BruttoNettoCalculator client:load /></div>
    <div class="mt-8"><InContentAd slotId="de-bayern-1" /></div>
    <div class="mt-10 prose prose-slate max-w-none"><h2>Brutto-Netto-Rechner Bayern</h2><p>Dieses Modell berechnet die versicherten Arbeitnehmerbeiträge wie der allgemeine 2026-Rechner; regionale Steuerbesonderheiten werden nicht vollständig modelliert.</p></div>
  </article>
</BaseLayout>

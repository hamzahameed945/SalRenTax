---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDictionary } from '../../i18n/dictionaries';
import { getActivePagesForLocale } from '../../seo/page-registry';
import { buildPageMetadata } from '../../lib/seo/metadata';
import { buildLocalePath } from '../../i18n/utils';
import TiltCard from '../../components/islands/TiltCard';
import { categoryMeta } from '../../data/categoryMeta';

const locale = 'de-DE' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(t.meta.localeHomeTitle, t.meta.localeHomeDescription, '/de-de/');
const calculatorPages = getActivePagesForLocale(locale).filter((p) => p.pageType === 'calculator');
---

<BaseLayout locale={locale} title={meta.title} description={meta.description} canonical={meta.canonical}>
  <section class="relative overflow-hidden bg-gradient-to-br from-slate-50 via-white to-slate-50">
    <div class="relative z-10 mx-auto max-w-5xl px-4 pt-16 pb-20 text-center sm:pt-24 sm:pb-28">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent">Gehaltsrechner 2026</p>
      <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
        Deutschland — Gehalts- &amp; Lohnrechner
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-slate-600 leading-relaxed">
        {t.meta.localeHomeDescription}
      </p>
    </div>
  </section>

  <!-- ═══ Calculator Cards ═══ -->
  <section class="mx-auto max-w-5xl px-4 py-16 sm:py-20">
    <h2 class="text-2xl font-bold text-slate-900 sm:text-3xl mb-2">{t.common.popularCalculators}</h2>
    <p class="text-slate-500 mb-8">Schneller Zugriff auf die meistgenutzten Rechner.</p>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {calculatorPages.map((page, i) => {
        const cm = categoryMeta[page.category] ?? categoryMeta['salary'];
        return (
          <div class="perspective-1000" style={`animation-delay: ${i * 80}ms;`}>
            <TiltCard
              client:visible
              href={buildLocalePath(locale, page.slug)}
              glowColor={cm.glow}
            >
              <div class="p-6">
                <div class={`mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br ${cm.gradient} text-xl shadow-md`}>
                  <span class="drop-shadow-sm">{cm.icon}</span>
                </div>
                <h3 class="text-base font-bold text-slate-900 leading-snug">
                  {page.primaryKeyword}
                </h3>
                {page.description && (
                  <p class="mt-1 text-sm text-slate-500 leading-snug">{page.description}</p>
                )}
                <div class="mt-4 flex items-center gap-1.5 text-sm font-semibold text-accent">
                  Öffnen
                  <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                  </svg>
                </div>
              </div>
            </TiltCard>
          </div>
        );
      })}
    </div>
  </section>

  <!-- SEO content block -->
  <section class="mx-auto max-w-3xl px-4 pb-16">
    <h2 class="text-xl font-semibold text-slate-900 mb-4">Gehaltsrechner Deutschland 2026 — Alles Wissenswerte</h2>
    <div class="prose prose-slate max-w-none text-slate-600 space-y-4">
      <p>
        Der gesetzliche Mindestlohn in Deutschland beträgt seit dem 1. Januar 2026 <strong>13,90 € pro Stunde</strong>.
        Mit unserem Mindestlohn-Rechner berechnen Sie Ihren Wochen-, Monats- und Jahreslohn auf Basis des aktuellen Mindestlohns.
      </p>
      <p>
        Der Brutto-Netto-Rechner zeigt Ihnen die Abzüge für Rentenversicherung, Krankenversicherung,
        Arbeitslosenversicherung und Pflegeversicherung für 2026. Alle Werte basieren auf offiziellen Quellen der
        Deutschen Rentenversicherung und der Bundesregierung.
      </p>
      <p>
        <strong>Hinweis zur Lohnsteuer:</strong> Die Lohnsteuerberechnung nach § 32a EStG ist noch nicht implementiert,
        da die amtliche Tarifformel für 2026 derzeit verifiziert wird. Die Ergebnisse zeigen die Sozialversicherungsbeiträge vor Lohnsteuer.
      </p>
    </div>
  </section>
</BaseLayout>

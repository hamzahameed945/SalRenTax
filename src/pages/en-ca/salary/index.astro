---
import CategoryResource from '../../../components/content/CategoryResource.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/navigation/Breadcrumbs.astro';
import { getDictionary } from '../../../i18n/dictionaries';
import { getActivePagesForLocale } from '../../../seo/page-registry';
import { buildPageMetadata } from '../../../lib/seo/metadata';
import { buildLocalePath } from '../../../i18n/utils';

const locale = 'en-CA' as const;
const t = getDictionary(locale);
const categoryTitle = 'Ontario Salary Calculators';
const categoryIntro =
  'Calculate your Ontario take-home pay after federal and Ontario tax, CPP/CPP2 and EI, and see what common Ontario salaries leave after tax in 2026.';
const meta = buildPageMetadata(
  `${categoryTitle} — ${t.meta.siteTitleSuffix}`,
  categoryIntro,
  '/en-ca/salary/',
);
const calculators = getActivePagesForLocale(locale).filter(
  (p) => p.category === 'salary' && p.pageType === 'calculator',
);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <Breadcrumbs
    locale={locale}
    trail={[{ label: t.navigation.salary, href: buildLocalePath(locale, 'salary') }]}
  />
  <section class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">{categoryTitle}</h1>
    <p class="mt-3 text-slate-600">{categoryIntro}</p>
    <ul class="mt-8 space-y-3">
      {calculators.map((page) => (
        <li class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm hover:border-accent transition-colors">
          <a
            href={buildLocalePath(locale, page.slug)}
            class="font-semibold text-accent hover:underline"
          >
            {page.primaryKeyword}
          </a>
          <p class="mt-1 text-sm text-slate-500">{page.secondaryKeywords.join(' · ')}</p>
        </li>
      ))}
    </ul>
  </section>
  <CategoryResource locale="en-CA" category="salary" />
</BaseLayout>

---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import CalculatorResource from '../../../../components/content/CalculatorResource.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import CaOntarioSalaryCalculator from '../../../../components/islands/CaOntarioSalaryCalculator';
import { calculateCaOntarioSalary } from '../../../../calculators/salary/engines/ca/canadaOntarioSalary';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'en-CA' as const;
const t = getDictionary(locale);
const grossAnnual = 75000;
const result = calculateCaOntarioSalary(grossAnnual);
const format = (value: number) =>
  new Intl.NumberFormat('en-CA', { style: 'currency', currency: 'CAD' }).format(value);
const pageTitle = '$75,000 Salary After Tax in Ontario (2026)';
const meta = buildPageMetadata(
  `${pageTitle} — ${t.meta.siteTitleSuffix}`,
  `A $75,000 Ontario salary leaves an estimated ${format(result.netAnnual)} a year (${format(result.netMonthly)} a month) after federal and Ontario tax, CPP/CPP2 and EI in 2026. See the full breakdown.`,
  '/en-ca/salary/ontario-salary-75000-after-tax/',
);
const faqs = [
  {
    question: 'What is the take-home pay on a $75,000 salary in Ontario?',
    answer: `On a $75,000 gross salary in Ontario in 2026, the estimated take-home pay is ${format(result.netAnnual)} a year, or ${format(result.netMonthly)} a month, after federal and Ontario tax, CPP/CPP2 and EI.`,
  },
  {
    question: 'How much tax is paid on a $75,000 Ontario salary?',
    answer: `Total deductions are estimated at ${format(result.totalDeductions)}, including ${format(result.federalTax)} in federal tax and ${format(result.ontarioTax)} in Ontario tax, plus ${format(result.cpp)} in CPP, ${format(result.cpp2)} in CPP2 and ${format(result.ei)} in EI.`,
  },
  {
    question: 'Is this Ontario estimate exact?',
    answer:
      'No. It is an estimate for a single employee with no other income, credits or deductions beyond the basic amounts in the 2026 engine, and it excludes employer costs and benefits. Your actual pay can differ.',
  },
];
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: t.navigation.salary, href: buildLocalePath(locale, 'salary') },
      { label: '$75,000 After Tax in Ontario', href: buildLocalePath(locale, 'salary/ontario-salary-75000-after-tax') },
    ]}
  />
  <section class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">{pageTitle}</h1>
    <p class="mt-3 text-slate-600">
      On a $75,000 gross salary in Ontario in 2026, the estimated take-home pay is
      {format(result.netAnnual)} a year — {format(result.netMonthly)} a month — after federal
      and Ontario tax, CPP/CPP2 and EI.
    </p>
    <h2 class="mt-8 text-xl font-semibold text-slate-900">$75,000 Ontario salary breakdown</h2>
    <table class="mt-4 w-full border-collapse text-left text-slate-700">
      <tbody>
        <tr class="border-b border-slate-200"><th class="py-2 pr-4 font-medium">Gross salary</th><td class="py-2">{format(result.grossAnnual)}</td></tr>
        <tr class="border-b border-slate-200"><th class="py-2 pr-4 font-medium">Federal tax</th><td class="py-2">{format(result.federalTax)}</td></tr>
        <tr class="border-b border-slate-200"><th class="py-2 pr-4 font-medium">Ontario tax</th><td class="py-2">{format(result.ontarioTax)}</td></tr>
        <tr class="border-b border-slate-200"><th class="py-2 pr-4 font-medium">CPP</th><td class="py-2">{format(result.cpp)}</td></tr>
        <tr class="border-b border-slate-200"><th class="py-2 pr-4 font-medium">CPP2</th><td class="py-2">{format(result.cpp2)}</td></tr>
        <tr class="border-b border-slate-200"><th class="py-2 pr-4 font-medium">EI</th><td class="py-2">{format(result.ei)}</td></tr>
        <tr class="border-b border-slate-200"><th class="py-2 pr-4 font-medium">Total deductions</th><td class="py-2">{format(result.totalDeductions)}</td></tr>
        <tr class="border-b border-slate-200"><th class="py-2 pr-4 font-medium">Take-home pay (annual)</th><td class="py-2">{format(result.netAnnual)}</td></tr>
        <tr><th class="py-2 pr-4 font-medium">Take-home pay (monthly)</th><td class="py-2">{format(result.netMonthly)}</td></tr>
      </tbody>
    </table>
    <p class="mt-4 text-sm text-slate-500">
      Ontario tax shown includes the Ontario surtax ({format(result.ontarioSurtax)} on this salary).
      The estimate assumes a single employee with no other income, credits or deductions beyond the
      basic amounts in the 2026 engine.
    </p>
    <h2 class="mt-10 text-xl font-semibold text-slate-900">Try a different Ontario salary</h2>
    <CaOntarioSalaryCalculator client:load />
    <CalculatorFAQ heading="Frequently asked questions about Ontario take-home pay" items={faqs} />
  </section>
  <CalculatorResource locale="en-CA" category="salary" />
  <JsonLd entries={[buildFaqJsonLd(faqs)]} />
</BaseLayout>

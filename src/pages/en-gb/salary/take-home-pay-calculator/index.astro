---
import CalculatorResource from '../../../../components/content/CalculatorResource.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import UkPaycheckCalculator from '../../../../components/islands/UkPaycheckCalculator';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'en-GB' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  t.meta.paycheckTitle,
  t.meta.paycheckDescription,
  '/en-gb/salary/take-home-pay-calculator/',
);

const faqItems = [
  {
    question: 'How is UK income tax calculated?',
    answer:
      'UK income tax applies a Personal Allowance of £12,570 (frozen until 2028), then 20% basic rate up to £50,270, 40% higher rate up to £125,140, and 45% additional rate above that. The allowance tapers by £1 for every £2 above £100,000.',
  },
  {
    question: 'What is National Insurance (NI)?',
    answer:
      'Class 1 employee NI is charged at 8% on earnings between £12,570 and £50,270 per year, and 2% on earnings above £50,270. Your employer also pays NI separately.',
  },
  {
    question: 'Does this calculator include Scottish income tax?',
    answer:
      'Not yet. Scottish taxpayers pay different income tax rates set by the Scottish Parliament. This calculator uses the standard England, Wales, and Northern Ireland rates.',
  },
  {
    question: 'What tax year does this cover?',
    answer:
      'This calculator uses the 2025–26 UK tax year rates (6 April 2025 to 5 April 2026), sourced from HMRC.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  equivalentPageGroup="paycheck-calculator"
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: t.navigation.salary, href: buildLocalePath(locale, 'salary') },
      {
        label: t.salary.takeHomePay.title,
        href: buildLocalePath(locale, 'salary/take-home-pay-calculator'),
      },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">{t.salary.takeHomePay.h1}</h1>
    <p class="mt-3 max-w-2xl text-slate-600">{t.salary.takeHomePay.intro}</p>

    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <UkPaycheckCalculator client:load locale={locale} />
    </div>

    <div class="mt-8">
      <InContentAd slotId="gb-takehome-1" />
    </div>

    <div class="mt-10 prose prose-slate max-w-none">
      <h2>UK Income Tax Rates 2025–26</h2>
      <table>
        <thead>
          <tr>
            <th>Income band</th>
            <th>Rate</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Up to £12,570 (Personal Allowance)</td>
            <td>0%</td>
          </tr>
          <tr>
            <td>£12,571 – £50,270</td>
            <td>20% (basic)</td>
          </tr>
          <tr>
            <td>£50,271 – £125,140</td>
            <td>40% (higher)</td>
          </tr>
          <tr>
            <td>Over £125,140</td>
            <td>45% (additional)</td>
          </tr>
        </tbody>
      </table>
      <h3>National Insurance 2025–26 (Class 1 Employee)</h3>
      <table>
        <thead>
          <tr>
            <th>Earnings band</th>
            <th>Rate</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Up to £12,570</td>
            <td>0%</td>
          </tr>
          <tr>
            <td>£12,571 – £50,270</td>
            <td>8%</td>
          </tr>
          <tr>
            <td>Over £50,270</td>
            <td>2%</td>
          </tr>
        </tbody>
      </table>
      <p class="text-sm">
        Source: HMRC — Income Tax rates and National Insurance thresholds 2025–26.
      </p>
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.verifyProfessional} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="Frequently asked questions about UK take-home pay" items={faqItems} />
  </article>
  <CalculatorResource locale="en-GB" category="salary" />
</BaseLayout>

---
import CalculatorResource from '../../../../components/content/CalculatorResource.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import SalaryToHourlyCalculator from '../../../../components/islands/SalaryToHourlyCalculator';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';
import { enUS } from '../../../../i18n/en-US';

const locale = 'en-GB' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'Salary to Hourly Rate Calculator UK — PayRenTax',
  t.salary.salaryToHourly.intro,
  '/en-gb/salary/salary-to-hourly/',
);

const faqItems = [
  {
    question: 'How do I convert my annual salary to an hourly rate in the UK?',
    answer:
      'Divide your annual salary by the number of working hours per year. For a standard 40-hour week and 52 weeks: hourly rate = annual salary ÷ 2,080. For 37.5 hours/week: divide by 1,950.',
  },
  {
    question: 'What is the UK minimum wage hourly rate?',
    answer:
      'The UK National Living Wage (workers aged 21+) is £11.44/hour from April 2024. The rate increases annually in April.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  equivalentPageGroup="salary-to-hourly"
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: t.navigation.salary, href: buildLocalePath(locale, 'salary') },
      {
        label: t.salary.salaryToHourly.title,
        href: buildLocalePath(locale, 'salary/salary-to-hourly'),
      },
    ]}
  />
  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">{t.salary.salaryToHourly.h1}</h1>
    <p class="mt-3 max-w-2xl text-slate-600">{t.salary.salaryToHourly.intro}</p>
    <p class="mt-2 text-sm text-slate-400">
      Enter your salary in GBP (£). The calculator works for any currency — just enter the number.
    </p>
    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <SalaryToHourlyCalculator client:load t={enUS} locale="en-GB" />
    </div>

    <div class="mt-10 prose prose-slate max-w-none">
      <h2>How to convert annual salary to hourly rate (UK)</h2>
      <table>
        <thead>
          <tr>
            <th>Working hours/week</th>
            <th>Hours/year</th>
            <th>Formula</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>37.5 hrs (standard UK)</td>
            <td>1,950</td>
            <td>salary ÷ 1,950</td>
          </tr>
          <tr>
            <td>40 hrs</td>
            <td>2,080</td>
            <td>salary ÷ 2,080</td>
          </tr>
          <tr>
            <td>35 hrs</td>
            <td>1,820</td>
            <td>salary ÷ 1,820</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="mt-6 text-xs text-slate-500">{t.disclaimers.general}</p>
    <CalculatorFAQ heading="UK Salary to Hourly FAQs" items={faqItems} />
  </article>
  <CalculatorResource locale="en-GB" category="salary" />
</BaseLayout>

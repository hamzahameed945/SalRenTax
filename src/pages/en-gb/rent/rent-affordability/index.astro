---
import CalculatorResource from '../../../../components/content/CalculatorResource.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import RentAffordabilityCalculator from '../../../../components/islands/RentAffordabilityCalculator';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'en-GB' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'Rent Affordability Calculator UK — PayRenTax',
  t.rent.rentAffordability.intro,
  '/en-gb/rent/rent-affordability/',
);

const faqItems = [
  {
    question: 'How much of my salary should I spend on rent in the UK?',
    answer:
      'The standard guideline is to spend no more than 30% of your gross income on rent. However, in high-cost areas like London, many renters spend 40–50% of their income on housing. The 30% figure is a useful starting point rather than a hard rule.',
  },
  {
    question: 'What are average UK rents in 2026?',
    answer:
      'Average UK private rental costs vary hugely by region. London averages over £2,000/month for a one-bedroom; outside London, average rents range from around £700 in northern England to £1,200+ in the South East. The ONS Rental Market Survey publishes the latest figures.',
  },
  {
    question: 'Can I use housing benefit or Local Housing Allowance (LHA)?',
    answer:
      'If you are on Universal Credit or Housing Benefit, you may receive help towards your rent up to the Local Housing Allowance rate for your area. LHA rates are set by reference to the 30th percentile of local market rents. Check Gov.uk for your area\'s LHA rate.',
  },
  {
    question: 'What is a rent-to-income ratio?',
    answer:
      'The rent-to-income ratio is the percentage of your income spent on rent. Many UK landlords and letting agents require the ratio to be below 33% (gross rent no more than one-third of gross income) to qualify for a tenancy without a guarantor.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  equivalentPageGroup="rent-affordability"
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: t.navigation.rent, href: buildLocalePath(locale, 'rent') },
      { label: t.rent.rentAffordability.title, href: buildLocalePath(locale, 'rent/rent-affordability') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">{t.rent.rentAffordability.h1}</h1>
    <p class="mt-3 max-w-2xl text-slate-600">{t.rent.rentAffordability.intro}</p>

    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <RentAffordabilityCalculator client:load locale={locale} />
    </div>

    <div class="mt-8">
      <InContentAd slotId="gb-rent-affordability-1" />
    </div>

    <div class="mt-10 prose prose-slate max-w-none">
      <h2>UK Rent Affordability — 30% Rule</h2>
      <table>
        <thead>
          <tr>
            <th>Gross monthly income</th>
            <th>Max rent (30%)</th>
            <th>Max rent (35%)</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>£2,000</td><td>£600</td><td>£700</td></tr>
          <tr><td>£3,000</td><td>£900</td><td>£1,050</td></tr>
          <tr><td>£4,000</td><td>£1,200</td><td>£1,400</td></tr>
          <tr><td>£5,000</td><td>£1,500</td><td>£1,750</td></tr>
          <tr><td>£6,000</td><td>£1,800</td><td>£2,100</td></tr>
        </tbody>
      </table>
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.verifyProfessional} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="Frequently asked questions" items={faqItems} />
  </article>
  <CalculatorResource locale="en-GB" category="rent" />
</BaseLayout>

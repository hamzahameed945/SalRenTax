---
import CalculatorResource from '../../../../components/content/CalculatorResource.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import RentAffordabilityCalculator from '../../../../components/islands/RentAffordabilityCalculator';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'nl-NL' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'Hoeveel Huur Kan Ik Betalen? Calculator — PayRenTax',
  t.rent.rentAffordability.intro,
  '/nl-nl/rent/huur-berekenen/',
);

const faqItems = [
  {
    question: 'Hoeveel procent van mijn inkomen mag ik aan huur besteden?',
    answer:
      'De internationale 30%-vuistregel stelt dat u niet meer dan 30% van uw bruto inkomen aan huur zou moeten besteden. In Nederland met hoge huurprijzen in de Randstad kan dit in de praktijk moeilijk zijn. Sommige adviseurs hanteren 35–40% als bovengrens voor dure steden.',
  },
  {
    question: 'Wat is de huurtoeslaggrens in Nederland 2026?',
    answer:
      'Huurtoeslag kunt u aanvragen als uw huur onder de liberalisatiegrens valt (circa €880 per maand in 2026) en uw inkomen onder de inkomensgrens ligt. De Belastingdienst berekent de exacte toeslag op basis van uw situatie.',
  },
  {
    question: 'Hoe verschilt sociale huur van vrije sector huur?',
    answer:
      'Sociale huurwoningen hebben een maximale huurprijs op basis van woningwaarderingspunten en zijn beschikbaar voor lagere inkomens. Vrije sector (geliberaliseerde) huurwoningen hebben geen maximale huurprijs en zijn vrij te verhuren.',
  },
  {
    question: 'Wat zijn gemiddelde huurprijzen in Nederland in 2026?',
    answer:
      'Gemiddelde huurprijzen in de vrije sector variëren sterk per regio: Amsterdam en Utrecht liggen boven de €1.500/maand voor een appartement, terwijl regio\'s buiten de Randstad significant goedkoper zijn. Sociale huurwoningen zijn goedkoper maar hebben lange wachttijden.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  equivalentPageGroup="rent-affordability"
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: t.navigation.rent, href: buildLocalePath(locale, 'rent') },
      { label: t.rent.rentAffordability.title, href: buildLocalePath(locale, 'rent/huur-berekenen') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">{t.rent.rentAffordability.h1}</h1>
    <p class="mt-3 max-w-2xl text-slate-600">{t.rent.rentAffordability.intro}</p>

    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <RentAffordabilityCalculator client:load locale={locale} />
    </div>

    <div class="mt-8">
      <InContentAd slotId="nl-rent-affordability-1" />
    </div>

    <div class="mt-10 prose prose-slate max-w-none">
      <h2>Huurbudget op basis van inkomen — 30% richtlijn</h2>
      <table>
        <thead>
          <tr>
            <th>Bruto maandinkomen</th>
            <th>Max. huur (30%)</th>
            <th>Max. huur (35%)</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>€2.000</td><td>€600</td><td>€700</td></tr>
          <tr><td>€3.000</td><td>€900</td><td>€1.050</td></tr>
          <tr><td>€4.000</td><td>€1.200</td><td>€1.400</td></tr>
          <tr><td>€5.000</td><td>€1.500</td><td>€1.750</td></tr>
          <tr><td>€6.000</td><td>€1.800</td><td>€2.100</td></tr>
        </tbody>
      </table>
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.verifyProfessional}
    </p>

    <CalculatorFAQ heading="Veelgestelde vragen over huurbudget" items={faqItems} />
  </article>
  <CalculatorResource locale="nl-NL" category="rent" />
</BaseLayout>

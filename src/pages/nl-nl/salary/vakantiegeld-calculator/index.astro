---
import CalculatorResource from '../../../../components/content/CalculatorResource.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import NlVakantiegeldCalculator from '../../../../components/islands/NlVakantiegeldCalculator';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'nl-NL' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'Vakantiegeld berekenen 2026 – vakantiebijslag calculator',
  'Vakantiegeld berekenen 2026: bereken 8% van uw bruto jaarsalaris, pro-rata bij parttime en afwijkende CAO-percentages. Gratis en direct uw vakantiegeld berekenen.',
  '/nl-nl/salary/vakantiegeld-calculator/',
);

const faqItems = [
  {
    question: 'Hoeveel vakantiegeld krijg ik?',
    answer:
      'U krijgt minimaal 8% van uw bruto jaarsalaris als vakantiegeld. Bij een jaarsalaris van €45.000 is dat €3.600. Het wordt doorgaans eenmaal per jaar uitbetaald in mei of juni. Veel CAO\'s bieden een hoger percentage — controleer uw arbeidsovereenkomst.',
  },
  {
    question: 'Hoe wordt het vakantiegeld berekend?',
    answer:
      'Zo berekent u het stap voor stap: (1) neem uw bruto jaarsalaris, inclusief overwerk en toeslagen waar deze volgens uw CAO meetellen; (2) vermenigvuldig dit met 8% (0,08); (3) was u niet het hele opbouwjaar in dienst, deel het bedrag dan pro-rata. Voorbeeld: €45.000 × 8% = €3.600; bij 6 maanden in dienst ontvangt u €1.800.',
  },
  {
    question: 'Krijg ik vakantiegeld bij een parttime contract?',
    answer:
      'Ja. Ook met een parttime contract heeft u recht op vakantiegeld. Het wordt pro-rata berekend: u bouwt 8% op over het loon dat u daadwerkelijk heeft verdiend, naar verhouding van het aantal uren dat u heeft gewerkt.',
  },
  {
    question: 'Is vakantiegeld bruto of netto?',
    answer:
      'Vakantiegeld wordt bruto berekend en uitbetaald. Bij de uitbetaling houdt uw werkgever er loonbelasting op in (tegen het bijzonder tarief), dus het bedrag dat u netto op uw rekening ontvangt is lager dan het brutobedrag.',
  },
  {
    question: 'Wat als ik ontslag neem of ontslagen word?',
    answer:
      'Bij uitdiensttreding heeft u recht op vakantiegeld over de nog niet uitbetaalde opbouwperiode. De werkgever is verplicht dit uit te betalen bij de eindafrekening.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  equivalentPageGroup="nl-vakantiegeld-calculator"
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: t.navigation.salary, href: buildLocalePath(locale, 'salary') },
      { label: t.salary.vakantiegeld.title, href: buildLocalePath(locale, 'salary/vakantiegeld-calculator') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">Vakantiegeld berekenen 2026</h1>
    <p class="mt-3 max-w-2xl text-slate-600">{t.salary.vakantiegeld.intro}</p>

    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <NlVakantiegeldCalculator client:load locale={locale} />
    </div>

    <div class="mt-8">
      <InContentAd slotId="nl-vakantiegeld-1" />
    </div>

    <div class="mt-10 prose prose-slate max-w-none">
      <h2>Hoe wordt vakantiegeld berekend?</h2>
      <p>
        De wettelijke minimumvakantiebijslag bedraagt <strong>8% van het bruto loon</strong> dat in het opbouwjaar
        is verdiend. Het opbouwjaar loopt doorgaans van 1 juni tot en met 31 mei.
      </p>
      <p>
        Rekenvoorbeeld: bruto jaarsalaris €45.000 × 8% = <strong>€3.600 vakantiegeld</strong>.
        Als u slechts 6 van de 12 maanden in dienst was, ontvangt u de helft: €1.800.
      </p>
      <h2>Hogere CAO-percentages</h2>
      <p>
        Veel sectoren kennen CAO-percentages van 8,33% (zodat het vakantiegeld precies één maandloon bedraagt)
        of zelfs hoger. Controleer uw CAO of arbeidsovereenkomst.
      </p>
      <p class="text-sm">
        Bron: <a href="https://www.rijksoverheid.nl/onderwerpen/vakantiedagen-en-vakantiegeld/vakantiegeld" target="_blank" rel="noopener noreferrer">Rijksoverheid — Vakantiegeld</a>
      </p>
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.verifyProfessional} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="Veelgestelde vragen over vakantiegeld" items={faqItems} />
  </article>
  <CalculatorResource locale="nl-NL" category="salary" />
</BaseLayout>

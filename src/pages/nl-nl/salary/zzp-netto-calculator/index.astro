---
import CalculatorResource from '../../../../components/content/CalculatorResource.astro';
import RelatedCalculators from '../../../../components/content/RelatedCalculators.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import NlZZPCalculator from '../../../../components/islands/NlZZPCalculator';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'nl-NL' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  t.salary.zzpNetto.title,
  t.salary.zzpNetto.metaDescription,
  '/nl-nl/salary/zzp-netto-calculator/',
);

const faqItems = [
  {
    question: 'Hoe wordt het netto inkomen van een ZZP\'er berekend?',
    answer:
      'ZZP\'ers berekenen eerst de winst (omzet minus zakelijke kosten). Daarna worden ondernemersaftrekken toegepast: de zelfstandigenaftrek (€1.200 in 2026) en eventueel de startersaftrek. Op de resterende winst na de MKB-winstvrijstelling (12,70%) wordt box 1 belasting geheven, verminderd met de arbeidskorting en algemene heffingskorting. Daar komt de inkomensafhankelijke Zvw-bijdrage (4,85% over max. €79.409) nog bij, die via een aanslag wordt betaald.',
  },
  {
    question: 'Wat is de zelfstandigenaftrek 2026?',
    answer:
      'De zelfstandigenaftrek is €1.200 in 2026. Het is een aftrekpost voor ondernemers die voldoen aan het urencriterium (minimaal 1.225 uur per jaar aan de onderneming besteden, dus ook indirecte uren zoals administratie). De aftrek wordt elk jaar verder verlaagd en is in 2027 nog €900. Tip: overweeg de vergelijking met loondienst op onze ZZP-of-loondienst-pagina.',
  },
  {
    question: 'Wat is de MKB-winstvrijstelling?',
    answer:
      'De MKB-winstvrijstelling bedraagt 12,70% van de winst na ondernemersaftrek. Dit deel van de winst is vrijgesteld van belasting. De vrijstelling geldt voor alle IB-ondernemers, ongeacht het aantal gewerkte uren.',
  },
  {
    question: 'Moet ik als ZZP\'er BTW betalen?',
    answer:
      'Ja, de meeste ZZP\'ers berekenen 21% BTW aan hun opdrachtgevers. U draagt dit af aan de Belastingdienst, maar kunt de BTW die u zelf betaalt over zakelijke kosten als voorbelasting verrekenen. De BTW staat los van de inkomstenbelasting en verlaagt uw netto inkomen niet direct.',
  },
  {
    question: 'Hoe zit het met pensioen als ZZP\'er?',
    answer:
      'ZZP\'ers bouwen geen pensioen op via een werkgever. Het is sterk aan te raden zelf te sparen via een lijfrente, banksparen, of de derde pijler. Een vuistregel is om 10-15% van de brutowinst opzij te zetten voor pensioen.',
  },
  {
    question: 'Wat is een realistisch uurtarief voor ZZP in Nederland?',
    answer:
      'Het gemiddelde ZZP-tarief in Nederland ligt tussen €60 en €110 per uur, afhankelijk van sector en ervaring. Houd er rekening mee dat u als ZZP\'er doorgaans 50–70% van uw beschikbare uren kunt declareren; de rest gaat naar acquisitie, administratie en scholing.',
  },
  {
    question: 'Hoeveel belasting betaalt een zzp\'er?',
    answer:
      'Rekenvoorbeeld 2026 bij €60.000 winst uit onderneming (urencriterium gehaald): trek eerst de zelfstandigenaftrek van €1.200 af → €58.800. Dan de MKB-winstvrijstelling van 12,70% (€7.468) → belastbare winst circa €51.332. Daarover betaalt u box 1: 35,75% over de eerste €38.883 en 37,56% over het deel daarboven → circa €18.577, verminderd met de algemene heffingskorting (max. €3.115, hier deels afgebouwd) en arbeidskorting (max. €5.685) → circa €12.100 inkomstenbelasting. Daarbovenop komt de inkomensafhankelijke Zvw-bijdrage: 4,85% over het bijdrage-inkomen tot max. €79.409, in dit voorbeeld circa €2.490 via een aanslag. Totaal circa €14.600, dus effectief ongeveer 24% van de winst.',
  },
  {
    question: 'Waarom is de Zvw-bijdrage voor zzp\'ers lager dan voor werknemers?',
    answer:
      'Ondernemers betalen in 2026 de verlaagde inkomensafhankelijke bijdrage Zvw van 4,85% over maximaal €79.409 bijdrage-inkomen (maximaal circa €3.851 per jaar), terwijl werkgevers voor werknemers de werkgeversheffing van 6,10% betalen. Het verschil komt uit de systematiek: de werkgeversheffing is geen belasting voor de werknemer, terwijl u als zzp\'er de bijdrage zelf via een aanslag van de Belastingdienst betaalt, bovenop uw inkomstenbelasting. Ook de gewone zorgpremie en het eigen risico betaalt u zelf.',
  },
  {
    question: 'Wat verandert er in 2026 voor de belasting van zzp\'ers?',
    answer:
      'De grootste wijziging is de zelfstandigenaftrek: die daalt van €2.470 (2025) naar €1.200 in 2026 en wordt verder afgebouwd naar €900 in 2027. De MKB-winstvrijstelling blijft 12,70%. De Zvw-bijdrage daalt van 5,26% naar 4,85% (max. €79.409). De box 1-tarieven zijn 35,75%, 37,56% en 49,50%. Netto effect: ondernemers met een middelgrote winst houden in 2026 iets minder over dan in 2025 door de lagere zelfstandigenaftrek.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  equivalentPageGroup="nl-zzp-netto-calculator"
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: t.navigation.salary, href: buildLocalePath(locale, 'salary') },
      { label: t.salary.zzpNetto.title, href: buildLocalePath(locale, 'salary/zzp-netto-calculator') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">{t.salary.zzpNetto.h1}</h1>
    <p class="mt-3 max-w-2xl text-slate-600">{t.salary.zzpNetto.intro}</p>

    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <NlZZPCalculator client:load locale={locale} />
    </div>

    <div class="mt-8">
      <InContentAd slotId="nl-zzp-1" />
    </div>

    <div class="mt-10 prose prose-slate max-w-none">
      <h2>Van omzet naar netto: de ZZP-berekening stap voor stap</h2>
      <ol>
        <li><strong>Omzet</strong> (excl. BTW) minus zakelijke kosten = <strong>brutowinst</strong></li>
        <li>Brutowinst minus <strong>zelfstandigenaftrek</strong> (€1.200) en eventueel startersaftrek (€2.123)</li>
        <li>Resterende winst minus <strong>MKB-winstvrijstelling</strong> (12,70%) = <strong>belastbare winst</strong></li>
        <li>Box 1-tarieven (35,75% / 37,56% / 49,50%) toegepast op de belastbare winst</li>
        <li>Belasting verminderd met arbeidskorting en algemene heffingskorting</li>
        <li><strong>Zvw-bijdrage</strong> (4,85% over max. €79.409) betaalt u als zzp'er zelf via een aanslag</li>
      </ol>

      <h2>Ondernemersaftrekken 2026</h2>
      <table>
        <thead>
          <tr><th>Aftrek</th><th>Bedrag 2026</th><th>Voorwaarde</th></tr>
        </thead>
        <tbody>
          <tr><td>Zelfstandigenaftrek</td><td>€1.200</td><td>Urencriterium ≥ 1.225 uur/jaar</td></tr>
          <tr><td>Startersaftrek</td><td>€2.123</td><td>Eerste 3 jaar als ondernemer</td></tr>
          <tr><td>MKB-winstvrijstelling</td><td>12,70% van winst</td><td>Geen urencriterium</td></tr>
          <tr><td>Zvw-bijdrage zzp</td><td>4,85% (max. €79.409)</td><td>Via aanslag, niet via loon</td></tr>
        </tbody>
      </table>
      <p class="text-sm">
        Bron: <a href="https://www.belastingdienst.nl/wps/wcm/connect/bldcontentnl/belastingdienst/zakelijk/winst/zelfstandigenaftrek/" target="_blank" rel="noopener noreferrer">Belastingdienst — Zelfstandigenaftrek 2026</a>
      </p>
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.verifyProfessional} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="Veelgestelde vragen over ZZP netto inkomen" items={faqItems} />

    <RelatedCalculators
      heading="Gerelateerde calculators"
      links={[
      { label: "Vakantiegeld berekenen", href: "/nl-nl/salary/vakantiegeld-calculator/" },
      { label: "Bruto netto salaris berekenen", href: "/nl-nl/salary/bruto-netto-calculator/" },
      { label: "ZZP of loondienst: wat verdient beter?", href: "/nl-nl/salary/zzp-loondienst-vergelijking/" },
      ]}
    />
  </article>
  <CalculatorResource locale="nl-NL" category="salary" />
</BaseLayout>

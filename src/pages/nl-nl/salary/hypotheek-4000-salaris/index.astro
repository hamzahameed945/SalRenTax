---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import CalculatorResource from '../../../../components/content/CalculatorResource.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import RelatedCalculators from '../../../../components/content/RelatedCalculators.astro';
import NlHypotheekCalculator from '../../../../components/islands/NlHypotheekCalculator';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';
import { nlHypotheekEngine } from '../../../../calculators/salary/engines/nl/nlHypotheek';

const locale = 'nl-NL' as const;
const t = getDictionary(locale);

// Scenario: €4.000 bruto per maand, 4% rente, 30 jaar, geen partner, geen schulden.
const r = nlHypotheekEngine.calculate({ grossMonthly: 4000 }, {} as never, 2026);
const eur = (v: number) => Math.round(v).toLocaleString('nl-NL');
const hyp = eur(r.maxHypotheek);
const maandlast = eur(r.maxBrutoMaandlast);
const netto = eur(r.nettoMaandlastIndicatie);
const toets = eur(r.toetsinkomenAnnual);
const pct = r.financieringslastPercentage.toLocaleString('nl-NL', { minimumFractionDigits: 2 });

const meta = buildPageMetadata(
  `Hoeveel hypotheek met €4.000 salaris? €${hyp} in 2026`,
  `Hoeveel hypotheek kan ik krijgen met €4.000 bruto per maand? In 2026 leent u circa €${hyp} (toetsinkomen €${toets}, bruto maandlast €${maandlast}). Bereken uw maximale hypotheek met de Nibud-normen.`,
  '/nl-nl/salary/hypotheek-4000-salaris/',
);

const faqItems = [
  {
    question: 'Hoeveel hypotheek kan ik krijgen met €4.000 bruto per maand?',
    answer:
      `Met €4.000 bruto per maand is uw toetsinkomen €${toets} per jaar (inclusief 8% vakantiegeld). Het Nibud-financieringslastpercentage 2026 voor dit inkomen is ${pct}%: maximaal €${maandlast} bruto per maand aan hypotheeklasten. Bij 4% rente en 30 jaar looptijd leent u daarmee circa €${hyp}.`,
  },
  {
    question: 'Wat zijn de maandlasten bij een hypotheek van €' + hyp + '?',
    answer:
      `U betaalt €${maandlast} bruto per maand (annuïteit; eerste maand €${eur(r.eersteMaandRente)} rente en €${eur(r.eersteMaandAflossing)} aflossing). Na hypotheekrenteaftrek tegen het marginale box-1-tarief van 37,56% houdt u een indicatieve netto maandlast van circa €${netto} over. Naarmate u aflost, daalt het rentedeel en stijgt de netto last iets.`,
  },
  {
    question: 'Hoeveel hypotheek krijg ik met €4.000 salaris en een studieschuld?',
    answer:
      'Een studieschuld verlaagt uw leenruimte flink: de bank rekent met 0,45% van het oorspronkelijke leenbedrag als maandlast. Bij een schuld van €30.000 (€135/maand) daalt uw maximale hypotheek van circa €' + hyp + ' naar ongeveer €168.000. Los af waar het kan vóór uw hypotheekaanvraag, of vul de werkelijke maandlast in de calculator in.',
  },
  {
    question: 'Valt een hypotheek van €' + hyp + ' onder NHG?',
    answer:
      'Ja, ruim. De NHG-grens 2026 is €470.000, dus een hypotheek rond €' + hyp + ' komt in aanmerking voor Nationale Hypotheek Garantie: eenmalig 0,4% premie, doorgaans een lagere rente en een vangnet als u de lasten onverhoopt niet meer kunt dragen.',
  },
  {
    question: 'Leen ik meer als mijn partner ook werkt?',
    answer:
      'Ja. Sinds 2023 telt het tweede inkomen volledig mee in het toetsinkomen. Met een partnerinkomen van bijvoorbeeld €2.500 bruto per maand erbij stijgt het toetsinkomen naar circa €84.240 en de maximale hypotheek naar ongeveer €360.000. Probeer het zelf in de calculator hierboven.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  equivalentPageGroup="nl-hypotheek-4000-salaris"
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: t.navigation.salary, href: buildLocalePath(locale, 'salary') },
      { label: 'Hypotheek berekenen', href: buildLocalePath(locale, 'salary/hypotheek-berekenen') },
      { label: 'Hypotheek met €4.000 salaris', href: buildLocalePath(locale, 'salary/hypotheek-4000-salaris') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">Hypotheek met €4.000 bruto salaris 2026</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      Met een bruto maandsalaris van <strong>€4.000</strong> (toetsinkomen <strong>€{toets}</strong> per jaar,
      inclusief vakantiegeld) kunt u in 2026 circa <strong>€{hyp} hypotheek</strong> krijgen.
      Het Nibud-financieringslastpercentage van <strong>{pct}%</strong> geeft een maximale
      <strong> bruto maandlast van €{maandlast}</strong>.
    </p>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold">Uw maximale hypotheek in 2026</h2>
      <table class="mt-4 w-full text-sm">
        <tbody>
          <tr><td>Toetsinkomen (incl. 8% vakantiegeld)</td><td>€{toets}</td></tr>
          <tr><td>Nibud financieringslastpercentage</td><td>{pct}%</td></tr>
          <tr><td>Maximale bruto maandlast</td><td>€{maandlast}</td></tr>
          <tr><td>Waarvan rente (eerste maand)</td><td>€{eur(r.eersteMaandRente)}</td></tr>
          <tr><td>Waarvan aflossing (eerste maand)</td><td>€{eur(r.eersteMaandAflossing)}</td></tr>
          <tr class="font-semibold"><td>Maximale hypotheek (4%, 30 jaar)</td><td>€{hyp}</td></tr>
          <tr><td>Indicatieve netto maandlast (na renteaftrek)</td><td>€{netto}</td></tr>
        </tbody>
      </table>
      <p class="mt-4 text-xs text-slate-500">
        Berekend met de Nibud-financieringslastpercentages 2026 en een indicatieve rente van 4% (10 jaar vast),
        annuïtair, 30 jaar. De netto-indicatie trekt de rente af tegen het marginale box-1-tarief van 37,56%.
        Geldverstrekkers toetsen met hun eigen rentetabel; dit is een indicatie, geen advies.
      </p>
    </div>

    <div class="mt-8">
      <InContentAd slotId="nl-hypotheek-4000" />
    </div>

    <div class="mt-10">
      <h2 class="text-xl font-semibold">Pas het scenario aan</h2>
      <p class="mt-2 text-sm text-slate-600">
        Voeg een partnerinkomen of studieschuld toe, of wijzig de rente om te zien wat het met uw maximale hypotheek doet.
      </p>
      <div class="mt-4 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <NlHypotheekCalculator client:load locale={locale} initialGrossMonthly={4000} />
      </div>
    </div>

    <nav class="mt-10" aria-label="Hypotheek per salaris">
      <h2 class="text-xl font-semibold">Hypotheek per salaris</h2>
      <ul class="mt-4 grid gap-2 sm:grid-cols-3">
        <li><a class="text-blue-700 underline hover:text-blue-900" href="/nl-nl/salary/hypotheek-berekenen/">Hypotheek berekenen (alle salarissen)</a></li>
        <li><a class="text-blue-700 underline hover:text-blue-900" href="/nl-nl/salary/hypotheek-3000-salaris/">Hypotheek met €3.000 salaris</a></li>
        <li><a class="text-blue-700 underline hover:text-blue-900" href="/nl-nl/salary/hypotheek-5000-salaris/">Hypotheek met €5.000 salaris</a></li>
      </ul>
    </nav>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.dataSource} Indicatie voor 2026 op basis van de
      Nibud-financieringslastpercentages; geen hypotheekadvies.
    </p>

    <CalculatorFAQ heading="Hypotheek met €4.000 salaris: vragen" items={faqItems} />

    <RelatedCalculators
      heading="Gerelateerde calculators"
      links={[
        { label: "Bruto netto calculator 2026", href: "/nl-nl/salary/bruto-netto-calculator/" },
        { label: "ZZP of loondienst vergelijken", href: "/nl-nl/salary/zzp-loondienst-vergelijking/" },
        { label: "Vakantiegeld berekenen", href: "/nl-nl/salary/vakantiegeld-calculator/" },
      ]}
    />
  </article>
  <CalculatorResource locale="nl-NL" category="salary" />
</BaseLayout>

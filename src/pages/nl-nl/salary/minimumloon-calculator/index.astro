---
import CalculatorResource from '../../../../components/content/CalculatorResource.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import NlMinimumloonCalculator from '../../../../components/islands/NlMinimumloonCalculator';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'nl-NL' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  t.salary.minimumloon.title,
  t.salary.minimumloon.metaDescription,
  '/nl-nl/salary/minimumloon-calculator/',
);

const faqItems = [
  {
    question: 'Wat is het minimumloon in Nederland in 2026?',
    answer:
      'Het wettelijk minimumloon bedraagt €14,06 bruto per uur per 1 januari 2026. Dat staat gelijk aan ongeveer €2.449 bruto per maand bij een 40-urige werkweek.',
  },
  {
    question: 'Geldt het minimumloon per uur of per maand?',
    answer:
      'Sinds 1 januari 2024 is het minimumloon in Nederland vastgesteld als een uurloon. Er is geen afzonderlijk maand- of weekbedrag meer. De hoogte per maand hangt dus af van het contractuele aantal uren per week.',
  },
  {
    question: 'Vanaf welke leeftijd geldt het volledige minimumloon?',
    answer:
      'Het volledige wettelijk minimumloon geldt voor werknemers van 21 jaar en ouder. Voor jongeren van 15 tot 20 jaar gelden lagere jeugdminimumlonen, uitgedrukt als een percentage van het volwassen minimumloon.',
  },
  {
    question: 'Wat als mijn werkgever minder betaalt?',
    answer:
      'Het is wettelijk verplicht om minimaal het minimumloon te betalen. Bij een vermoeden van onderbetaling kunt u een melding doen bij de Nederlandse Arbeidsinspectie (NLA), die handhavend kan optreden.',
  },
  {
    question: 'Geldt het minimumloon ook voor ZZP\'ers?',
    answer:
      'Nee, het wettelijk minimumloon geldt alleen voor werknemers met een arbeidscontract. ZZP\'ers (freelancers) zijn zelfstandig en bepalen zelf hun tarief, hoewel er politieke discussie is over een minimumtarief voor ZZP.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  equivalentPageGroup="nl-minimumloon-calculator"
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: t.navigation.salary, href: buildLocalePath(locale, 'salary') },
      { label: t.salary.minimumloon.title, href: buildLocalePath(locale, 'salary/minimumloon-calculator') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">{t.salary.minimumloon.h1}</h1>
    <p class="mt-3 max-w-2xl text-slate-600">{t.salary.minimumloon.intro}</p>

    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <NlMinimumloonCalculator client:load locale={locale} />
    </div>

    <div class="mt-8">
      <InContentAd slotId="nl-minimumloon-1" />
    </div>

    <div class="mt-10 prose prose-slate max-w-none">
      <h2>Wettelijk minimumloon 2026</h2>
      <p>
        Per 1 januari 2026 bedraagt het wettelijk minimumloon (WML) <strong>€14,06 bruto per uur</strong>.
        Het minimumloon wordt halfjaarlijks geïndexeerd op de contractloonontwikkeling.
      </p>
      <table>
        <thead>
          <tr><th>Referentie</th><th>Bruto bedrag</th></tr>
        </thead>
        <tbody>
          <tr><td>Per uur</td><td>€14,06</td></tr>
          <tr><td>Per maand (40 uur/week)</td><td>≈ €2.449</td></tr>
          <tr><td>Per jaar (40 uur/week)</td><td>≈ €29.393</td></tr>
          <tr><td>Vakantiegeld (8%)</td><td>≈ €2.351</td></tr>
        </tbody>
      </table>
      <h2>Jeugdminimumloon</h2>
      <p>
        Voor werknemers tussen 15 en 20 jaar geldt een jeugdminimumloon als percentage van het volwassen tarief:
        15 jaar (40%), 16 jaar (47%), 17 jaar (54%), 18 jaar (61%), 19 jaar (72,6%), 20 jaar (85,5%).
        Vanaf 21 jaar: 100%.
      </p>
      <p class="text-sm">
        Bron: <a href="https://www.rijksoverheid.nl/onderwerpen/minimumloon/bedragen-minimumloon" target="_blank" rel="noopener noreferrer">Rijksoverheid — Bedragen minimumloon 2026</a>
      </p>
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.verifyProfessional} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="Veelgestelde vragen over minimumloon" items={faqItems} />
  </article>
  <CalculatorResource locale="nl-NL" category="salary" />
</BaseLayout>

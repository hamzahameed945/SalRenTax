---
import CalculatorResource from '../../../../components/content/CalculatorResource.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import SalaryToHourlyCalculator from '../../../../components/islands/SalaryToHourlyCalculator';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'nl-NL' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'Salaris naar Uurloon Calculator — PayRenTax',
  t.salary.salaryToHourly.intro,
  '/nl-nl/salary/salaris-naar-uurloon/',
);

const faqItems = [
  {
    question: 'Hoe bereken ik mijn uurloon vanuit mijn jaarsalaris?',
    answer:
      'Deel uw jaarsalaris door het aantal gewerkte uren per jaar. Bij 40 uur per week en 52 weken is dat 2.080 uur. Voorbeeld: €50.000 ÷ 2.080 = €24,04 per uur.',
  },
  {
    question: 'Wat is het wettelijk minimumloon in Nederland in 2026?',
    answer:
      'Sinds 1 januari 2024 geldt in Nederland een minimumloon per uur in plaats van per maand. Voor werknemers van 21 jaar en ouder bedraagt het wettelijk minimumloon in 2026 circa €14,06 per uur (onder voorbehoud van indexering).',
  },
  {
    question: 'Hoeveel werkuren telt een jaar in Nederland?',
    answer:
      'Een voltijds dienstverband in Nederland is doorgaans 36 tot 40 uur per week. Bij 40 uur per week en 52 weken zijn dat 2.080 uur per jaar. Vakantiedagen en feestdagen verminderen de feitelijk gewerkte uren.',
  },
  {
    question: 'Is dit bruto of netto uurloon?',
    answer:
      'Deze calculator rekent met uw bruto jaarsalaris en geeft een bruto uurloon. Het netto uurloon is lager vanwege loonbelasting en premies. Gebruik onze Bruto Netto Calculator voor de netto berekening.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  equivalentPageGroup="salary-to-hourly"
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: t.navigation.salary, href: buildLocalePath(locale, 'salary') },
      { label: t.salary.salaryToHourly.title, href: buildLocalePath(locale, 'salary/salaris-naar-uurloon') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">{t.salary.salaryToHourly.h1}</h1>
    <p class="mt-3 max-w-2xl text-slate-600">{t.salary.salaryToHourly.intro}</p>

    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <SalaryToHourlyCalculator
        client:load
        locale={locale}
        currency="EUR"
        labels={{
          annualSalary:   'Bruto jaarsalaris',
          hoursPerWeek:   'Uren per week',
          weeksPerYear:   'Weken per jaar',
          resultsHeading: 'Uurloon en equivalenten',
          hourlyWage:     'Uurloon',
          daily:          'Dagelijks',
          weekly:         'Wekelijks',
          biweekly:       'Per twee weken',
          monthly:        'Maandelijks',
          placeholder:    'Voer uw jaarsalaris en uren in om de equivalenten te zien.',
        }}
      />
    </div>

    <div class="mt-8">
      <InContentAd slotId="nl-salary-hourly-1" />
    </div>

    <div class="mt-10 prose prose-slate max-w-none">
      <h2>Uurloon berekenen — formule</h2>
      <table>
        <thead>
          <tr>
            <th>Werkweek</th>
            <th>Uren per jaar</th>
            <th>Uurloon bij €50.000/jaar</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>36 uur / week</td><td>1.872 uur</td><td>€26,71</td></tr>
          <tr><td>38 uur / week</td><td>1.976 uur</td><td>€25,30</td></tr>
          <tr><td>40 uur / week</td><td>2.080 uur</td><td>€24,04</td></tr>
        </tbody>
      </table>
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.verifyProfessional}
    </p>

    <CalculatorFAQ heading="Veelgestelde vragen over uurloon berekenen" items={faqItems} />
  </article>
  <CalculatorResource locale="nl-NL" category="salary" />
</BaseLayout>

---
import CalculatorResource from '../../../../components/content/CalculatorResource.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import PayFrequencyConverter from '../../../../components/islands/PayFrequencyConverter';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'nl-NL' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'Salarisperiode Converter — PayRenTax',
  t.salary.payFrequency.intro,
  '/nl-nl/salary/salarisperiode-converter/',
);

const faqItems = [
  {
    question: 'Hoe rekent u een maandloon om naar een jaarinkomen?',
    answer:
      'Vermenigvuldig uw maandloon met 12 voor het basisbedrag. Houd er rekening mee dat velen in Nederland 13 of zelfs 13,5 maanden salaris ontvangen inclusief vakantiegeld (8%) en eventuele eindejaarsuitkering.',
  },
  {
    question: 'Wat is vakantiegeld in Nederland?',
    answer:
      'Werknemers in Nederland hebben recht op vakantiegeld van minimaal 8% van het bruto jaarsalaris. Dit wordt doorgaans in mei uitbetaald. De calculator houdt hier geen rekening mee — het gaat om het vaste periodieke loon.',
  },
  {
    question: 'Wat is het verschil tussen bruto en netto loon per periode?',
    answer:
      'Het bruto loon is uw salaris vóór aftrek van loonbelasting en premies. Het netto loon is wat u daadwerkelijk ontvangt. Gebruik onze Bruto Netto Calculator om de netto bedragen per periode te berekenen.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  equivalentPageGroup="pay-frequency"
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: t.navigation.salary, href: buildLocalePath(locale, 'salary') },
      { label: t.salary.payFrequency.title, href: buildLocalePath(locale, 'salary/salarisperiode-converter') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">{t.salary.payFrequency.h1}</h1>
    <p class="mt-3 max-w-2xl text-slate-600">{t.salary.payFrequency.intro}</p>

    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <PayFrequencyConverter
        client:load
        t={t}
        locale={locale}
        currency="EUR"
        labels={{
          payAmount:        'Loonsalaris',
          currentFrequency: 'Huidige betalingsperiode',
          hoursPerWeek:     'Uren per week',
          resultsHeading:   'Loon per periode',
          annually:         'Jaarlijks',
          monthly:          'Maandelijks',
          semimonthly:      'Twee keer per maand',
          biweekly:         'Per twee weken',
          weekly:           'Wekelijks',
          daily:            'Dagelijks',
          hourly:           'Per uur',
          placeholder:      'Voer uw loon en periode in om alle equivalenten te zien.',
        }}
      />
    </div>

    <div class="mt-8">
      <InContentAd slotId="nl-pay-freq-1" />
    </div>

    <div class="mt-10 prose prose-slate max-w-none">
      <h2>Omrekentabel loonperioden</h2>
      <table>
        <thead>
          <tr>
            <th>Periode</th>
            <th>Formule vanuit jaarloon</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>Per week</td><td>Jaarloon ÷ 52</td></tr>
          <tr><td>Per twee weken</td><td>Jaarloon ÷ 26</td></tr>
          <tr><td>Per maand</td><td>Jaarloon ÷ 12</td></tr>
          <tr><td>Per jaar</td><td>Maandloon × 12</td></tr>
        </tbody>
      </table>
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.verifyProfessional}
    </p>

    <CalculatorFAQ heading="Veelgestelde vragen over salarisperioden" items={faqItems} />
  </article>
  <CalculatorResource locale="nl-NL" category="salary" />
</BaseLayout>

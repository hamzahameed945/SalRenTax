---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDictionary } from '../../i18n/dictionaries';
import { getLocaleConfig } from '../../data/locales';
import { getActivePagesForLocale } from '../../seo/page-registry';
import { buildPageMetadata } from '../../lib/seo/metadata';
import { buildLocalePath } from '../../i18n/utils';

const locale = 'en-US' as const;
const t = getDictionary(locale);
const config = getLocaleConfig(locale);
const meta = buildPageMetadata(t.meta.localeHomeTitle, t.meta.localeHomeDescription, '/en-us/');
const calculatorPages = getActivePagesForLocale(locale).filter((p) => p.pageType === 'calculator');
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <section class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="text-3xl font-bold text-slate-900">{t.meta.localeHomeTitle.split(' — ')[0]}</h1>
    <p class="mt-3 max-w-2xl text-slate-600">{t.meta.localeHomeDescription}</p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {config.categories.map((category) => (
        <a
          href={buildLocalePath(locale, category)}
          class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm hover:border-accent"
        >
          <span class="font-semibold text-slate-900">{t.navigation[category]}</span>
        </a>
      ))}
    </div>

    <h2 class="mt-10 text-xl font-semibold text-slate-900">{t.common.popularCalculators}</h2>
    <ul class="mt-3 space-y-2">
      {calculatorPages.map((page) => (
        <li>
          <a
            href={buildLocalePath(locale, page.slug)}
            class="text-accent underline hover:text-accent-dark"
          >
            {page.primaryKeyword}
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

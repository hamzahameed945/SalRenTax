---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDictionary } from '../../i18n/dictionaries';
import { getLocaleConfig } from '../../data/locales';
import { getActivePagesForLocale } from '../../seo/page-registry';
import { buildPageMetadata } from '../../lib/seo/metadata';
import { buildLocalePath } from '../../i18n/utils';
import TiltCard from '../../components/islands/TiltCard';

const locale = 'en-US' as const;
const t = getDictionary(locale);
const config = getLocaleConfig(locale);
const meta = buildPageMetadata(t.meta.localeHomeTitle, t.meta.localeHomeDescription, '/en-us/');
const calculatorPages = getActivePagesForLocale(locale).filter((p) => p.pageType === 'calculator');

/* Category card metadata keyed by category slug */
const categoryMeta: Record<string, { icon: string; description: string; gradient: string; glow: string }> = {
  salary: {
    icon: '💰',
    description: 'Calculate take-home pay, hourly rates, pay raises, and more.',
    gradient: 'from-emerald-500 to-teal-600',
    glow: 'rgba(16, 185, 129, 0.2)',
  },
  rent: {
    icon: '🏠',
    description: 'Find out how much rent you can afford based on your income.',
    gradient: 'from-blue-500 to-indigo-600',
    glow: 'rgba(59, 130, 246, 0.2)',
  },
  tax: {
    icon: '📊',
    description: 'Estimate federal & state income tax with current brackets.',
    gradient: 'from-violet-500 to-purple-600',
    glow: 'rgba(139, 92, 246, 0.2)',
  },
};

/* Calculator card accent colors by category */
const calcAccent: Record<string, string> = {
  salary: 'border-l-emerald-500',
  rent: 'border-l-blue-500',
  tax: 'border-l-violet-500',
};
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <!-- ═══ Hero Section ═══ -->
  <section class="relative overflow-hidden bg-gradient-to-br from-slate-50 via-white to-slate-50">
    <!-- Decorative orbs -->
    <div class="hero-orb w-72 h-72 bg-emerald-400 -top-20 -left-20 animate-float" aria-hidden="true"></div>
    <div class="hero-orb w-96 h-96 bg-blue-400 top-10 right-0 animate-float delay-200" aria-hidden="true"></div>
    <div class="hero-orb w-64 h-64 bg-violet-400 bottom-0 left-1/3 animate-float delay-400" aria-hidden="true"></div>

    <div class="relative z-10 mx-auto max-w-5xl px-4 pt-16 pb-20 text-center sm:pt-24 sm:pb-28">
      <p class="animate-fade-in-up text-sm font-semibold uppercase tracking-widest text-accent">
        Smart Financial Tools
      </p>
      <h1 class="animate-fade-in-up delay-100 mt-4 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl md:text-6xl">
        {t.meta.localeHomeTitle.split(' — ')[0]?.split(' - ')[0]}
      </h1>
      <p class="animate-fade-in-up delay-200 mx-auto mt-5 max-w-2xl text-lg text-slate-600 leading-relaxed">
        {t.meta.localeHomeDescription}
      </p>
    </div>
  </section>

  <!-- ═══ Category Cards ═══ -->
  <section class="relative z-10 mx-auto -mt-10 max-w-5xl px-4 sm:-mt-14">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {config.categories.map((category, i) => {
        const cm = categoryMeta[category];
        const delayClass = i === 0 ? 'delay-300' : i === 1 ? 'delay-400' : 'delay-500';
        return (
          <div class={`perspective-1000 animate-fade-in-up ${delayClass}`}>
            <TiltCard
              client:visible
              href={buildLocalePath(locale, category)}
              glowColor={cm?.glow}
            >
              <div class="p-7">
                {/* Icon circle */}
                <div class={`mb-5 flex h-14 w-14 items-center justify-center rounded-xl bg-gradient-to-br ${cm?.gradient} text-2xl shadow-md`}>
                  <span class="drop-shadow-sm">{cm?.icon}</span>
                </div>
                {/* Title */}
                <h2 class="text-xl font-bold text-slate-900">
                  {t.navigation[category]}
                </h2>
                {/* Description */}
                <p class="mt-2 text-sm leading-relaxed text-slate-500">
                  {cm?.description}
                </p>
                {/* Arrow */}
                <div class="mt-5 flex items-center gap-1.5 text-sm font-semibold text-accent">
                  Explore
                  <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                  </svg>
                </div>
              </div>
            </TiltCard>
          </div>
        );
      })}
    </div>
  </section>

  <!-- ═══ Popular Calculators ═══ -->
  <section class="mx-auto max-w-5xl px-4 py-16 sm:py-20">
    <h2 class="animate-fade-in-up delay-500 text-2xl font-bold text-slate-900 sm:text-3xl">
      {t.common.popularCalculators}
    </h2>
    <p class="animate-fade-in-up delay-600 mt-2 text-slate-500">
      Quick access to the tools people use most.
    </p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {calculatorPages.map((page, i) => {
        const accent = calcAccent[page.category] ?? 'border-l-slate-400';
        const delayClass = `delay-${(i + 6) * 100}`;
        return (
          <a
            href={buildLocalePath(locale, page.slug)}
            class={`animate-fade-in-up group flex items-center justify-between rounded-xl border border-slate-200/60 border-l-4 ${accent} bg-white p-5 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-lg`}
            style={`animation-delay: ${(i + 6) * 80}ms;`}
          >
            <span class="font-semibold text-slate-800 group-hover:text-accent transition-colors">
              {page.primaryKeyword}
            </span>
            <svg class="h-5 w-5 shrink-0 text-slate-400 transition-all group-hover:text-accent group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
            </svg>
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>

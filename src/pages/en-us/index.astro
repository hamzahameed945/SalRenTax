---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDictionary } from '../../i18n/dictionaries';
import { getActivePagesForLocale } from '../../seo/page-registry';
import { buildPageMetadata } from '../../lib/seo/metadata';
import { buildLocalePath } from '../../i18n/utils';
import TiltCard from '../../components/islands/TiltCard';
import { categoryMeta } from '../../data/categoryMeta';

const locale = 'en-US' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(t.meta.localeHomeTitle, t.meta.localeHomeDescription, '/en-us/');
const calculatorPages = getActivePagesForLocale(locale).filter((p) => p.pageType === 'calculator');
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <!-- ═══ Hero Section ═══ -->
  <section class="relative overflow-hidden bg-gradient-to-br from-slate-50 via-white to-slate-50">
    <!-- Decorative orbs -->
    <div class="hero-orb w-72 h-72 bg-emerald-400 -top-20 -left-20 animate-float" aria-hidden="true"></div>
    <div class="hero-orb w-96 h-96 bg-blue-400 top-10 right-0 animate-float delay-200" aria-hidden="true"></div>
    <div class="hero-orb w-64 h-64 bg-violet-400 bottom-0 left-1/3 animate-float delay-400" aria-hidden="true"></div>

    <div class="relative z-10 mx-auto max-w-5xl px-4 pt-16 pb-20 text-center sm:pt-24 sm:pb-28">
      <p class="animate-fade-in-up text-sm font-semibold uppercase tracking-widest text-accent">
        Smart financial tools for everyday questions
      </p>
      <h1 class="animate-fade-in-up delay-100 mt-4 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl md:text-6xl">
        {t.meta.localeHomeTitle.split(' — ')[0]?.split(' - ')[0]}
      </h1>
      <p class="animate-fade-in-up delay-200 mx-auto mt-5 max-w-2xl text-lg text-slate-600 leading-relaxed">
        Estimate your take-home pay, understand common payroll deductions, compare salary and
        hourly rates, and explore rent affordability with straightforward calculators.
      </p>
    </div>
  </section>

  <!-- ═══ Calculator Cards ═══ -->
  <section class="mx-auto max-w-5xl px-4 py-16 sm:py-20">
    <h2 class="animate-fade-in-up delay-300 text-2xl font-bold text-slate-900 sm:text-3xl">
      {t.common.popularCalculators}
    </h2>
    <p class="animate-fade-in-up delay-400 mt-2 text-slate-500">
      Quick access to the tools people use most for salary, payroll, and budgeting questions.
    </p>

    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {calculatorPages.map((page, i) => {
        const cm = categoryMeta[page.category] ?? categoryMeta['salary'];
        return (
          <div class="perspective-1000 animate-fade-in-up" style={`animation-delay: ${(i + 4) * 80}ms;`}>
            <TiltCard
              client:visible
              href={buildLocalePath(locale, page.slug)}
              glowColor={cm.glow}
            >
              <div class="p-6">
                {/* Icon circle */}
                <div class={`mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br ${cm.gradient} text-xl shadow-md`}>
                  <span class="drop-shadow-sm">{cm.icon}</span>
                </div>
                {/* Title */}
                <h3 class="text-base font-bold text-slate-900 leading-snug">
                  {page.primaryKeyword}
                </h3>
                {page.description && (
                  <p class="mt-1 text-sm text-slate-500 leading-snug">{page.description}</p>
                )}
                {/* Arrow */}
                <div class="mt-4 flex items-center gap-1.5 text-sm font-semibold text-accent">
                  Explore
                  <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                  </svg>
                </div>
              </div>
            </TiltCard>
          </div>
        );
      })}
    </div>
  </section>
</BaseLayout>

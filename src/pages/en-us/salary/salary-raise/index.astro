---
import CalculatorResource from '../../../../components/content/CalculatorResource.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import SalaryRaiseCalculator from '../../../../components/islands/SalaryRaiseCalculator';

const locale = 'en-US' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'Salary Raise Calculator — PayRenTax',
  t.salary.salaryRaise.intro,
  '/en-us/salary/salary-raise/',
);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <section class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="text-3xl font-bold text-slate-900 mb-6">{t.salary.salaryRaise.h1}</h1>
    <p class="mb-8 text-slate-600">{t.salary.salaryRaise.intro}</p>
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <SalaryRaiseCalculator client:load t={t} locale={locale} />
    </div>
    <div class="mt-10 prose prose-slate max-w-none">
      <h2>What a raise calculation shows</h2>
      <p>
        Enter your current salary and the raise you are considering. The calculator shows the updated amount so you can quickly understand the difference between your current and new pay.
      </p>
      <p>
        A raise calculation shows the change in gross compensation. Your actual take-home pay will depend on taxes, deductions, benefits, and other payroll details.
      </p>
    </div>
  </section>
  <CalculatorResource locale="en-US" category="salary" />
</BaseLayout>

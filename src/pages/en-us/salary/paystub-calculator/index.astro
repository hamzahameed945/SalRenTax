---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import { buildLocalePath } from '../../../../i18n/utils';
import PaycheckCalculator from '../../../../components/islands/PaycheckCalculator';
const locale = 'en-US' as const;
---
<BaseLayout locale={locale} title="Paystub Calculator 2026 — SalRenTax" description="Estimate a paycheck breakdown from gross pay, pay frequency, filing status and pre-tax deductions." canonical="/en-us/salary/paystub-calculator/">
  <Breadcrumbs locale={locale} trail={[{label:'Salary Calculators',href:buildLocalePath(locale,'salary')}]} />
  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">Paystub Calculator 2026</h1>
    <p class="mt-3 max-w-2xl text-slate-600">Estimate a paycheck-style breakdown from gross pay, pay frequency, filing status and pre-tax deductions. The tool is an estimate, not a replacement for an employer paystub.</p>
    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><PaycheckCalculator client:load /></div>
    <div class="mt-8"><InContentAd slotId="paystub-calculator-1" /></div>
    <div class="mt-10 prose prose-slate max-w-none"><h2>What this paystub calculator estimates</h2><p>It separates gross pay, federal income tax, Social Security, Medicare and any pre-tax deduction entered in the form.</p></div>
  </article>
</BaseLayout>

---
import CategoryResource from '../../../components/content/CategoryResource.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../components/calculator/CalculatorFAQ.astro';
import JsonLd from '../../../components/seo/JsonLd.astro';
import { getDictionary } from '../../../i18n/dictionaries';
import { getActivePagesForLocale } from '../../../seo/page-registry';
import { buildPageMetadata } from '../../../lib/seo/metadata';
import { buildFaqJsonLd } from '../../../lib/seo/structuredData';
import { buildLocalePath } from '../../../i18n/utils';

const locale = 'en-US' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  `${t.salary.categoryTitle} — ${t.meta.siteTitleSuffix}`,
  t.salary.categoryIntro,
  '/en-us/salary/',
);
const calculators = getActivePagesForLocale(locale).filter(
  (p) => p.category === 'salary' && p.pageType === 'calculator',
);
const statePaychecks = getActivePagesForLocale(locale).filter(
  (p) => p.category === 'states' && p.pageType === 'calculator' && p.slug.split('/').length === 2,
);
const faqItems = [
  {
    question: 'What is take-home pay?',
    answer:
      'Take-home pay is gross pay minus federal income tax, Social Security, and Medicare, along with any pre-tax deductions. It is the amount left to spend or save after those deductions are taken from a paycheck.',
  },
  {
    question: 'Why does my paycheck differ from my salary divided by 26 or 12?',
    answer:
      'Dividing an annual salary by 26 or 12 gives gross pay per biweekly or monthly period before deductions. Your actual paycheck is lower because federal income tax, Social Security, Medicare, and any pre-tax deductions are taken out first.',
  },
  {
    question: 'How do I compare hourly vs salary offers?',
    answer:
      'Convert both offers to the same pay period, using the hours you expect to work, and compare the estimated take-home pay rather than the headline hourly rate or annual salary alone.',
  },
  {
    question: 'Are these results exact?',
    answer:
      'No. These calculators give estimates for general guidance. Your actual paycheck depends on your individual circumstances, withholding choices, and deductions, so check your payslip for the final amount.',
  },
];
const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[{ label: t.navigation.salary, href: buildLocalePath(locale, 'salary') }]}
  />
  <section class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">{t.salary.categoryTitle}</h1>
    <p class="mt-3 text-slate-600">{t.salary.categoryIntro}</p>

    <ul class="mt-8 space-y-3">
      {calculators.map((page) => (
        <li class="rounded-lg border border-slate-200 bg-white p-4">
          <a
            href={buildLocalePath(locale, page.slug)}
            class="font-semibold text-accent hover:underline"
          >
            {page.primaryKeyword}
          </a>
        </li>
      ))}
    </ul>
    <h2 class="mt-10 text-2xl font-bold text-slate-900">Paycheck Calculators by State</h2>
    <p class="mt-3 text-slate-600">Find your state's take-home pay calculator, with federal and state tax rules for 2026.</p>
    <ul class="mt-4 grid gap-2 sm:grid-cols-2">
      {statePaychecks.map((page) => (
        <li>
          <a
            href={buildLocalePath(locale, page.slug)}
            class="font-semibold text-accent hover:underline"
          >
            {page.primaryKeyword}
          </a>
        </li>
      ))}
    </ul>
    <h2 class="mt-10 text-2xl font-bold text-slate-900">About these calculators</h2>
    <p class="mt-3 text-slate-600">Take-home pay is the amount left after deductions from gross pay. In general, that means gross pay minus federal income tax, Social Security, and Medicare, along with any pre-tax deductions. The calculators on this page start with gross pay and give an estimate of what remains, so you can compare offers and plan a budget around the amount you actually receive.</p>
    <p class="mt-3 text-slate-600">Results can vary with filing status and pay frequency, because the same annual salary can be split across a different number of paychecks. When you compare figures, keep the pay period the same: a weekly, biweekly, or monthly amount is only meaningful beside another amount for the same period.</p>
    <p class="mt-3 text-slate-600">To compare an hourly offer with an annual salary, put both on the same basis and look at take-home pay rather than the headline rate alone. Hours worked and how often you are paid both affect the result. The same point applies to a raise: because higher income is taxed, take-home pay usually rises by less than the gross raise.</p>
    <CalculatorFAQ heading="Frequently asked questions" items={faqItems} />
</section>
  <CategoryResource locale="en-US" category="salary" />
</BaseLayout>

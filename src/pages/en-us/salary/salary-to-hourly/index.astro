---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import SalaryToHourlyCalculator from '../../../../components/islands/SalaryToHourlyCalculator';

const locale = 'en-US' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'Salary to Hourly Calculator — SalRenTax',
  t.salary.salaryToHourly.intro,
  '/en-us/salary/salary-to-hourly/',
);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <section class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="text-3xl font-bold text-slate-900 mb-6">{t.salary.salaryToHourly.h1}</h1>
    <p class="mb-8 text-slate-600">{t.salary.salaryToHourly.intro}</p>
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <SalaryToHourlyCalculator client:load t={t} locale={locale} />
    </div>
  </section>
</BaseLayout>

---
import CalculatorResource from '../../../../components/content/CalculatorResource.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import SalaryToHourlyCalculator from '../../../../components/islands/SalaryToHourlyCalculator';

const locale = 'en-US' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'Salary to Hourly Calculator — PayRenTax',
  t.salary.salaryToHourly.intro,
  '/en-us/salary/salary-to-hourly/',
);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <section class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="text-3xl font-bold text-slate-900 mb-6">{t.salary.salaryToHourly.h1}</h1>
    <p class="mb-8 text-slate-600">{t.salary.salaryToHourly.intro}</p>
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <SalaryToHourlyCalculator client:load t={t} locale={locale} />
    </div>
    <div class="mt-10 prose prose-slate max-w-none">
      <h2>How salary converts to an hourly rate</h2>
      <p>
        This is a simple way to compare a salaried job with an hourly position. Enter your annual salary and typical working hours, and the calculator converts the amount into an estimated hourly wage.
      </p>
      <p>
        The result is a conversion, not a statement about your actual compensation package or overtime eligibility.
      </p>
    </div>
  </section>
  <CalculatorResource locale="en-US" category="salary" />
</BaseLayout>

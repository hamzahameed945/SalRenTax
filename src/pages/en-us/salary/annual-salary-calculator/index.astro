---
import CalculatorResource from '../../../../components/content/CalculatorResource.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import HourlyToSalaryCalculator from '../../../../components/islands/HourlyToSalaryCalculator';
import { enUS } from '../../../../i18n/en-US';
import { buildLocalePath } from '../../../../i18n/utils';

const locale = 'en-US' as const;
---

<BaseLayout
  locale={locale}
  title="Annual Salary Calculator — PayRenTax"
  description="Convert hourly, daily, weekly, or monthly earnings into an estimated annual salary."
  canonical="/en-us/salary/annual-salary-calculator/"
>
  <Breadcrumbs
    locale={locale}
    trail={[{ label: 'Salary Calculators', href: buildLocalePath(locale, 'salary') }]}
  />
  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">Annual Salary Calculator</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      Convert hourly, daily, weekly, or monthly earnings into an estimated annual salary.
    </p>
    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <HourlyToSalaryCalculator client:load t={enUS} locale="en-US" />
    </div>
    <div class="mt-8">
      <InContentAd slotId="annual-salary-calculator-1" />
    </div>
    <div class="mt-10 prose prose-slate max-w-none">
      <h2>How the annual salary estimate works</h2>
      <p>
        This calculator helps you put different pay offers on the same annual basis. Enter the
        amount you earn for the selected pay period and the calculator estimates the equivalent
        yearly income.
      </p>
      <p>
        It multiplies hourly pay by hours per week and working weeks per year, then works out the
        monthly, biweekly, weekly, and daily equivalents from that annual amount.
      </p>
    </div>
  </article>
  <CalculatorResource locale="en-US" category="salary" />
</BaseLayout>

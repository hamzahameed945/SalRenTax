---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import HourlyToSalaryCalculator from '../../../../components/islands/HourlyToSalaryCalculator';

const locale = 'en-US' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'Hourly to Salary Calculator — SalRenTax',
  t.salary.hourlyToSalary.intro,
  '/en-us/salary/hourly-to-salary/',
);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <section class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="text-3xl font-bold text-slate-900 mb-6">{t.salary.hourlyToSalary.h1}</h1>
    <p class="mb-8 text-slate-600">{t.salary.hourlyToSalary.intro}</p>
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <HourlyToSalaryCalculator client:load t={t} locale={locale} />
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../../components/ads/InContentAd.astro';
import AffiliateCTA from '../../../../../components/ads/AffiliateCTA.astro';
import HouseAffordabilityCalculator from '../../../../../components/islands/HouseAffordabilityCalculator';
import JsonLd from '../../../../../components/seo/JsonLd.astro';
import { getDictionary } from '../../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../../lib/seo/structuredData';

const locale = 'en-US' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'On $50,000 in Tennessee You Can Afford a ~$192,100 Home (2026) — PayRenTax',
  'A $50,000 salary in Tennessee buys a ~$192,100 home in 2026. Max monthly PITI $1,167 (28% rule) at 7.28%, 20% down. Take-home: $3,530/mo.',
  '/en-us/salary/house-affordability/tennessee-50000/',
);

const faqItems = [
  {
    question: 'How much house can I afford on a $50,000 salary in Tennessee?',
    answer:
      'On a $50,000 salary in Tennessee, you can afford a home priced around $192,100 in 2026. That assumes a 30-year fixed mortgage at 7.28%, 20% down ($38,417), and Tennessee\'s effective property tax rate of 0.52%. Your maximum monthly PITI payment would be $1,167.',
  },
  {
    question: 'What is the maximum monthly mortgage payment on $50,000 in Tennessee?',
    answer:
      'The 28% rule caps your monthly housing payment at $1,167 on a $50,000 salary ($1,167 is 28% of your $4,167 gross monthly income). That breaks down into roughly $1,051 principal and interest, $83 property tax, and $32 homeowner\'s insurance.',
  },
  {
    question: 'How is the affordable home price in Tennessee calculated?',
    answer:
      'Lenders use the 28/36 rule: housing costs should not exceed 28% of gross monthly income (front-end ratio), and total debts should stay under 36% (back-end ratio). We solve for the home price whose PITI equals 28% of gross, using a 7.28% 30-year fixed rate (Freddie Mac, October 2026), 20% down, Tennessee\'s 0.52% effective property tax rate (Tax Foundation 2026), and 0.20%/year homeowner\'s insurance.',
  },
  {
    question: 'How much take-home pay does a $50,000 salary leave in Tennessee?',
    answer:
      'A $50,000 salary in Tennessee leaves about $42,355 per year after federal income tax, FICA, and state tax in 2026 — roughly $3,530 per month for a single filer with no pre-tax deductions. The $1,167 max housing payment is about 33% of that take-home pay.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: 'Salary', href: buildLocalePath(locale, 'salary') },
      { label: 'House Affordability', href: buildLocalePath(locale, 'salary/house-affordability') },
      { label: '$50,000 in Tennessee', href: buildLocalePath(locale, 'salary/house-affordability/tennessee-50000') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">How Much House Can You Afford on $50,000 in Tennessee?</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      On a <strong>$50,000</strong> salary in Tennessee, you can afford a home priced
      around <strong>$192,100</strong> in 2026 — with a maximum monthly PITI payment of
      <strong> $1,167</strong> under the 28% rule. Your estimated take-home pay is
      $3,530/month.
    </p>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold">2026 affordability breakdown: $50,000 in Tennessee</h2>
      <table class="mt-4 w-full text-sm">
        <tbody>
          <tr><td>Gross salary</td><td>$50,000</td></tr>
          <tr><td>Gross monthly income</td><td>$4,167</td></tr>
          <tr><td>Max monthly housing (28% rule)</td><td>$1,167</td></tr>
          <tr><td>Take-home pay (monthly)</td><td>$3,530</td></tr>
          <tr class="font-semibold"><td>Max home price</td><td>$192,100</td></tr>
          <tr><td>Down payment (20%)</td><td>$38,417</td></tr>
          <tr><td>Principal &amp; interest</td><td>$1,051/mo</td></tr>
          <tr><td>Property tax (0.52% effective)</td><td>$83/mo</td></tr>
          <tr><td>Homeowner's insurance</td><td>$32/mo</td></tr>
          <tr class="font-semibold"><td>Monthly PITI</td><td>$1,167</td></tr>
        </tbody>
      </table>
      <p class="mt-4 text-xs text-slate-500">
        Single filer, no pre-tax deductions. 30-year fixed at 7.28% (Freddie Mac PMMS, Oct 1, 2026),
        20% down, Tennessee effective property tax 0.52% (Tax Foundation 2026), insurance 0.20%/yr.
        Figures are estimates — adjust inputs in the calculator below.
      </p>
    </div>

    <div class="mt-8">
      <InContentAd slotId="house-affordability-tennessee-50000" />
    </div>

    <div class="mt-8">
      <AffiliateCTA locale="en-US" />
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="$50,000 in Tennessee: house affordability FAQs" items={faqItems} />

    <div class="mt-10">
      <h2 class="text-xl font-semibold">Customize the numbers</h2>
      <div class="mt-4">
        <HouseAffordabilityCalculator stateCode="TN" initialAnnualSalary="50000" client:load />
      </div>
    </div>

    <nav class="mt-10" aria-label="Other salaries in Tennessee">
      <h2 class="text-xl font-semibold">Other salaries in Tennessee</h2>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/tennessee-40000/">$40,000 salary in Tennessee</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/tennessee-60000/">$60,000 salary in Tennessee</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/tennessee-75000/">$75,000 salary in Tennessee</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/tennessee-80000/">$80,000 salary in Tennessee</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/tennessee-100000/">$100,000 salary in Tennessee</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/tennessee-125000/">$125,000 salary in Tennessee</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/tennessee-150000/">$150,000 salary in Tennessee</a></li>
      </ul>
    </nav>

    <nav class="mt-10" aria-label="Same salary in other states">
      <h2 class="text-xl font-semibold">$50,000 salary in other states</h2>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/california-50000/">$50,000 salary in California</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/florida-50000/">$50,000 salary in Florida</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/new-york-50000/">$50,000 salary in New York</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/pennsylvania-50000/">$50,000 salary in Pennsylvania</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/illinois-50000/">$50,000 salary in Illinois</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/ohio-50000/">$50,000 salary in Ohio</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/georgia-50000/">$50,000 salary in Georgia</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/north-carolina-50000/">$50,000 salary in North Carolina</a></li>
      </ul>
    </nav>
  </article>
</BaseLayout>

---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../../components/ads/InContentAd.astro';
import AffiliateCTA from '../../../../../components/ads/AffiliateCTA.astro';
import HouseAffordabilityCalculator from '../../../../../components/islands/HouseAffordabilityCalculator';
import JsonLd from '../../../../../components/seo/JsonLd.astro';
import { getDictionary } from '../../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../../lib/seo/structuredData';

const locale = 'en-US' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'On $40,000 in New Hampshire You Can Afford a ~$135,500 Home (2026) — PayRenTax',
  'A $40,000 salary in New Hampshire buys a ~$135,500 home in 2026. Max monthly PITI $933 (28% rule) at 7.28%, 20% down. Take-home: $2,860/mo.',
  '/en-us/salary/house-affordability/new-hampshire-40000/',
);

const faqItems = [
  {
    question: 'How much house can I afford on a $40,000 salary in New Hampshire?',
    answer:
      'On a $40,000 salary in New Hampshire, you can afford a home priced around $135,500 in 2026. That assumes a 30-year fixed mortgage at 7.28%, 20% down ($27,091), and New Hampshire\'s effective property tax rate of 1.50%. Your maximum monthly PITI payment would be $933.',
  },
  {
    question: 'What is the maximum monthly mortgage payment on $40,000 in New Hampshire?',
    answer:
      'The 28% rule caps your monthly housing payment at $933 on a $40,000 salary ($933 is 28% of your $3,333 gross monthly income). That breaks down into roughly $741 principal and interest, $169 property tax, and $23 homeowner\'s insurance.',
  },
  {
    question: 'How is the affordable home price in New Hampshire calculated?',
    answer:
      'Lenders use the 28/36 rule: housing costs should not exceed 28% of gross monthly income (front-end ratio), and total debts should stay under 36% (back-end ratio). We solve for the home price whose PITI equals 28% of gross, using a 7.28% 30-year fixed rate (Freddie Mac, October 2026), 20% down, New Hampshire\'s 1.50% effective property tax rate (Tax Foundation 2026), and 0.20%/year homeowner\'s insurance.',
  },
  {
    question: 'How much take-home pay does a $40,000 salary leave in New Hampshire?',
    answer:
      'A $40,000 salary in New Hampshire leaves about $34,320 per year after federal income tax, FICA, and state tax in 2026 — roughly $2,860 per month for a single filer with no pre-tax deductions. The $933 max housing payment is about 33% of that take-home pay.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: 'Salary', href: buildLocalePath(locale, 'salary') },
      { label: 'House Affordability', href: buildLocalePath(locale, 'salary/house-affordability') },
      { label: '$40,000 in New Hampshire', href: buildLocalePath(locale, 'salary/house-affordability/new-hampshire-40000') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">How Much House Can You Afford on $40,000 in New Hampshire?</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      On a <strong>$40,000</strong> salary in New Hampshire, you can afford a home priced
      around <strong>$135,500</strong> in 2026 — with a maximum monthly PITI payment of
      <strong> $933</strong> under the 28% rule. Your estimated take-home pay is
      $2,860/month.
    </p>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold">2026 affordability breakdown: $40,000 in New Hampshire</h2>
      <table class="mt-4 w-full text-sm">
        <tbody>
          <tr><td>Gross salary</td><td>$40,000</td></tr>
          <tr><td>Gross monthly income</td><td>$3,333</td></tr>
          <tr><td>Max monthly housing (28% rule)</td><td>$933</td></tr>
          <tr><td>Take-home pay (monthly)</td><td>$2,860</td></tr>
          <tr class="font-semibold"><td>Max home price</td><td>$135,500</td></tr>
          <tr><td>Down payment (20%)</td><td>$27,091</td></tr>
          <tr><td>Principal &amp; interest</td><td>$741/mo</td></tr>
          <tr><td>Property tax (1.50% effective)</td><td>$169/mo</td></tr>
          <tr><td>Homeowner's insurance</td><td>$23/mo</td></tr>
          <tr class="font-semibold"><td>Monthly PITI</td><td>$933</td></tr>
        </tbody>
      </table>
      <p class="mt-4 text-xs text-slate-500">
        Single filer, no pre-tax deductions. 30-year fixed at 7.28% (Freddie Mac PMMS, Oct 1, 2026),
        20% down, New Hampshire effective property tax 1.50% (Tax Foundation 2026), insurance 0.20%/yr.
        Figures are estimates — adjust inputs in the calculator below.
      </p>
    </div>

    <div class="mt-8">
      <InContentAd slotId="house-affordability-new-hampshire-40000" />
    </div>

    <div class="mt-8">
      <AffiliateCTA locale="en-US" />
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="$40,000 in New Hampshire: house affordability FAQs" items={faqItems} />

    <div class="mt-10">
      <h2 class="text-xl font-semibold">Customize the numbers</h2>
      <div class="mt-4">
        <HouseAffordabilityCalculator stateCode="NH" initialAnnualSalary="40000" client:load />
      </div>
    </div>

    <nav class="mt-10" aria-label="Other salaries in New Hampshire">
      <h2 class="text-xl font-semibold">Other salaries in New Hampshire</h2>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/new-hampshire-50000/">$50,000 salary in New Hampshire</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/new-hampshire-60000/">$60,000 salary in New Hampshire</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/new-hampshire-75000/">$75,000 salary in New Hampshire</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/new-hampshire-80000/">$80,000 salary in New Hampshire</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/new-hampshire-100000/">$100,000 salary in New Hampshire</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/new-hampshire-125000/">$125,000 salary in New Hampshire</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/new-hampshire-150000/">$150,000 salary in New Hampshire</a></li>
      </ul>
    </nav>

    <nav class="mt-10" aria-label="Same salary in other states">
      <h2 class="text-xl font-semibold">$40,000 salary in other states</h2>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/california-40000/">$40,000 salary in California</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/florida-40000/">$40,000 salary in Florida</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/new-york-40000/">$40,000 salary in New York</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/pennsylvania-40000/">$40,000 salary in Pennsylvania</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/illinois-40000/">$40,000 salary in Illinois</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/ohio-40000/">$40,000 salary in Ohio</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/georgia-40000/">$40,000 salary in Georgia</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/north-carolina-40000/">$40,000 salary in North Carolina</a></li>
      </ul>
    </nav>
  </article>
</BaseLayout>

---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../../components/ads/InContentAd.astro';
import AffiliateCTA from '../../../../../components/ads/AffiliateCTA.astro';
import HouseAffordabilityCalculator from '../../../../../components/islands/HouseAffordabilityCalculator';
import JsonLd from '../../../../../components/seo/JsonLd.astro';
import { getDictionary } from '../../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../../lib/seo/structuredData';

const locale = 'en-US' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'On $125,000 in Wyoming You Can Afford a ~$479,600 Home (2026) — PayRenTax',
  'A $125,000 salary in Wyoming buys a ~$479,600 home in 2026. Max monthly PITI $2,917 (28% rule) at 7.28%, 20% down. Take-home: $8,059/mo.',
  '/en-us/salary/house-affordability/wyoming-125000/',
);

const faqItems = [
  {
    question: 'How much house can I afford on a $125,000 salary in Wyoming?',
    answer:
      'On a $125,000 salary in Wyoming, you can afford a home priced around $479,600 in 2026. That assumes a 30-year fixed mortgage at 7.28%, 20% down ($95,911), and Wyoming\'s effective property tax rate of 0.53%. Your maximum monthly PITI payment would be $2,917.',
  },
  {
    question: 'What is the maximum monthly mortgage payment on $125,000 in Wyoming?',
    answer:
      'The 28% rule caps your monthly housing payment at $2,917 on a $125,000 salary ($2,917 is 28% of your $10,417 gross monthly income). That breaks down into roughly $2,625 principal and interest, $212 property tax, and $80 homeowner\'s insurance.',
  },
  {
    question: 'How is the affordable home price in Wyoming calculated?',
    answer:
      'Lenders use the 28/36 rule: housing costs should not exceed 28% of gross monthly income (front-end ratio), and total debts should stay under 36% (back-end ratio). We solve for the home price whose PITI equals 28% of gross, using a 7.28% 30-year fixed rate (Freddie Mac, October 2026), 20% down, Wyoming\'s 0.53% effective property tax rate (Tax Foundation 2026), and 0.20%/year homeowner\'s insurance.',
  },
  {
    question: 'How much take-home pay does a $125,000 salary leave in Wyoming?',
    answer:
      'A $125,000 salary in Wyoming leaves about $96,704 per year after federal income tax, FICA, and state tax in 2026 — roughly $8,059 per month for a single filer with no pre-tax deductions. The $2,917 max housing payment is about 36% of that take-home pay.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: 'Salary', href: buildLocalePath(locale, 'salary') },
      { label: 'House Affordability', href: buildLocalePath(locale, 'salary/house-affordability') },
      { label: '$125,000 in Wyoming', href: buildLocalePath(locale, 'salary/house-affordability/wyoming-125000') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">How Much House Can You Afford on $125,000 in Wyoming?</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      On a <strong>$125,000</strong> salary in Wyoming, you can afford a home priced
      around <strong>$479,600</strong> in 2026 — with a maximum monthly PITI payment of
      <strong> $2,917</strong> under the 28% rule. Your estimated take-home pay is
      $8,059/month.
    </p>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold">2026 affordability breakdown: $125,000 in Wyoming</h2>
      <table class="mt-4 w-full text-sm">
        <tbody>
          <tr><td>Gross salary</td><td>$125,000</td></tr>
          <tr><td>Gross monthly income</td><td>$10,417</td></tr>
          <tr><td>Max monthly housing (28% rule)</td><td>$2,917</td></tr>
          <tr><td>Take-home pay (monthly)</td><td>$8,059</td></tr>
          <tr class="font-semibold"><td>Max home price</td><td>$479,600</td></tr>
          <tr><td>Down payment (20%)</td><td>$95,911</td></tr>
          <tr><td>Principal &amp; interest</td><td>$2,625/mo</td></tr>
          <tr><td>Property tax (0.53% effective)</td><td>$212/mo</td></tr>
          <tr><td>Homeowner's insurance</td><td>$80/mo</td></tr>
          <tr class="font-semibold"><td>Monthly PITI</td><td>$2,917</td></tr>
        </tbody>
      </table>
      <p class="mt-4 text-xs text-slate-500">
        Single filer, no pre-tax deductions. 30-year fixed at 7.28% (Freddie Mac PMMS, Oct 1, 2026),
        20% down, Wyoming effective property tax 0.53% (Tax Foundation 2026), insurance 0.20%/yr.
        Figures are estimates — adjust inputs in the calculator below.
      </p>
    </div>

    <div class="mt-8">
      <InContentAd slotId="house-affordability-wyoming-125000" />
    </div>

    <div class="mt-8">
      <AffiliateCTA locale="en-US" />
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="$125,000 in Wyoming: house affordability FAQs" items={faqItems} />

    <div class="mt-10">
      <h2 class="text-xl font-semibold">Customize the numbers</h2>
      <div class="mt-4">
        <HouseAffordabilityCalculator stateCode="WY" initialAnnualSalary="125000" client:load />
      </div>
    </div>

    <nav class="mt-10" aria-label="Other salaries in Wyoming">
      <h2 class="text-xl font-semibold">Other salaries in Wyoming</h2>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/wyoming-40000/">$40,000 salary in Wyoming</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/wyoming-50000/">$50,000 salary in Wyoming</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/wyoming-60000/">$60,000 salary in Wyoming</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/wyoming-75000/">$75,000 salary in Wyoming</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/wyoming-80000/">$80,000 salary in Wyoming</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/wyoming-100000/">$100,000 salary in Wyoming</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/wyoming-150000/">$150,000 salary in Wyoming</a></li>
      </ul>
    </nav>

    <nav class="mt-10" aria-label="Same salary in other states">
      <h2 class="text-xl font-semibold">$125,000 salary in other states</h2>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/california-125000/">$125,000 salary in California</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/florida-125000/">$125,000 salary in Florida</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/new-york-125000/">$125,000 salary in New York</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/pennsylvania-125000/">$125,000 salary in Pennsylvania</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/illinois-125000/">$125,000 salary in Illinois</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/ohio-125000/">$125,000 salary in Ohio</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/georgia-125000/">$125,000 salary in Georgia</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/north-carolina-125000/">$125,000 salary in North Carolina</a></li>
      </ul>
    </nav>
  </article>
</BaseLayout>

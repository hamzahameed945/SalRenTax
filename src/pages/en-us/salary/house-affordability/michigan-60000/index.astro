---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../../components/ads/InContentAd.astro';
import AffiliateCTA from '../../../../../components/ads/AffiliateCTA.astro';
import HouseAffordabilityCalculator from '../../../../../components/islands/HouseAffordabilityCalculator';
import JsonLd from '../../../../../components/seo/JsonLd.astro';
import { getDictionary } from '../../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../../lib/seo/structuredData';

const locale = 'en-US' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'On $60,000 in Michigan You Can Afford a ~$211,100 Home (2026) — PayRenTax',
  'A $60,000 salary in Michigan buys a ~$211,100 home in 2026. Max monthly PITI $1,400 (28% rule) at 7.28%, 20% down. Take-home: $3,987/mo.',
  '/en-us/salary/house-affordability/michigan-60000/',
);

const faqItems = [
  {
    question: 'How much house can I afford on a $60,000 salary in Michigan?',
    answer:
      'On a $60,000 salary in Michigan, you can afford a home priced around $211,100 in 2026. That assumes a 30-year fixed mortgage at 7.28%, 20% down ($42,219), and Michigan\'s effective property tax rate of 1.19%. Your maximum monthly PITI payment would be $1,400.',
  },
  {
    question: 'What is the maximum monthly mortgage payment on $60,000 in Michigan?',
    answer:
      'The 28% rule caps your monthly housing payment at $1,400 on a $60,000 salary ($1,400 is 28% of your $5,000 gross monthly income). That breaks down into roughly $1,155 principal and interest, $209 property tax, and $35 homeowner\'s insurance.',
  },
  {
    question: 'How is the affordable home price in Michigan calculated?',
    answer:
      'Lenders use the 28/36 rule: housing costs should not exceed 28% of gross monthly income (front-end ratio), and total debts should stay under 36% (back-end ratio). We solve for the home price whose PITI equals 28% of gross, using a 7.28% 30-year fixed rate (Freddie Mac, October 2026), 20% down, Michigan\'s 1.19% effective property tax rate (Tax Foundation 2026), and 0.20%/year homeowner\'s insurance.',
  },
  {
    question: 'How much take-home pay does a $60,000 salary leave in Michigan?',
    answer:
      'A $60,000 salary in Michigan leaves about $47,840 per year after federal income tax, FICA, and state tax in 2026 — roughly $3,987 per month for a single filer with no pre-tax deductions. The $1,400 max housing payment is about 35% of that take-home pay.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: 'Salary', href: buildLocalePath(locale, 'salary') },
      { label: 'House Affordability', href: buildLocalePath(locale, 'salary/house-affordability') },
      { label: '$60,000 in Michigan', href: buildLocalePath(locale, 'salary/house-affordability/michigan-60000') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">How Much House Can You Afford on $60,000 in Michigan?</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      On a <strong>$60,000</strong> salary in Michigan, you can afford a home priced
      around <strong>$211,100</strong> in 2026 — with a maximum monthly PITI payment of
      <strong> $1,400</strong> under the 28% rule. Your estimated take-home pay is
      $3,987/month.
    </p>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold">2026 affordability breakdown: $60,000 in Michigan</h2>
      <table class="mt-4 w-full text-sm">
        <tbody>
          <tr><td>Gross salary</td><td>$60,000</td></tr>
          <tr><td>Gross monthly income</td><td>$5,000</td></tr>
          <tr><td>Max monthly housing (28% rule)</td><td>$1,400</td></tr>
          <tr><td>Take-home pay (monthly)</td><td>$3,987</td></tr>
          <tr class="font-semibold"><td>Max home price</td><td>$211,100</td></tr>
          <tr><td>Down payment (20%)</td><td>$42,219</td></tr>
          <tr><td>Principal &amp; interest</td><td>$1,155/mo</td></tr>
          <tr><td>Property tax (1.19% effective)</td><td>$209/mo</td></tr>
          <tr><td>Homeowner's insurance</td><td>$35/mo</td></tr>
          <tr class="font-semibold"><td>Monthly PITI</td><td>$1,400</td></tr>
        </tbody>
      </table>
      <p class="mt-4 text-xs text-slate-500">
        Single filer, no pre-tax deductions. 30-year fixed at 7.28% (Freddie Mac PMMS, Oct 1, 2026),
        20% down, Michigan effective property tax 1.19% (Tax Foundation 2026), insurance 0.20%/yr.
        Figures are estimates — adjust inputs in the calculator below.
      </p>
    </div>

    <div class="mt-8">
      <InContentAd slotId="house-affordability-michigan-60000" />
    </div>

    <div class="mt-8">
      <AffiliateCTA locale="en-US" />
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="$60,000 in Michigan: house affordability FAQs" items={faqItems} />

    <div class="mt-10">
      <h2 class="text-xl font-semibold">Customize the numbers</h2>
      <div class="mt-4">
        <HouseAffordabilityCalculator stateCode="MI" initialAnnualSalary="60000" client:load />
      </div>
    </div>

    <nav class="mt-10" aria-label="Other salaries in Michigan">
      <h2 class="text-xl font-semibold">Other salaries in Michigan</h2>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/michigan-40000/">$40,000 salary in Michigan</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/michigan-50000/">$50,000 salary in Michigan</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/michigan-75000/">$75,000 salary in Michigan</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/michigan-80000/">$80,000 salary in Michigan</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/michigan-100000/">$100,000 salary in Michigan</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/michigan-125000/">$125,000 salary in Michigan</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/michigan-150000/">$150,000 salary in Michigan</a></li>
      </ul>
    </nav>

    <nav class="mt-10" aria-label="Same salary in other states">
      <h2 class="text-xl font-semibold">$60,000 salary in other states</h2>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/california-60000/">$60,000 salary in California</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/florida-60000/">$60,000 salary in Florida</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/new-york-60000/">$60,000 salary in New York</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/pennsylvania-60000/">$60,000 salary in Pennsylvania</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/illinois-60000/">$60,000 salary in Illinois</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/ohio-60000/">$60,000 salary in Ohio</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/georgia-60000/">$60,000 salary in Georgia</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/salary/house-affordability/north-carolina-60000/">$60,000 salary in North Carolina</a></li>
      </ul>
    </nav>
  </article>
</BaseLayout>

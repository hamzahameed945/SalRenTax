---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../../components/ads/InContentAd.astro';
import PaycheckCalculator from '../../../../../components/islands/PaycheckCalculator';
import JsonLd from '../../../../../components/seo/JsonLd.astro';
import { getDictionary } from '../../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../../lib/seo/structuredData';

const locale = 'en-US' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  '$100,000 After Tax in New Hampshire (2026) \u2014 Take-Home Pay \u2014 PayRenTax',
  'A $100,000 salary in New Hampshire is $79,180 after tax in 2026. Federal, state & FICA breakdown inside.',
  '/en-us/states/new-hampshire-paycheck-calculator/100000/',
);

const faqItems = [
  {
    question: 'How much is $100,000 after tax in New Hampshire?',
    answer:
      'A $100,000 salary in New Hampshire leaves you $79,180 per year after federal and state taxes in 2026. That is $6,598 per month or $3,045 every two weeks, assuming a single filer with no pre-tax deductions.',
  },
  {
    question: 'What is the effective tax rate on $100,000 in New Hampshire?',
    answer:
      'The combined effective tax rate (federal income tax, FICA, and New Hampshire state tax) on a $100,000 salary in New Hampshire is 20.82%. New Hampshire has no state individual income tax, so $0 is withheld for state tax.',
  },
  {
    question: 'How much federal tax do you pay on $100,000 in New Hampshire?',
    answer:
      'Federal income tax on $100,000 for a single filer in 2026 is $13,170. Social Security takes $6,200 and Medicare $1,450. Customize the numbers with the interactive calculator below.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: 'States', href: buildLocalePath(locale, 'states') },
      {
        label: 'New Hampshire Paycheck Calculator',
        href: buildLocalePath(locale, 'states/new-hampshire-paycheck-calculator'),
      },
      { label: '$100,000 after tax', href: buildLocalePath(locale, 'states/new-hampshire-paycheck-calculator/100000') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">$100,000 After Tax in New Hampshire: 2026 Take-Home Pay</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      A <strong>$100,000</strong> salary in New Hampshire is <strong>$79,180 per year</strong> after
      federal income tax, FICA, and New Hampshire state tax in 2026 \u2014 that is $6,598/month.
    </p>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold">2026 tax breakdown: $100,000 in New Hampshire</h2>
      <table class="mt-4 w-full text-sm">
        <tbody>
          <tr><td>Gross salary</td><td>$100,000</td></tr>
          <tr><td>Federal income tax</td><td>$13,170</td></tr>
          <tr><td>Social Security (6.2%)</td><td>$6,200</td></tr>
          <tr><td>Medicare (1.45%)</td><td>$1,450</td></tr>
          <tr class="font-semibold"><td>Take-home pay</td><td>$79,180</td></tr>
        </tbody>
      </table>
      <p class="mt-4 text-xs text-slate-500">
        Single filer, no pre-tax deductions, 2026 IRS brackets and New Hampshire 2026 tax rules.
        Figures are estimates \u2014 adjust inputs in the calculator below.
      </p>
    </div>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold">Take-home per pay period</h2>
      <table class="mt-4 w-full text-sm">
        <tbody>
          <tr><td>Annual</td><td>$79,180</td></tr>
          <tr><td>Monthly</td><td>$6,598</td></tr>
          <tr><td>Biweekly</td><td>$3,045</td></tr>
          <tr><td>Weekly</td><td>$1,523</td></tr>
        </tbody>
      </table>
    </div>

    <div class="mt-8">
      <InContentAd slotId="nh-paycheck-100000" />
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="$100,000 in New Hampshire: FAQs" items={faqItems} />

    <div class="mt-10">
      <h2 class="text-xl font-semibold">Customize the numbers</h2>
      <div class="mt-4">
        <PaycheckCalculator stateCode="NH" initialAnnualSalary="100000" client:load />
      </div>
    </div>
    <nav class="mt-10" aria-label="Other salaries in New Hampshire">
      <h2 class="text-xl font-semibold">Other salaries in New Hampshire</h2>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/new-hampshire-paycheck-calculator/40000/">$40,000 after tax in New Hampshire</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/new-hampshire-paycheck-calculator/50000/">$50,000 after tax in New Hampshire</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/new-hampshire-paycheck-calculator/60000/">$60,000 after tax in New Hampshire</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/new-hampshire-paycheck-calculator/75000/">$75,000 after tax in New Hampshire</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/new-hampshire-paycheck-calculator/80000/">$80,000 after tax in New Hampshire</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/new-hampshire-paycheck-calculator/125000/">$125,000 after tax in New Hampshire</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/new-hampshire-paycheck-calculator/150000/">$150,000 after tax in New Hampshire</a></li>
      </ul>
    </nav>
  </article>
</BaseLayout>

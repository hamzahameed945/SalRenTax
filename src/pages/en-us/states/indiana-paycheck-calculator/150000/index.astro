---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../../components/seo/JsonLd.astro';
import { getDictionary } from '../../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../../lib/seo/structuredData';

const locale = 'en-US' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  '$150,000 After Tax in Indiana (2026) \u2014 Take-Home Pay \u2014 PayRenTax',
  'A $150,000 salary in Indiana is $109,366 after tax in 2026. Federal, state & FICA breakdown inside.',
  '/en-us/states/indiana-paycheck-calculator/150000/',
);

const faqItems = [
  {
    question: 'How much is $150,000 after tax in Indiana?',
    answer:
      'A $150,000 salary in Indiana leaves you $109,366 per year after federal and state taxes in 2026. That is $9,114 per month or $4,206 every two weeks, assuming a single filer with no pre-tax deductions.',
  },
  {
    question: 'What is the effective tax rate on $150,000 in Indiana?',
    answer:
      'The combined effective tax rate (federal income tax, FICA, and Indiana state tax) on a $150,000 salary in Indiana is 27.09%. Your Indiana state income tax is $4,425 for the year.',
  },
  {
    question: 'How much federal tax do you pay on $150,000 in Indiana?',
    answer:
      'Federal income tax on $150,000 for a single filer in 2026 is $24,734. Social Security takes $9,300 and Medicare $2,175. Customize the numbers with the interactive calculator below.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: 'States', href: buildLocalePath(locale, 'states') },
      {
        label: 'Indiana Paycheck Calculator',
        href: buildLocalePath(locale, 'states/indiana-paycheck-calculator'),
      },
      { label: '$150,000 after tax', href: buildLocalePath(locale, 'states/indiana-paycheck-calculator/150000') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">$150,000 After Tax in Indiana: 2026 Take-Home Pay</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      A <strong>$150,000</strong> salary in Indiana is <strong>$109,366 per year</strong> after
      federal income tax, FICA, and Indiana state tax in 2026 \u2014 that is $9,114/month.
    </p>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold">2026 tax breakdown: $150,000 in Indiana</h2>
      <table class="mt-4 w-full text-sm">
        <tbody>
          <tr><td>Gross salary</td><td>$150,000</td></tr>
          <tr><td>Federal income tax</td><td>$24,734</td></tr>
          <tr><td>Indiana income tax</td><td>$4,425</td></tr>
          <tr><td>Social Security (6.2%)</td><td>$9,300</td></tr>
          <tr><td>Medicare (1.45%)</td><td>$2,175</td></tr>
          <tr class="font-semibold"><td>Take-home pay</td><td>$109,366</td></tr>
        </tbody>
      </table>
      <p class="mt-4 text-xs text-slate-500">
        Single filer, no pre-tax deductions, 2026 IRS brackets and Indiana 2026 tax rules.
        Figures are estimates \u2014 adjust inputs in the calculator below.
      </p>
    </div>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold">Take-home per pay period</h2>
      <table class="mt-4 w-full text-sm">
        <tbody>
          <tr><td>Annual</td><td>$109,366</td></tr>
          <tr><td>Monthly</td><td>$9,114</td></tr>
          <tr><td>Biweekly</td><td>$4,206</td></tr>
          <tr><td>Weekly</td><td>$2,103</td></tr>
        </tbody>
      </table>
    </div>

    <div class="mt-8">
      <InContentAd slotId="in-paycheck-150000" />
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="$150,000 in Indiana: FAQs" items={faqItems} />
  </article>
</BaseLayout>

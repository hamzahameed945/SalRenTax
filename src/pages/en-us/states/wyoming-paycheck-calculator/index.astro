---
import CalculatorResource from '../../../../components/content/CalculatorResource.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import PaycheckCalculator from '../../../../components/islands/PaycheckCalculator';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'en-US' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'Wyoming Paycheck Calculator 2026 \u2014 WY Take-Home Pay \u2014 PayRenTax',
  'Estimate your Wyoming take-home pay for 2026. Wyoming has no state individual income tax.',
  '/en-us/states/wyoming-paycheck-calculator/',
);

const faqItems = [
  {
    question: 'Does Wyoming have a state income tax?',
    answer:
      'No. Wyoming does not levy an individual income tax on wage income. You only pay federal income tax and FICA contributions on your paycheck.',
  },
  {
    question: 'What is the Wyoming income tax rate for 2026?',
    answer:
      'Wyoming has a 0% individual income tax rate — there is no state tax on wages, salaries, or tips.',
  },
  {
    question: 'What taxes are withheld from a Wyoming paycheck?',
    answer:
      'Federal income tax (10%–37%), Social Security (6.2% up to $176,100), and Medicare (1.45%). No Wyoming state income tax is withheld.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: 'States', href: buildLocalePath(locale, 'states') },
      {
        label: 'Wyoming Paycheck Calculator',
        href: buildLocalePath(locale, 'states/wyoming-paycheck-calculator'),
      },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">Wyoming Paycheck Calculator 2026</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      Estimate your Wyoming take-home pay for 2026 and see how state and federal payroll
      deductions affect your paycheck.
    </p>

    <div class="mt-4 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
      ✅ <strong>No Wyoming state income tax.</strong> Only federal taxes (IRS 2026 brackets) and FICA
      apply.
    </div>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <PaycheckCalculator stateCode="WY" client:load />
    </div>

    <div class="mt-8">
      <InContentAd slotId="wy-paycheck-1" />
    </div>

    <div class="mt-10 prose prose-slate max-w-none">
      <h2>Wyoming Paycheck & Tax Overview 2026</h2>
      <p>
        Wyoming workers keep more of each paycheck because the state levies no individual income
        tax on wages. Your 2026 payroll deductions are federal only:
      </p>
      <ul>
        <li>
          <strong>Federal income tax</strong> (IRS 2026 brackets: 10%, 12%, 22%, 24%, 32%, 35%, 37%)
        </li>
        <li>
          <strong>Social Security FICA:</strong> 6.2% on wages up to $176,100
        </li>
        <li>
          <strong>Medicare FICA:</strong> 1.45% (+ 0.9% above $200,000 single/$250,000 MFJ)
        </li>
      </ul>

    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="Wyoming Paycheck FAQs" items={faqItems} />
    <nav class="mt-10" aria-label="Popular salaries in Wyoming">
      <h2 class="text-xl font-semibold">Popular salaries in Wyoming</h2>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/wyoming-paycheck-calculator/40000/">$40,000 after tax in Wyoming</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/wyoming-paycheck-calculator/50000/">$50,000 after tax in Wyoming</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/wyoming-paycheck-calculator/60000/">$60,000 after tax in Wyoming</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/wyoming-paycheck-calculator/75000/">$75,000 after tax in Wyoming</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/wyoming-paycheck-calculator/80000/">$80,000 after tax in Wyoming</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/wyoming-paycheck-calculator/100000/">$100,000 after tax in Wyoming</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/wyoming-paycheck-calculator/125000/">$125,000 after tax in Wyoming</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/wyoming-paycheck-calculator/150000/">$150,000 after tax in Wyoming</a></li>
      </ul>
    </nav>
  </article>
  <CalculatorResource locale="en-US" category="states" />
</BaseLayout>

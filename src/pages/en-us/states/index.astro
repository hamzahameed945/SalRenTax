---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/navigation/Breadcrumbs.astro';
import { getDictionary } from '../../../i18n/dictionaries';
import { getActivePagesForLocale } from '../../../seo/page-registry';
import { buildPageMetadata } from '../../../lib/seo/metadata';
import { buildLocalePath } from '../../../i18n/utils';

const locale = 'en-US' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'US State Paycheck Calculators 2026 — SalRenTax',
  'Calculate your take-home pay for Florida, Texas, New York, Arizona, and more US states for 2026.',
  '/en-us/states/',
);
const statePages = getActivePagesForLocale(locale).filter((p) => p.category === 'states' && p.pageType === 'calculator');
---

<BaseLayout locale={locale} title={meta.title} description={meta.description} canonical={meta.canonical}>
  <Breadcrumbs locale={locale} trail={[{ label: 'States', href: buildLocalePath(locale, 'states') }]} />
  <section class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">US State Paycheck Calculators 2026</h1>
    <p class="mt-3 text-slate-600">
      Calculate your take-home pay by state. Paycheck deductions vary by state — some have no income tax at all.
    </p>
    <ul class="mt-8 space-y-3">
      {statePages.map((page) => (
        <li class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm hover:border-accent transition-colors">
          <a href={buildLocalePath(locale, page.slug)} class="font-semibold text-accent hover:underline">
            {page.primaryKeyword}
          </a>
          <p class="mt-1 text-sm text-slate-500">{page.secondaryKeywords.slice(0, 2).join(' · ')}</p>
        </li>
      ))}
    </ul>

    <div class="mt-10 prose prose-slate max-w-none">
      <h2>State Income Tax Overview 2026</h2>
      <table>
        <thead><tr><th>State</th><th>State Income Tax</th><th>Local Tax</th></tr></thead>
        <tbody>
          <tr><td>Florida</td><td>None ✅</td><td>None</td></tr>
          <tr><td>Texas</td><td>None ✅</td><td>None</td></tr>
          <tr><td>Arizona</td><td>2.5% flat</td><td>None</td></tr>
          <tr><td>New York</td><td>4%–10.9%</td><td>NYC: 3.1%–3.9%</td></tr>
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>

---
import CategoryResource from '../../../components/content/CategoryResource.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/navigation/Breadcrumbs.astro';
import { getActivePagesForLocale } from '../../../seo/page-registry';
import { buildPageMetadata } from '../../../lib/seo/metadata';
import { buildLocalePath } from '../../../i18n/utils';

const locale = 'en-US' as const;
const meta = buildPageMetadata(
  'US State Paycheck Calculators 2026 — PayRenTax',
  'Estimate your take-home pay for supported US states. Your paycheck can look different from one state to another because state and local taxes vary.',
  '/en-us/states/',
);
const statePages = getActivePagesForLocale(locale).filter(
  (p) => p.category === 'states' && p.pageType === 'calculator',
);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <Breadcrumbs
    locale={locale}
    trail={[{ label: 'States', href: buildLocalePath(locale, 'states') }]}
  />
  <section class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">US State Paycheck Calculators 2026</h1>
    <p class="mt-3 text-slate-600">
      Estimate your take-home pay for supported US states. Your paycheck can look different from
      one state to another because state and local taxes vary.
    </p>
    <ul class="mt-8 space-y-3">
      {statePages.map((page) => (
        <li class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm hover:border-accent transition-colors">
          <a
            href={buildLocalePath(locale, page.slug)}
            class="font-semibold text-accent hover:underline"
          >
            {page.primaryKeyword}
          </a>
          <p class="mt-1 text-sm text-slate-500">
            {page.secondaryKeywords.slice(0, 2).join(' · ')}
          </p>
        </li>
      ))}
    </ul>

    <div class="mt-10 prose prose-slate max-w-none">
      <h2>State Income Tax Overview for 2026</h2>
      <p>
        The table below shows the state income-tax treatment currently modeled by the available
        calculators. Local taxes and other payroll details may not be included on every page, so
        check the individual state calculator for its assumptions.
      </p>
      <table>
        <thead>
          <tr>
            <th>State</th>
            <th>State Income Tax</th>
            <th>Local Tax</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Florida</td>
            <td>No state individual income tax</td>
            <td>No local income tax modeled</td>
          </tr>
          <tr>
            <td>Texas</td>
            <td>No state individual income tax</td>
            <td>No local income tax modeled</td>
          </tr>
          <tr>
            <td>Arizona</td>
            <td>2.5% flat state income tax</td>
            <td>No local income tax modeled</td>
          </tr>
          <tr>
            <td>Illinois</td>
            <td>4.95% flat state income tax</td>
            <td>Local tax not modeled</td>
          </tr>
          <tr>
            <td>New York</td>
            <td>4%–10.9% state income tax</td>
            <td>NYC: 3.1%–3.9% (not modeled by the calculator)</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
  <CategoryResource locale="en-US" category="states" />
</BaseLayout>

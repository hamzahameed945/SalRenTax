---
import CalculatorResource from '../../../../components/content/CalculatorResource.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import PaycheckCalculator from '../../../../components/islands/PaycheckCalculator';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'en-US' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'Arizona Paycheck Calculator 2026 — AZ Take-Home Pay — PayRenTax',
  'Estimate your Arizona take-home pay for 2026 using the state\'s 2.5% flat individual income-tax rate and the federal deductions modeled by the calculator.',
  '/en-us/states/arizona-paycheck-calculator/',
);

const faqItems = [
  {
    question: "What is Arizona's state income tax rate?",
    answer:
      'Arizona implemented a flat 2.5% state income tax rate, effective from 2023, replacing the previous multi-bracket system. This is one of the lowest flat state income tax rates in the US.',
  },
  {
    question: 'How is Arizona paycheck tax calculated?',
    answer:
      'Arizona withholding is based on the flat 2.5% state rate plus federal income tax and FICA. The calculator includes an estimated Arizona state income tax together with federal income tax and FICA.',
  },
  {
    question: 'Does Arizona have local income taxes?',
    answer:
      'No. Arizona cities do not impose local income taxes on wages. The only income taxes applicable are federal and the state flat rate of 2.5%.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: 'States', href: buildLocalePath(locale, 'states') },
      {
        label: 'Arizona Paycheck Calculator',
        href: buildLocalePath(locale, 'states/arizona-paycheck-calculator'),
      },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">Arizona Paycheck Calculator 2026</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      Estimate your Arizona take-home pay for 2026 using the state's{' '}
      <strong>2.5% flat individual income-tax rate</strong> and the federal deductions modeled by
      the calculator.
    </p>

    <div class="mt-4 rounded-lg border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-blue-800">
      ℹ <strong>Arizona flat tax:</strong> 2.5% state income tax applies to all income levels. The
      calculator below includes an estimated Arizona state tax based on taxable income after the
      modeled standard deduction.
    </div>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <PaycheckCalculator stateCode="AZ" client:load />
    </div>

    <div class="mt-8">
      <InContentAd slotId="az-paycheck-1" />
    </div>

    <div class="mt-10 prose prose-slate max-w-none">
      <h2>Arizona Tax Guide 2026</h2>
      <table>
        <thead>
          <tr>
            <th>Tax</th>
            <th>Rate</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Federal income tax</td>
            <td>10%–37% (2026 brackets)</td>
          </tr>
          <tr>
            <td>Arizona state income tax</td>
            <td>2.5% (flat)</td>
          </tr>
          <tr>
            <td>Social Security</td>
            <td>6.2% (up to $176,100)</td>
          </tr>
          <tr>
            <td>Medicare</td>
            <td>1.45% (+0.9% above $200k)</td>
          </tr>
          <tr>
            <td>Local income tax</td>
            <td>None</td>
          </tr>
        </tbody>
      </table>
      <p>
        Arizona's flat 2.5% rate means everyone pays the same percentage regardless of income — a
        significant reduction from the old 4.5% top rate prior to 2023.
      </p>
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="Arizona Paycheck FAQs" items={faqItems} />
  </article>
  <CalculatorResource locale="en-US" category="states" />
</BaseLayout>

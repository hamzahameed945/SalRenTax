---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../../components/ads/InContentAd.astro';
import AffiliateCTA from '../../../../../components/ads/AffiliateCTA.astro';
import PaycheckCalculator from '../../../../../components/islands/PaycheckCalculator';
import JsonLd from '../../../../../components/seo/JsonLd.astro';
import { getDictionary } from '../../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../../lib/seo/structuredData';

const locale = 'en-US' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  '$60,000 After Tax in Connecticut (2026) \u2014 Take-Home Pay \u2014 PayRenTax',
  'A $60,000 salary in Connecticut is $47,840 after tax in 2026. Federal, state & FICA breakdown inside.',
  '/en-us/states/connecticut-paycheck-calculator/60000/',
);

const faqItems = [
  {
    question: 'How much is $60,000 after tax in Connecticut?',
    answer:
      'A $60,000 salary in Connecticut leaves you $47,840 per year after federal and state taxes in 2026. That is $3,987 per month or $1,840 every two weeks, assuming a single filer with no pre-tax deductions.',
  },
  {
    question: 'What is the effective tax rate on $60,000 in Connecticut?',
    answer:
      'The combined effective tax rate (federal income tax, FICA, and Connecticut state tax) on a $60,000 salary in Connecticut is 20.27%. Your Connecticut state income tax is $2,550 for the year.',
  },
  {
    question: 'How much federal tax do you pay on $60,000 in Connecticut?',
    answer:
      'Federal income tax on $60,000 for a single filer in 2026 is $5,020. Social Security takes $3,720 and Medicare $870. Customize the numbers with the interactive calculator below.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: 'States', href: buildLocalePath(locale, 'states') },
      {
        label: 'Connecticut Paycheck Calculator',
        href: buildLocalePath(locale, 'states/connecticut-paycheck-calculator'),
      },
      { label: '$60,000 after tax', href: buildLocalePath(locale, 'states/connecticut-paycheck-calculator/60000') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">$60,000 After Tax in Connecticut: 2026 Take-Home Pay</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      A <strong>$60,000</strong> salary in Connecticut is <strong>$47,840 per year</strong> after
      federal income tax, FICA, and Connecticut state tax in 2026 \u2014 that is $3,987/month.
    </p>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold">2026 tax breakdown: $60,000 in Connecticut</h2>
      <table class="mt-4 w-full text-sm">
        <tbody>
          <tr><td>Gross salary</td><td>$60,000</td></tr>
          <tr><td>Federal income tax</td><td>$5,020</td></tr>
          <tr><td>Connecticut income tax</td><td>$2,550</td></tr>
          <tr><td>Social Security (6.2%)</td><td>$3,720</td></tr>
          <tr><td>Medicare (1.45%)</td><td>$870</td></tr>
          <tr class="font-semibold"><td>Take-home pay</td><td>$47,840</td></tr>
        </tbody>
      </table>
      <p class="mt-4 text-xs text-slate-500">
        Single filer, no pre-tax deductions, 2026 IRS brackets and Connecticut 2026 tax rules.
        Figures are estimates \u2014 adjust inputs in the calculator below.
      </p>
    </div>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold">Take-home per pay period</h2>
      <table class="mt-4 w-full text-sm">
        <tbody>
          <tr><td>Annual</td><td>$47,840</td></tr>
          <tr><td>Monthly</td><td>$3,987</td></tr>
          <tr><td>Biweekly</td><td>$1,840</td></tr>
          <tr><td>Weekly</td><td>$920</td></tr>
        </tbody>
      </table>
    </div>

    <div class="mt-8">
      <InContentAd slotId="ct-paycheck-60000" />
    </div>

    <div class="mt-8">
      <AffiliateCTA locale="en-US" />
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="$60,000 in Connecticut: FAQs" items={faqItems} />

    <div class="mt-10">
      <h2 class="text-xl font-semibold">Customize the numbers</h2>
      <div class="mt-4">
        <PaycheckCalculator stateCode="CT" initialAnnualSalary="60000" client:load />
      </div>
    </div>
    <nav class="mt-10" aria-label="Other salaries in Connecticut">
      <h2 class="text-xl font-semibold">Other salaries in Connecticut</h2>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/connecticut-paycheck-calculator/40000/">$40,000 after tax in Connecticut</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/connecticut-paycheck-calculator/50000/">$50,000 after tax in Connecticut</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/connecticut-paycheck-calculator/75000/">$75,000 after tax in Connecticut</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/connecticut-paycheck-calculator/80000/">$80,000 after tax in Connecticut</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/connecticut-paycheck-calculator/100000/">$100,000 after tax in Connecticut</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/connecticut-paycheck-calculator/125000/">$125,000 after tax in Connecticut</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/connecticut-paycheck-calculator/150000/">$150,000 after tax in Connecticut</a></li>
      </ul>
    </nav>
  </article>
</BaseLayout>

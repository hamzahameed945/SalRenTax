---
import CalculatorResource from '../../../../components/content/CalculatorResource.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import PaycheckCalculator from '../../../../components/islands/PaycheckCalculator';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'en-US' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'Connecticut Paycheck Calculator 2026 \u2014 CT Take-Home Pay \u2014 PayRenTax',
  'Estimate your Connecticut take-home pay for 2026 with the state’s graduated income tax of 2% to 6.99% plus federal deductions.',
  '/en-us/states/connecticut-paycheck-calculator/',
);

const faqItems = [
  {
    question: 'Does Connecticut have a state income tax?',
    answer:
      'Yes. Connecticut levies a graduated income tax of 2% to 6.99% on taxable income.',
  },
  {
    question: 'What are the Connecticut income tax brackets for 2026?',
    answer:
      'For single filers, Connecticut’s 2026 rates run from 2% to 6.99%. See the bracket table above for the full schedule.',
  },
  {
    question: 'What taxes are withheld from a Connecticut paycheck?',
    answer:
      'Federal income tax (10%–37%), Social Security (6.2% up to $176,100), Medicare (1.45%), and Connecticut state income tax.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: 'States', href: buildLocalePath(locale, 'states') },
      {
        label: 'Connecticut Paycheck Calculator',
        href: buildLocalePath(locale, 'states/connecticut-paycheck-calculator'),
      },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">Connecticut Paycheck Calculator 2026</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      Estimate your Connecticut take-home pay for 2026 and see how state and federal payroll
      deductions affect your paycheck.
    </p>

    <div class="mt-4 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
      📊 <strong>Connecticut graduated tax: up to 6.99%.</strong> Higher earnings are taxed at
      higher marginal rates.
    </div>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <PaycheckCalculator stateCode="CT" client:load />
    </div>

    <div class="mt-8">
      <InContentAd slotId="ct-paycheck-1" />
    </div>

    <div class="mt-10 prose prose-slate max-w-none">
      <h2>Connecticut Paycheck & Tax Overview 2026</h2>
      <p>
        Connecticut has a graduated income tax of 2% to 6.99%. Your 2026 payroll deductions are:
      </p>
      <ul>
        <li>
          <strong>Connecticut income tax:</strong> graduated income tax of 2% to 6.99% (single filer, 2026)
        </li>        <li>
          <strong>Federal income tax</strong> (IRS 2026 brackets: 10%, 12%, 22%, 24%, 32%, 35%, 37%)
        </li>
        <li>
          <strong>Social Security FICA:</strong> 6.2% on wages up to $176,100
        </li>
        <li>
          <strong>Medicare FICA:</strong> 1.45% (+ 0.9% above $200,000 single/$250,000 MFJ)
        </li>
      </ul>
      <h3>Connecticut 2026 tax brackets (single filer)</h3>
      <table>
        <thead><tr><th>Taxable income</th><th>Rate</th></tr></thead>
        <tbody>
          <tr><td>$0 – $10,000</td><td>2%</td></tr>
          <tr><td>$10,000 – $50,000</td><td>4.5%</td></tr>
          <tr><td>$50,000 – $100,000</td><td>5.5%</td></tr>
          <tr><td>$100,000 – $200,000</td><td>6%</td></tr>
          <tr><td>$200,000 – $250,000</td><td>6.5%</td></tr>
          <tr><td>$250,000 – $500,000</td><td>6.9%</td></tr>
          <tr><td>$500,000 – $and up</td><td>6.99%</td></tr>
        </tbody>
      </table>
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="Connecticut Paycheck FAQs" items={faqItems} />
  </article>
  <CalculatorResource locale="en-US" category="states" />
</BaseLayout>

---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../../components/seo/JsonLd.astro';
import { getDictionary } from '../../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../../lib/seo/structuredData';

const locale = 'en-US' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  '$60,000 After Tax in Alabama (2026) \u2014 Take-Home Pay \u2014 PayRenTax',
  'A $60,000 salary in Alabama is $47,580 after tax in 2026. Federal, state & FICA breakdown inside.',
  '/en-us/states/alabama-paycheck-calculator/60000/',
);

const faqItems = [
  {
    question: 'How much is $60,000 after tax in Alabama?',
    answer:
      'A $60,000 salary in Alabama leaves you $47,580 per year after federal and state taxes in 2026. That is $3,965 per month or $1,830 every two weeks, assuming a single filer with no pre-tax deductions.',
  },
  {
    question: 'What is the effective tax rate on $60,000 in Alabama?',
    answer:
      'The combined effective tax rate (federal income tax, FICA, and Alabama state tax) on a $60,000 salary in Alabama is 20.7%. Your Alabama state income tax is $2,810 for the year.',
  },
  {
    question: 'How much federal tax do you pay on $60,000 in Alabama?',
    answer:
      'Federal income tax on $60,000 for a single filer in 2026 is $5,020. Social Security takes $3,720 and Medicare $870. Customize the numbers with the interactive calculator below.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: 'States', href: buildLocalePath(locale, 'states') },
      {
        label: 'Alabama Paycheck Calculator',
        href: buildLocalePath(locale, 'states/alabama-paycheck-calculator'),
      },
      { label: '$60,000 after tax', href: buildLocalePath(locale, 'states/alabama-paycheck-calculator/60000') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">$60,000 After Tax in Alabama: 2026 Take-Home Pay</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      A <strong>$60,000</strong> salary in Alabama is <strong>$47,580 per year</strong> after
      federal income tax, FICA, and Alabama state tax in 2026 \u2014 that is $3,965/month.
    </p>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold">2026 tax breakdown: $60,000 in Alabama</h2>
      <table class="mt-4 w-full text-sm">
        <tbody>
          <tr><td>Gross salary</td><td>$60,000</td></tr>
          <tr><td>Federal income tax</td><td>$5,020</td></tr>
          <tr><td>Alabama income tax</td><td>$2,810</td></tr>
          <tr><td>Social Security (6.2%)</td><td>$3,720</td></tr>
          <tr><td>Medicare (1.45%)</td><td>$870</td></tr>
          <tr class="font-semibold"><td>Take-home pay</td><td>$47,580</td></tr>
        </tbody>
      </table>
      <p class="mt-4 text-xs text-slate-500">
        Single filer, no pre-tax deductions, 2026 IRS brackets and Alabama 2026 tax rules.
        Figures are estimates \u2014 adjust inputs in the calculator below.
      </p>
    </div>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold">Take-home per pay period</h2>
      <table class="mt-4 w-full text-sm">
        <tbody>
          <tr><td>Annual</td><td>$47,580</td></tr>
          <tr><td>Monthly</td><td>$3,965</td></tr>
          <tr><td>Biweekly</td><td>$1,830</td></tr>
          <tr><td>Weekly</td><td>$915</td></tr>
        </tbody>
      </table>
    </div>

    <div class="mt-8">
      <InContentAd slotId="al-paycheck-60000" />
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="$60,000 in Alabama: FAQs" items={faqItems} />
  </article>
</BaseLayout>

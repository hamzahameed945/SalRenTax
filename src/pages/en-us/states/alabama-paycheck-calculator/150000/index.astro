---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../../components/ads/InContentAd.astro';
import PaycheckCalculator from '../../../../../components/islands/PaycheckCalculator';
import JsonLd from '../../../../../components/seo/JsonLd.astro';
import { getDictionary } from '../../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../../lib/seo/structuredData';

const locale = 'en-US' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  '$150,000 After Tax in Alabama (2026) \u2014 Take-Home Pay \u2014 PayRenTax',
  'A $150,000 salary in Alabama is $106,481 after tax in 2026. Federal, state & FICA breakdown inside.',
  '/en-us/states/alabama-paycheck-calculator/150000/',
);

const faqItems = [
  {
    question: 'How much is $150,000 after tax in Alabama?',
    answer:
      'A $150,000 salary in Alabama leaves you $106,481 per year after federal and state taxes in 2026. That is $8,873 per month or $4,095 every two weeks, assuming a single filer with no pre-tax deductions.',
  },
  {
    question: 'What is the effective tax rate on $150,000 in Alabama?',
    answer:
      'The combined effective tax rate (federal income tax, FICA, and Alabama state tax) on a $150,000 salary in Alabama is 29.01%. Your Alabama state income tax is $7,310 for the year.',
  },
  {
    question: 'How much federal tax do you pay on $150,000 in Alabama?',
    answer:
      'Federal income tax on $150,000 for a single filer in 2026 is $24,734. Social Security takes $9,300 and Medicare $2,175. Customize the numbers with the interactive calculator below.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: 'States', href: buildLocalePath(locale, 'states') },
      {
        label: 'Alabama Paycheck Calculator',
        href: buildLocalePath(locale, 'states/alabama-paycheck-calculator'),
      },
      { label: '$150,000 after tax', href: buildLocalePath(locale, 'states/alabama-paycheck-calculator/150000') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">$150,000 After Tax in Alabama: 2026 Take-Home Pay</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      A <strong>$150,000</strong> salary in Alabama is <strong>$106,481 per year</strong> after
      federal income tax, FICA, and Alabama state tax in 2026 \u2014 that is $8,873/month.
    </p>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold">2026 tax breakdown: $150,000 in Alabama</h2>
      <table class="mt-4 w-full text-sm">
        <tbody>
          <tr><td>Gross salary</td><td>$150,000</td></tr>
          <tr><td>Federal income tax</td><td>$24,734</td></tr>
          <tr><td>Alabama income tax</td><td>$7,310</td></tr>
          <tr><td>Social Security (6.2%)</td><td>$9,300</td></tr>
          <tr><td>Medicare (1.45%)</td><td>$2,175</td></tr>
          <tr class="font-semibold"><td>Take-home pay</td><td>$106,481</td></tr>
        </tbody>
      </table>
      <p class="mt-4 text-xs text-slate-500">
        Single filer, no pre-tax deductions, 2026 IRS brackets and Alabama 2026 tax rules.
        Figures are estimates \u2014 adjust inputs in the calculator below.
      </p>
    </div>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold">Take-home per pay period</h2>
      <table class="mt-4 w-full text-sm">
        <tbody>
          <tr><td>Annual</td><td>$106,481</td></tr>
          <tr><td>Monthly</td><td>$8,873</td></tr>
          <tr><td>Biweekly</td><td>$4,095</td></tr>
          <tr><td>Weekly</td><td>$2,048</td></tr>
        </tbody>
      </table>
    </div>

    <div class="mt-8">
      <InContentAd slotId="al-paycheck-150000" />
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="$150,000 in Alabama: FAQs" items={faqItems} />

    <div class="mt-10">
      <h2 class="text-xl font-semibold">Customize the numbers</h2>
      <div class="mt-4">
        <PaycheckCalculator stateCode="AL" initialAnnualSalary="150000" client:load />
      </div>
    </div>
    <nav class="mt-10" aria-label="Other salaries in Alabama">
      <h2 class="text-xl font-semibold">Other salaries in Alabama</h2>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/alabama-paycheck-calculator/40000/">$40,000 after tax in Alabama</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/alabama-paycheck-calculator/50000/">$50,000 after tax in Alabama</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/alabama-paycheck-calculator/60000/">$60,000 after tax in Alabama</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/alabama-paycheck-calculator/75000/">$75,000 after tax in Alabama</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/alabama-paycheck-calculator/80000/">$80,000 after tax in Alabama</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/alabama-paycheck-calculator/100000/">$100,000 after tax in Alabama</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/alabama-paycheck-calculator/125000/">$125,000 after tax in Alabama</a></li>
      </ul>
    </nav>
  </article>
</BaseLayout>

---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../../components/seo/JsonLd.astro';
import { getDictionary } from '../../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../../lib/seo/structuredData';

const locale = 'en-US' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  '$40,000 After Tax in Maryland (2026) \u2014 Take-Home Pay \u2014 PayRenTax',
  'A $40,000 salary in Maryland is $32,632 after tax in 2026. Federal, state & FICA breakdown inside.',
  '/en-us/states/maryland-paycheck-calculator/40000/',
);

const faqItems = [
  {
    question: 'How much is $40,000 after tax in Maryland?',
    answer:
      'A $40,000 salary in Maryland leaves you $32,632 per year after federal and state taxes in 2026. That is $2,719 per month or $1,255 every two weeks, assuming a single filer with no pre-tax deductions.',
  },
  {
    question: 'What is the effective tax rate on $40,000 in Maryland?',
    answer:
      'The combined effective tax rate (federal income tax, FICA, and Maryland state tax) on a $40,000 salary in Maryland is 18.42%. Your Maryland state income tax is $1,688 for the year.',
  },
  {
    question: 'How much federal tax do you pay on $40,000 in Maryland?',
    answer:
      'Federal income tax on $40,000 for a single filer in 2026 is $2,620. Social Security takes $2,480 and Medicare $580. Customize the numbers with the interactive calculator below.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: 'States', href: buildLocalePath(locale, 'states') },
      {
        label: 'Maryland Paycheck Calculator',
        href: buildLocalePath(locale, 'states/maryland-paycheck-calculator'),
      },
      { label: '$40,000 after tax', href: buildLocalePath(locale, 'states/maryland-paycheck-calculator/40000') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">$40,000 After Tax in Maryland: 2026 Take-Home Pay</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      A <strong>$40,000</strong> salary in Maryland is <strong>$32,632 per year</strong> after
      federal income tax, FICA, and Maryland state tax in 2026 \u2014 that is $2,719/month.
    </p>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold">2026 tax breakdown: $40,000 in Maryland</h2>
      <table class="mt-4 w-full text-sm">
        <tbody>
          <tr><td>Gross salary</td><td>$40,000</td></tr>
          <tr><td>Federal income tax</td><td>$2,620</td></tr>
          <tr><td>Maryland income tax</td><td>$1,688</td></tr>
          <tr><td>Social Security (6.2%)</td><td>$2,480</td></tr>
          <tr><td>Medicare (1.45%)</td><td>$580</td></tr>
          <tr class="font-semibold"><td>Take-home pay</td><td>$32,632</td></tr>
        </tbody>
      </table>
      <p class="mt-4 text-xs text-slate-500">
        Single filer, no pre-tax deductions, 2026 IRS brackets and Maryland 2026 tax rules.
        Figures are estimates \u2014 adjust inputs in the calculator below.
      </p>
    </div>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold">Take-home per pay period</h2>
      <table class="mt-4 w-full text-sm">
        <tbody>
          <tr><td>Annual</td><td>$32,632</td></tr>
          <tr><td>Monthly</td><td>$2,719</td></tr>
          <tr><td>Biweekly</td><td>$1,255</td></tr>
          <tr><td>Weekly</td><td>$628</td></tr>
        </tbody>
      </table>
    </div>

    <div class="mt-8">
      <InContentAd slotId="md-paycheck-40000" />
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="$40,000 in Maryland: FAQs" items={faqItems} />
  </article>
</BaseLayout>

---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../../components/ads/InContentAd.astro';
import PaycheckCalculator from '../../../../../components/islands/PaycheckCalculator';
import JsonLd from '../../../../../components/seo/JsonLd.astro';
import { getDictionary } from '../../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../../lib/seo/structuredData';

const locale = 'en-US' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  '$50,000 After Tax in New York (2026) \u2014 Take-Home Pay \u2014 PayRenTax',
  'A $50,000 salary in New York is $40,252 after tax in 2026. Federal, state & FICA breakdown inside.',
  '/en-us/states/new-york-paycheck-calculator/50000/',
);

const faqItems = [
  {
    question: 'How much is $50,000 after tax in New York?',
    answer:
      'A $50,000 salary in New York leaves you $40,252 per year after federal and state taxes in 2026. That is $3,354 per month or $1,548 every two weeks, assuming a single filer with no pre-tax deductions.',
  },
  {
    question: 'What is the effective tax rate on $50,000 in New York?',
    answer:
      'The combined effective tax rate (federal income tax, FICA, and New York state tax) on a $50,000 salary in New York is 19.5%. Your New York state income tax is $2,103 for the year.',
  },
  {
    question: 'How much federal tax do you pay on $50,000 in New York?',
    answer:
      'Federal income tax on $50,000 for a single filer in 2026 is $3,820. Social Security takes $3,100 and Medicare $725. Customize the numbers with the interactive calculator below.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: 'States', href: buildLocalePath(locale, 'states') },
      {
        label: 'New York Paycheck Calculator',
        href: buildLocalePath(locale, 'states/new-york-paycheck-calculator'),
      },
      { label: '$50,000 after tax', href: buildLocalePath(locale, 'states/new-york-paycheck-calculator/50000') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">$50,000 After Tax in New York: 2026 Take-Home Pay</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      A <strong>$50,000</strong> salary in New York is <strong>$40,252 per year</strong> after
      federal income tax, FICA, and New York state tax in 2026 \u2014 that is $3,354/month.
    </p>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold">2026 tax breakdown: $50,000 in New York</h2>
      <table class="mt-4 w-full text-sm">
        <tbody>
          <tr><td>Gross salary</td><td>$50,000</td></tr>
          <tr><td>Federal income tax</td><td>$3,820</td></tr>
          <tr><td>New York income tax</td><td>$2,103</td></tr>
          <tr><td>Social Security (6.2%)</td><td>$3,100</td></tr>
          <tr><td>Medicare (1.45%)</td><td>$725</td></tr>
          <tr class="font-semibold"><td>Take-home pay</td><td>$40,252</td></tr>
        </tbody>
      </table>
      <p class="mt-4 text-xs text-slate-500">
        Single filer, no pre-tax deductions, 2026 IRS brackets and New York 2026 tax rules.
        Figures are estimates \u2014 adjust inputs in the calculator below.
      </p>
    </div>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold">Take-home per pay period</h2>
      <table class="mt-4 w-full text-sm">
        <tbody>
          <tr><td>Annual</td><td>$40,252</td></tr>
          <tr><td>Monthly</td><td>$3,354</td></tr>
          <tr><td>Biweekly</td><td>$1,548</td></tr>
          <tr><td>Weekly</td><td>$774</td></tr>
        </tbody>
      </table>
    </div>

    <div class="mt-8">
      <InContentAd slotId="ny-paycheck-50000" />
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="$50,000 in New York: FAQs" items={faqItems} />

    <div class="mt-10">
      <h2 class="text-xl font-semibold">Customize the numbers</h2>
      <div class="mt-4">
        <PaycheckCalculator stateCode="NY" initialAnnualSalary="50000" client:load />
      </div>
    </div>
  </article>
</BaseLayout>

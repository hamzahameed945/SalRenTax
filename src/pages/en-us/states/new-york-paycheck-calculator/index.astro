---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import PaycheckCalculator from '../../../../components/islands/PaycheckCalculator';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'en-US' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'New York Paycheck Calculator 2026 — NY Take-Home Pay — SalRenTax',
  'Calculate your New York take-home pay for 2026. Includes federal income tax and FICA. NY state/NYC taxes shown separately.',
  '/en-us/states/new-york-paycheck-calculator/',
);

const faqItems = [
  {
    question: 'What is the New York state income tax rate?',
    answer: 'New York state income tax ranges from 4% to 10.9% across 10 brackets. NYC residents also pay an additional 3.078%–3.876% NYC income tax. This calculator currently shows federal tax only.',
  },
  {
    question: 'How much tax do New York residents pay?',
    answer: 'New York has some of the highest combined state and local taxes in the US. A typical NYC resident earning $100,000 might pay an additional $10,000–$13,000 in state and city taxes beyond federal obligations.',
  },
  {
    question: 'Does this calculator include NY state tax?',
    answer: 'Currently, this calculator shows federal income tax and FICA only. Full New York state and NYC tax support is planned for a future update once the NY bracket data is fully verified.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout locale={locale} title={meta.title} description={meta.description} canonical={meta.canonical}>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: 'States', href: buildLocalePath(locale, 'states') },
      { label: 'New York Paycheck Calculator', href: buildLocalePath(locale, 'states/new-york-paycheck-calculator') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">New York Paycheck Calculator 2026</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      Estimate your New York take-home pay for 2026. This calculator applies 2026 federal income tax and FICA.
      NY state income tax (4%–10.9%) and NYC local tax are listed as separate items below.
    </p>

    <div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
      ⚠ <strong>Note:</strong> This calculator shows <strong>federal tax only</strong>. NY state tax adds approximately
      4%–10.9% and NYC local tax adds 3.1%–3.9%. Your actual take-home will be lower if you live and work in New York.
    </div>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <PaycheckCalculator client:load />
    </div>

    <div class="mt-8">
      <InContentAd slotId="ny-paycheck-1" />
    </div>

    <div class="mt-10 prose prose-slate max-w-none">
      <h2>New York Tax Overview 2026</h2>
      <p>New York has multiple layers of taxation that significantly impact take-home pay:</p>
      <table>
        <thead><tr><th>Tax</th><th>Rate range</th><th>Notes</th></tr></thead>
        <tbody>
          <tr><td>Federal income tax</td><td>10%–37%</td><td>All residents</td></tr>
          <tr><td>NY State income tax</td><td>4%–10.9%</td><td>10 brackets</td></tr>
          <tr><td>NYC local tax</td><td>3.078%–3.876%</td><td>NYC residents only</td></tr>
          <tr><td>Social Security</td><td>6.2%</td><td>Up to $176,100</td></tr>
          <tr><td>Medicare</td><td>1.45%</td><td>+0.9% above $200k</td></tr>
        </tbody>
      </table>
      <p>
        Full NY state and NYC tax calculation is coming soon. For now, use the federal-only estimate above
        and add approximately 8%–15% for combined NY/NYC taxes on your gross.
      </p>
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="New York Paycheck FAQs" items={faqItems} />
  </article>
</BaseLayout>

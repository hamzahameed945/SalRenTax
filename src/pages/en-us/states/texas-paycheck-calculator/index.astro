---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import PaycheckCalculator from '../../../../components/islands/PaycheckCalculator';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'en-US' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'Texas Paycheck Calculator 2026 — TX Take-Home Pay — SalRenTax',
  'Calculate your Texas take-home pay for 2026. Texas has no state income tax — use our free paycheck calculator for TX residents.',
  '/en-us/states/texas-paycheck-calculator/',
);

const faqItems = [
  {
    question: 'Does Texas have a state income tax?',
    answer: 'No. Texas has no state income tax. The Texas Constitution prohibits an individual income tax. You only pay federal income tax and FICA contributions.',
  },
  {
    question: 'What taxes come out of a Texas paycheck?',
    answer: 'Federal income tax (10%–37%), Social Security (6.2% up to $176,100), and Medicare (1.45%). No Texas state income tax is withheld.',
  },
  {
    question: 'How does Texas compare for take-home pay?',
    answer: 'Texas is one of the best states for take-home pay. Combined with no state income tax and a relatively low cost of living in many areas, Texas workers retain a larger portion of their earnings than in states like California or New York.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout locale={locale} title={meta.title} description={meta.description} canonical={meta.canonical}>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: 'States', href: buildLocalePath(locale, 'states') },
      { label: 'Texas Paycheck Calculator', href: buildLocalePath(locale, 'states/texas-paycheck-calculator') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">Texas Paycheck Calculator 2026</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      Estimate your net take-home pay in Texas. Texas has <strong>no state income tax</strong> —
      only federal income tax and FICA deductions apply to your paycheck.
    </p>

    <div class="mt-4 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
      ✅ <strong>No Texas state income tax.</strong> Only federal taxes (IRS 2026 brackets) and FICA apply.
    </div>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <PaycheckCalculator client:load />
    </div>

    <div class="mt-8">
      <InContentAd slotId="tx-paycheck-1" />
    </div>

    <div class="mt-10 prose prose-slate max-w-none">
      <h2>Texas Paycheck & Tax Overview 2026</h2>
      <p>
        Texas workers enjoy one of the lowest effective tax burdens in the United States. With no state income
        tax, your 2026 payroll deductions are:
      </p>
      <ul>
        <li><strong>Federal income tax</strong> (IRS 2026 brackets: 10%, 12%, 22%, 24%, 32%, 35%, 37%)</li>
        <li><strong>Social Security FICA:</strong> 6.2% on wages up to $176,100</li>
        <li><strong>Medicare FICA:</strong> 1.45% (+ 0.9% above $200,000 single/$250,000 MFJ)</li>
      </ul>
      <h3>Texas vs. other states</h3>
      <p>
        A Texas resident earning $75,000 annually saves approximately $3,750–$5,250/year compared
        to living in a state with a 5–7% state income tax rate.
      </p>
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="Texas Paycheck FAQs" items={faqItems} />
  </article>
</BaseLayout>

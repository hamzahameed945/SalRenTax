---
import CalculatorResource from '../../../../components/content/CalculatorResource.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import AffiliateCTA from '../../../../components/ads/AffiliateCTA.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import PaycheckCalculator from '../../../../components/islands/PaycheckCalculator';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'en-US' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'Texas Paycheck Calculator 2026 — TX Take-Home Pay — PayRenTax',
  'Estimate your Texas take-home pay for 2026 and see how federal payroll deductions affect your paycheck. Texas does not have a state individual income tax.',
  '/en-us/states/texas-paycheck-calculator/',
);

const faqItems = [
  {
    question: 'Does Texas have a state income tax?',
    answer:
      'No. Texas has no state income tax. The Texas Constitution prohibits an individual income tax. You only pay federal income tax and FICA contributions.',
  },
  {
    question: 'What taxes come out of a Texas paycheck?',
    answer:
      'Federal income tax (10%–37%), Social Security (6.2% up to $184,500), and Medicare (1.45%). No Texas state income tax is withheld.',
  },
  {
    question: 'How does Texas compare for take-home pay?',
    answer:
      'Texas is one of the best states for take-home pay. Combined with no state income tax and a relatively low cost of living in many areas, Texas workers retain a larger portion of their earnings than in states like California or New York.',
  },
  {
    question: 'How much tax is taken out of my paycheck in Texas in 2026?',
    answer:
      'Every American paycheck loses the same federal taxes first: federal income tax at your marginal rate (the 2026 brackets run 10% to 37%), Social Security at 6.2% on wages up to the 2026 wage base of $184,500, and Medicare at 1.45% with no cap. Texas adds nothing further — it levies no state income tax on wages, so the federal taxes above are the whole story. Use the calculator above with your salary and pay frequency to see the exact dollar amounts for your paycheck.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: 'States', href: buildLocalePath(locale, 'states') },
      {
        label: 'Texas Paycheck Calculator',
        href: buildLocalePath(locale, 'states/texas-paycheck-calculator'),
      },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">Texas Paycheck Calculator 2026</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      Estimate your Texas take-home pay for 2026 and see how federal payroll deductions affect
      your paycheck. Texas does not have a state individual income tax.
    </p>

    <div class="mt-4 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
      ✅ <strong>No Texas state income tax.</strong> Only federal taxes (IRS 2026 brackets) and FICA
      apply.
    </div>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <PaycheckCalculator stateCode="TX" client:load />
    </div>

    <div class="mt-8">
      <InContentAd slotId="tx-paycheck-1" />
    </div>

    <div class="mt-8">
      <AffiliateCTA locale="en-US" />
    </div>

    <div class="mt-10 prose prose-slate max-w-none">
      <h2>Texas Paycheck & Tax Overview 2026</h2>
      <p>
        Texas workers enjoy one of the lowest effective tax burdens in the United States. With no
        state income tax, your 2026 payroll deductions are:
      </p>
      <ul>
        <li>
          <strong>Federal income tax</strong> (IRS 2026 brackets: 10%, 12%, 22%, 24%, 32%, 35%, 37%)
        </li>
        <li>
          <strong>Social Security FICA:</strong> 6.2% on wages up to $184,500
        </li>
        <li>
          <strong>Medicare FICA:</strong> 1.45% (+ 0.9% above $200,000 single/$250,000 MFJ)
        </li>
      </ul>
      <h3>Texas vs. other states</h3>
      <p>
        A Texas resident earning $75,000 annually saves approximately $3,750–$5,250/year compared to
        living in a state with a 5–7% state income tax rate.
      </p>
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="Texas Paycheck FAQs" items={faqItems} />
    <nav class="mt-10" aria-label="Popular salaries in Texas">
      <h2 class="text-xl font-semibold">Popular salaries in Texas</h2>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/texas-paycheck-calculator/40000/">$40,000 after tax in Texas</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/texas-paycheck-calculator/50000/">$50,000 after tax in Texas</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/texas-paycheck-calculator/60000/">$60,000 after tax in Texas</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/texas-paycheck-calculator/75000/">$75,000 after tax in Texas</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/texas-paycheck-calculator/80000/">$80,000 after tax in Texas</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/texas-paycheck-calculator/100000/">$100,000 after tax in Texas</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/texas-paycheck-calculator/125000/">$125,000 after tax in Texas</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/texas-paycheck-calculator/150000/">$150,000 after tax in Texas</a></li>
      </ul>
    </nav>
  </article>
  <CalculatorResource locale="en-US" category="states" />
</BaseLayout>

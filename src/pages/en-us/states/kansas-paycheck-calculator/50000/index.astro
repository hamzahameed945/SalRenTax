---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../../components/ads/InContentAd.astro';
import AffiliateCTA from '../../../../../components/ads/AffiliateCTA.astro';
import PaycheckCalculator from '../../../../../components/islands/PaycheckCalculator';
import JsonLd from '../../../../../components/seo/JsonLd.astro';
import { getDictionary } from '../../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../../lib/seo/structuredData';

const locale = 'en-US' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  '$50,000 After Tax in Kansas (2026) \u2014 Take-Home Pay \u2014 PayRenTax',
  'A $50,000 salary in Kansas is $39,854 after tax in 2026. Federal, state & FICA breakdown inside.',
  '/en-us/states/kansas-paycheck-calculator/50000/',
);

const faqItems = [
  {
    question: 'How much is $50,000 after tax in Kansas?',
    answer:
      'A $50,000 salary in Kansas leaves you $39,854 per year after federal and state taxes in 2026. That is $3,321 per month or $1,533 every two weeks, assuming a single filer with no pre-tax deductions.',
  },
  {
    question: 'What is the effective tax rate on $50,000 in Kansas?',
    answer:
      'The combined effective tax rate (federal income tax, FICA, and Kansas state tax) on a $50,000 salary in Kansas is 20.29%. Your Kansas state income tax is $2,501 for the year.',
  },
  {
    question: 'How much federal tax do you pay on $50,000 in Kansas?',
    answer:
      'Federal income tax on $50,000 for a single filer in 2026 is $3,820. Social Security takes $3,100 and Medicare $725. Customize the numbers with the interactive calculator below.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: 'States', href: buildLocalePath(locale, 'states') },
      {
        label: 'Kansas Paycheck Calculator',
        href: buildLocalePath(locale, 'states/kansas-paycheck-calculator'),
      },
      { label: '$50,000 after tax', href: buildLocalePath(locale, 'states/kansas-paycheck-calculator/50000') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">$50,000 After Tax in Kansas: 2026 Take-Home Pay</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      A <strong>$50,000</strong> salary in Kansas is <strong>$39,854 per year</strong> after
      federal income tax, FICA, and Kansas state tax in 2026 \u2014 that is $3,321/month.
    </p>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold">2026 tax breakdown: $50,000 in Kansas</h2>
      <table class="mt-4 w-full text-sm">
        <tbody>
          <tr><td>Gross salary</td><td>$50,000</td></tr>
          <tr><td>Federal income tax</td><td>$3,820</td></tr>
          <tr><td>Kansas income tax</td><td>$2,501</td></tr>
          <tr><td>Social Security (6.2%)</td><td>$3,100</td></tr>
          <tr><td>Medicare (1.45%)</td><td>$725</td></tr>
          <tr class="font-semibold"><td>Take-home pay</td><td>$39,854</td></tr>
        </tbody>
      </table>
      <p class="mt-4 text-xs text-slate-500">
        Single filer, no pre-tax deductions, 2026 IRS brackets and Kansas 2026 tax rules.
        Figures are estimates \u2014 adjust inputs in the calculator below.
      </p>
    </div>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold">Take-home per pay period</h2>
      <table class="mt-4 w-full text-sm">
        <tbody>
          <tr><td>Annual</td><td>$39,854</td></tr>
          <tr><td>Monthly</td><td>$3,321</td></tr>
          <tr><td>Biweekly</td><td>$1,533</td></tr>
          <tr><td>Weekly</td><td>$766</td></tr>
        </tbody>
      </table>
    </div>

    <div class="mt-8">
      <InContentAd slotId="ks-paycheck-50000" />
    </div>

    <div class="mt-8">
      <AffiliateCTA locale="en-US" />
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="$50,000 in Kansas: FAQs" items={faqItems} />

    <div class="mt-10">
      <h2 class="text-xl font-semibold">Customize the numbers</h2>
      <div class="mt-4">
        <PaycheckCalculator stateCode="KS" initialAnnualSalary="50000" client:load />
      </div>
    </div>
    <nav class="mt-10" aria-label="Other salaries in Kansas">
      <h2 class="text-xl font-semibold">Other salaries in Kansas</h2>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/kansas-paycheck-calculator/40000/">$40,000 after tax in Kansas</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/kansas-paycheck-calculator/60000/">$60,000 after tax in Kansas</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/kansas-paycheck-calculator/75000/">$75,000 after tax in Kansas</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/kansas-paycheck-calculator/80000/">$80,000 after tax in Kansas</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/kansas-paycheck-calculator/100000/">$100,000 after tax in Kansas</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/kansas-paycheck-calculator/125000/">$125,000 after tax in Kansas</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/kansas-paycheck-calculator/150000/">$150,000 after tax in Kansas</a></li>
      </ul>
    </nav>
  </article>
</BaseLayout>

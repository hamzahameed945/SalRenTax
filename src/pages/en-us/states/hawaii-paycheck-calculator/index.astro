---
import CalculatorResource from '../../../../components/content/CalculatorResource.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import AffiliateCTA from '../../../../components/ads/AffiliateCTA.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import PaycheckCalculator from '../../../../components/islands/PaycheckCalculator';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'en-US' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'Hawaii Paycheck Calculator 2026 \u2014 HI Take-Home Pay \u2014 PayRenTax',
  'Estimate your Hawaii take-home pay for 2026 with the state’s graduated income tax of 1.4% to 11% across 12 brackets plus federal deductions.',
  '/en-us/states/hawaii-paycheck-calculator/',
);

const faqItems = [
  {
    question: 'Does Hawaii have a state income tax?',
    answer:
      'Yes. Hawaii levies a graduated income tax of 1.4% to 11% across 12 brackets on taxable income.',
  },
  {
    question: 'What are the Hawaii income tax brackets for 2026?',
    answer:
      'For single filers, Hawaii’s 2026 rates run from 1.4% to 11%. See the bracket table above for the full schedule.',
  },
  {
    question: 'What taxes are withheld from a Hawaii paycheck?',
    answer:
      'Federal income tax (10%–37%), Social Security (6.2% up to $176,100), Medicare (1.45%), and Hawaii state income tax.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: 'States', href: buildLocalePath(locale, 'states') },
      {
        label: 'Hawaii Paycheck Calculator',
        href: buildLocalePath(locale, 'states/hawaii-paycheck-calculator'),
      },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">Hawaii Paycheck Calculator 2026</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      Estimate your Hawaii take-home pay for 2026 and see how state and federal payroll
      deductions affect your paycheck.
    </p>

    <div class="mt-4 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
      📊 <strong>Hawaii graduated tax: up to 11%.</strong> Higher earnings are taxed at
      higher marginal rates.
    </div>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <PaycheckCalculator stateCode="HI" client:load />
    </div>

    <div class="mt-8">
      <InContentAd slotId="hi-paycheck-1" />
    </div>

    <div class="mt-8">
      <AffiliateCTA locale="en-US" />
    </div>

    <div class="mt-10 prose prose-slate max-w-none">
      <h2>Hawaii Paycheck & Tax Overview 2026</h2>
      <p>
        Hawaii has a graduated income tax of 1.4% to 11% across 12 brackets. Your 2026 payroll deductions are:
      </p>
      <ul>
        <li>
          <strong>Hawaii income tax:</strong> graduated income tax of 1.4% to 11% across 12 brackets (single filer, 2026)
        </li>        <li>
          <strong>Federal income tax</strong> (IRS 2026 brackets: 10%, 12%, 22%, 24%, 32%, 35%, 37%)
        </li>
        <li>
          <strong>Social Security FICA:</strong> 6.2% on wages up to $176,100
        </li>
        <li>
          <strong>Medicare FICA:</strong> 1.45% (+ 0.9% above $200,000 single/$250,000 MFJ)
        </li>
      </ul>
      <h3>Hawaii 2026 tax brackets (single filer)</h3>
      <table>
        <thead><tr><th>Taxable income</th><th>Rate</th></tr></thead>
        <tbody>
          <tr><td>$0 – $9,600</td><td>1.4%</td></tr>
          <tr><td>$9,600 – $14,400</td><td>3.2%</td></tr>
          <tr><td>$14,400 – $19,200</td><td>5.5%</td></tr>
          <tr><td>$19,200 – $24,000</td><td>6.4%</td></tr>
          <tr><td>$24,000 – $36,000</td><td>6.8%</td></tr>
          <tr><td>$36,000 – $48,000</td><td>7.2%</td></tr>
          <tr><td>$48,000 – $125,000</td><td>7.6%</td></tr>
          <tr><td>$125,000 – $175,000</td><td>7.9%</td></tr>
          <tr><td>$175,000 – $225,000</td><td>8.25%</td></tr>
          <tr><td>$225,000 – $275,000</td><td>9%</td></tr>
          <tr><td>$275,000 – $325,000</td><td>10%</td></tr>
          <tr><td>$325,000 – $and up</td><td>11%</td></tr>
        </tbody>
      </table>
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="Hawaii Paycheck FAQs" items={faqItems} />
    <nav class="mt-10" aria-label="Popular salaries in Hawaii">
      <h2 class="text-xl font-semibold">Popular salaries in Hawaii</h2>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/hawaii-paycheck-calculator/40000/">$40,000 after tax in Hawaii</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/hawaii-paycheck-calculator/50000/">$50,000 after tax in Hawaii</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/hawaii-paycheck-calculator/60000/">$60,000 after tax in Hawaii</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/hawaii-paycheck-calculator/75000/">$75,000 after tax in Hawaii</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/hawaii-paycheck-calculator/80000/">$80,000 after tax in Hawaii</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/hawaii-paycheck-calculator/100000/">$100,000 after tax in Hawaii</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/hawaii-paycheck-calculator/125000/">$125,000 after tax in Hawaii</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/hawaii-paycheck-calculator/150000/">$150,000 after tax in Hawaii</a></li>
      </ul>
    </nav>
  </article>
  <CalculatorResource locale="en-US" category="states" />
</BaseLayout>

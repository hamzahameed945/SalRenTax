---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../../components/seo/JsonLd.astro';
import { getDictionary } from '../../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../../lib/seo/structuredData';

const locale = 'en-US' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  '$80,000 After Tax in Tennessee (2026) \u2014 Take-Home Pay \u2014 PayRenTax',
  'A $80,000 salary in Tennessee is $65,110 after tax in 2026. Federal, state & FICA breakdown inside.',
  '/en-us/states/tennessee-paycheck-calculator/80000/',
);

const faqItems = [
  {
    question: 'How much is $80,000 after tax in Tennessee?',
    answer:
      'A $80,000 salary in Tennessee leaves you $65,110 per year after federal and state taxes in 2026. That is $5,426 per month or $2,504 every two weeks, assuming a single filer with no pre-tax deductions.',
  },
  {
    question: 'What is the effective tax rate on $80,000 in Tennessee?',
    answer:
      'The combined effective tax rate (federal income tax, FICA, and Tennessee state tax) on a $80,000 salary in Tennessee is 18.61%. Tennessee has no state individual income tax, so $0 is withheld for state tax.',
  },
  {
    question: 'How much federal tax do you pay on $80,000 in Tennessee?',
    answer:
      'Federal income tax on $80,000 for a single filer in 2026 is $8,770. Social Security takes $4,960 and Medicare $1,160. Customize the numbers with the interactive calculator below.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: 'States', href: buildLocalePath(locale, 'states') },
      {
        label: 'Tennessee Paycheck Calculator',
        href: buildLocalePath(locale, 'states/tennessee-paycheck-calculator'),
      },
      { label: '$80,000 after tax', href: buildLocalePath(locale, 'states/tennessee-paycheck-calculator/80000') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">$80,000 After Tax in Tennessee: 2026 Take-Home Pay</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      A <strong>$80,000</strong> salary in Tennessee is <strong>$65,110 per year</strong> after
      federal income tax, FICA, and Tennessee state tax in 2026 \u2014 that is $5,426/month.
    </p>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold">2026 tax breakdown: $80,000 in Tennessee</h2>
      <table class="mt-4 w-full text-sm">
        <tbody>
          <tr><td>Gross salary</td><td>$80,000</td></tr>
          <tr><td>Federal income tax</td><td>$8,770</td></tr>
          <tr><td>Social Security (6.2%)</td><td>$4,960</td></tr>
          <tr><td>Medicare (1.45%)</td><td>$1,160</td></tr>
          <tr class="font-semibold"><td>Take-home pay</td><td>$65,110</td></tr>
        </tbody>
      </table>
      <p class="mt-4 text-xs text-slate-500">
        Single filer, no pre-tax deductions, 2026 IRS brackets and Tennessee 2026 tax rules.
        Figures are estimates \u2014 adjust inputs in the calculator below.
      </p>
    </div>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold">Take-home per pay period</h2>
      <table class="mt-4 w-full text-sm">
        <tbody>
          <tr><td>Annual</td><td>$65,110</td></tr>
          <tr><td>Monthly</td><td>$5,426</td></tr>
          <tr><td>Biweekly</td><td>$2,504</td></tr>
          <tr><td>Weekly</td><td>$1,252</td></tr>
        </tbody>
      </table>
    </div>

    <div class="mt-8">
      <InContentAd slotId="tn-paycheck-80000" />
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="$80,000 in Tennessee: FAQs" items={faqItems} />
  </article>
</BaseLayout>

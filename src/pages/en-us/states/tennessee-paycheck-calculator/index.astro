---
import CalculatorResource from '../../../../components/content/CalculatorResource.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import PaycheckCalculator from '../../../../components/islands/PaycheckCalculator';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'en-US' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'Tennessee Paycheck Calculator 2026 \u2014 TN Take-Home Pay \u2014 PayRenTax',
  'Estimate your Tennessee take-home pay for 2026. Tennessee has no state individual income tax.',
  '/en-us/states/tennessee-paycheck-calculator/',
);

const faqItems = [
  {
    question: 'Does Tennessee have a state income tax?',
    answer:
      'No. Tennessee does not levy an individual income tax on wage income. You only pay federal income tax and FICA contributions on your paycheck.',
  },
  {
    question: 'What is the Tennessee income tax rate for 2026?',
    answer:
      'Tennessee has a 0% individual income tax rate — there is no state tax on wages, salaries, or tips.',
  },
  {
    question: 'What taxes are withheld from a Tennessee paycheck?',
    answer:
      'Federal income tax (10%–37%), Social Security (6.2% up to $176,100), and Medicare (1.45%). No Tennessee state income tax is withheld.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: 'States', href: buildLocalePath(locale, 'states') },
      {
        label: 'Tennessee Paycheck Calculator',
        href: buildLocalePath(locale, 'states/tennessee-paycheck-calculator'),
      },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">Tennessee Paycheck Calculator 2026</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      Estimate your Tennessee take-home pay for 2026 and see how state and federal payroll
      deductions affect your paycheck.
    </p>

    <div class="mt-4 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
      ✅ <strong>No Tennessee state income tax.</strong> Only federal taxes (IRS 2026 brackets) and FICA
      apply.
    </div>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <PaycheckCalculator stateCode="TN" client:load />
    </div>

    <div class="mt-8">
      <InContentAd slotId="tn-paycheck-1" />
    </div>

    <div class="mt-10 prose prose-slate max-w-none">
      <h2>Tennessee Paycheck & Tax Overview 2026</h2>
      <p>
        Tennessee workers keep more of each paycheck because the state levies no individual income
        tax on wages. Your 2026 payroll deductions are federal only:
      </p>
      <ul>
        <li>
          <strong>Federal income tax</strong> (IRS 2026 brackets: 10%, 12%, 22%, 24%, 32%, 35%, 37%)
        </li>
        <li>
          <strong>Social Security FICA:</strong> 6.2% on wages up to $176,100
        </li>
        <li>
          <strong>Medicare FICA:</strong> 1.45% (+ 0.9% above $200,000 single/$250,000 MFJ)
        </li>
      </ul>

    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="Tennessee Paycheck FAQs" items={faqItems} />
  </article>
  <CalculatorResource locale="en-US" category="states" />
</BaseLayout>

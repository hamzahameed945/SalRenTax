---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../../components/seo/JsonLd.astro';
import { getDictionary } from '../../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../../lib/seo/structuredData';

const locale = 'en-US' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  '$125,000 After Tax in Ohio (2026) \u2014 Take-Home Pay \u2014 PayRenTax',
  'A $125,000 salary in Ohio is $93,982 after tax in 2026. Federal, state & FICA breakdown inside.',
  '/en-us/states/ohio-paycheck-calculator/125000/',
);

const faqItems = [
  {
    question: 'How much is $125,000 after tax in Ohio?',
    answer:
      'A $125,000 salary in Ohio leaves you $93,982 per year after federal and state taxes in 2026. That is $7,832 per month or $3,615 every two weeks, assuming a single filer with no pre-tax deductions.',
  },
  {
    question: 'What is the effective tax rate on $125,000 in Ohio?',
    answer:
      'The combined effective tax rate (federal income tax, FICA, and Ohio state tax) on a $125,000 salary in Ohio is 24.81%. Your Ohio state income tax is $2,721 for the year.',
  },
  {
    question: 'How much federal tax do you pay on $125,000 in Ohio?',
    answer:
      'Federal income tax on $125,000 for a single filer in 2026 is $18,734. Social Security takes $7,750 and Medicare $1,812. Customize the numbers with the interactive calculator below.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: 'States', href: buildLocalePath(locale, 'states') },
      {
        label: 'Ohio Paycheck Calculator',
        href: buildLocalePath(locale, 'states/ohio-paycheck-calculator'),
      },
      { label: '$125,000 after tax', href: buildLocalePath(locale, 'states/ohio-paycheck-calculator/125000') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">$125,000 After Tax in Ohio: 2026 Take-Home Pay</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      A <strong>$125,000</strong> salary in Ohio is <strong>$93,982 per year</strong> after
      federal income tax, FICA, and Ohio state tax in 2026 \u2014 that is $7,832/month.
    </p>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold">2026 tax breakdown: $125,000 in Ohio</h2>
      <table class="mt-4 w-full text-sm">
        <tbody>
          <tr><td>Gross salary</td><td>$125,000</td></tr>
          <tr><td>Federal income tax</td><td>$18,734</td></tr>
          <tr><td>Ohio income tax</td><td>$2,721</td></tr>
          <tr><td>Social Security (6.2%)</td><td>$7,750</td></tr>
          <tr><td>Medicare (1.45%)</td><td>$1,812</td></tr>
          <tr class="font-semibold"><td>Take-home pay</td><td>$93,982</td></tr>
        </tbody>
      </table>
      <p class="mt-4 text-xs text-slate-500">
        Single filer, no pre-tax deductions, 2026 IRS brackets and Ohio 2026 tax rules.
        Figures are estimates \u2014 adjust inputs in the calculator below.
      </p>
    </div>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold">Take-home per pay period</h2>
      <table class="mt-4 w-full text-sm">
        <tbody>
          <tr><td>Annual</td><td>$93,982</td></tr>
          <tr><td>Monthly</td><td>$7,832</td></tr>
          <tr><td>Biweekly</td><td>$3,615</td></tr>
          <tr><td>Weekly</td><td>$1,807</td></tr>
        </tbody>
      </table>
    </div>

    <div class="mt-8">
      <InContentAd slotId="oh-paycheck-125000" />
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="$125,000 in Ohio: FAQs" items={faqItems} />
  </article>
</BaseLayout>

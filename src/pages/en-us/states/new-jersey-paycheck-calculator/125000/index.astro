---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../../components/ads/InContentAd.astro';
import AffiliateCTA from '../../../../../components/ads/AffiliateCTA.astro';
import PaycheckCalculator from '../../../../../components/islands/PaycheckCalculator';
import JsonLd from '../../../../../components/seo/JsonLd.astro';
import { getDictionary } from '../../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../../lib/seo/structuredData';

const locale = 'en-US' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  '$125,000 After Tax in New Jersey (2026) \u2014 Take-Home Pay \u2014 PayRenTax',
  'A $125,000 salary in New Jersey is $90,931 after tax in 2026. Federal, state & FICA breakdown inside.',
  '/en-us/states/new-jersey-paycheck-calculator/125000/',
);

const faqItems = [
  {
    question: 'How much is $125,000 after tax in New Jersey?',
    answer:
      'A $125,000 salary in New Jersey leaves you $90,931 per year after federal and state taxes in 2026. That is $7,578 per month or $3,497 every two weeks, assuming a single filer with no pre-tax deductions.',
  },
  {
    question: 'What is the effective tax rate on $125,000 in New Jersey?',
    answer:
      'The combined effective tax rate (federal income tax, FICA, and New Jersey state tax) on a $125,000 salary in New Jersey is 27.26%. Your New Jersey state income tax is $5,773 for the year.',
  },
  {
    question: 'How much federal tax do you pay on $125,000 in New Jersey?',
    answer:
      'Federal income tax on $125,000 for a single filer in 2026 is $18,734. Social Security takes $7,750 and Medicare $1,812. Customize the numbers with the interactive calculator below.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: 'States', href: buildLocalePath(locale, 'states') },
      {
        label: 'New Jersey Paycheck Calculator',
        href: buildLocalePath(locale, 'states/new-jersey-paycheck-calculator'),
      },
      { label: '$125,000 after tax', href: buildLocalePath(locale, 'states/new-jersey-paycheck-calculator/125000') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">$125,000 After Tax in New Jersey: 2026 Take-Home Pay</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      A <strong>$125,000</strong> salary in New Jersey is <strong>$90,931 per year</strong> after
      federal income tax, FICA, and New Jersey state tax in 2026 \u2014 that is $7,578/month.
    </p>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold">2026 tax breakdown: $125,000 in New Jersey</h2>
      <table class="mt-4 w-full text-sm">
        <tbody>
          <tr><td>Gross salary</td><td>$125,000</td></tr>
          <tr><td>Federal income tax</td><td>$18,734</td></tr>
          <tr><td>New Jersey income tax</td><td>$5,773</td></tr>
          <tr><td>Social Security (6.2%)</td><td>$7,750</td></tr>
          <tr><td>Medicare (1.45%)</td><td>$1,812</td></tr>
          <tr class="font-semibold"><td>Take-home pay</td><td>$90,931</td></tr>
        </tbody>
      </table>
      <p class="mt-4 text-xs text-slate-500">
        Single filer, no pre-tax deductions, 2026 IRS brackets and New Jersey 2026 tax rules.
        Figures are estimates \u2014 adjust inputs in the calculator below.
      </p>
    </div>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold">Take-home per pay period</h2>
      <table class="mt-4 w-full text-sm">
        <tbody>
          <tr><td>Annual</td><td>$90,931</td></tr>
          <tr><td>Monthly</td><td>$7,578</td></tr>
          <tr><td>Biweekly</td><td>$3,497</td></tr>
          <tr><td>Weekly</td><td>$1,749</td></tr>
        </tbody>
      </table>
    </div>

    <div class="mt-8">
      <InContentAd slotId="nj-paycheck-125000" />
    </div>

    <div class="mt-8">
      <AffiliateCTA locale="en-US" />
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="$125,000 in New Jersey: FAQs" items={faqItems} />

    <div class="mt-10">
      <h2 class="text-xl font-semibold">Customize the numbers</h2>
      <div class="mt-4">
        <PaycheckCalculator stateCode="NJ" initialAnnualSalary="125000" client:load />
      </div>
    </div>
    <nav class="mt-10" aria-label="Other salaries in New Jersey">
      <h2 class="text-xl font-semibold">Other salaries in New Jersey</h2>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/new-jersey-paycheck-calculator/40000/">$40,000 after tax in New Jersey</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/new-jersey-paycheck-calculator/50000/">$50,000 after tax in New Jersey</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/new-jersey-paycheck-calculator/60000/">$60,000 after tax in New Jersey</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/new-jersey-paycheck-calculator/75000/">$75,000 after tax in New Jersey</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/new-jersey-paycheck-calculator/80000/">$80,000 after tax in New Jersey</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/new-jersey-paycheck-calculator/100000/">$100,000 after tax in New Jersey</a></li>
            <li><a class="text-emerald-700 underline hover:text-emerald-900" href="/en-us/states/new-jersey-paycheck-calculator/150000/">$150,000 after tax in New Jersey</a></li>
      </ul>
    </nav>
  </article>
</BaseLayout>

---
import CalculatorResource from '../../../../components/content/CalculatorResource.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import PaycheckCalculator from '../../../../components/islands/PaycheckCalculator';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'en-US' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'New Jersey Paycheck Calculator 2026 \u2014 NJ Take-Home Pay \u2014 PayRenTax',
  'Estimate your New Jersey take-home pay for 2026 with the state’s graduated income tax of 1.4% to 10.75% plus federal deductions.',
  '/en-us/states/new-jersey-paycheck-calculator/',
);

const faqItems = [
  {
    question: 'Does New Jersey have a state income tax?',
    answer:
      'Yes. New Jersey levies a graduated income tax of 1.4% to 10.75% on taxable income.',
  },
  {
    question: 'What are the New Jersey income tax brackets for 2026?',
    answer:
      'For single filers, New Jersey’s 2026 rates run from 1.4% to 10.75%. See the bracket table above for the full schedule.',
  },
  {
    question: 'What taxes are withheld from a New Jersey paycheck?',
    answer:
      'Federal income tax (10%–37%), Social Security (6.2% up to $176,100), Medicare (1.45%), and New Jersey state income tax.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: 'States', href: buildLocalePath(locale, 'states') },
      {
        label: 'New Jersey Paycheck Calculator',
        href: buildLocalePath(locale, 'states/new-jersey-paycheck-calculator'),
      },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">New Jersey Paycheck Calculator 2026</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      Estimate your New Jersey take-home pay for 2026 and see how state and federal payroll
      deductions affect your paycheck.
    </p>

    <div class="mt-4 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
      📊 <strong>New Jersey graduated tax: up to 10.75%.</strong> Higher earnings are taxed at
      higher marginal rates.
    </div>

    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <PaycheckCalculator stateCode="NJ" client:load />
    </div>

    <div class="mt-8">
      <InContentAd slotId="nj-paycheck-1" />
    </div>

    <div class="mt-10 prose prose-slate max-w-none">
      <h2>New Jersey Paycheck & Tax Overview 2026</h2>
      <p>
        New Jersey has a graduated income tax of 1.4% to 10.75%. Your 2026 payroll deductions are:
      </p>
      <ul>
        <li>
          <strong>New Jersey income tax:</strong> graduated income tax of 1.4% to 10.75% (single filer, 2026)
        </li>        <li>
          <strong>Federal income tax</strong> (IRS 2026 brackets: 10%, 12%, 22%, 24%, 32%, 35%, 37%)
        </li>
        <li>
          <strong>Social Security FICA:</strong> 6.2% on wages up to $176,100
        </li>
        <li>
          <strong>Medicare FICA:</strong> 1.45% (+ 0.9% above $200,000 single/$250,000 MFJ)
        </li>
      </ul>
      <h3>New Jersey 2026 tax brackets (single filer)</h3>
      <table>
        <thead><tr><th>Taxable income</th><th>Rate</th></tr></thead>
        <tbody>
          <tr><td>$0 – $20,000</td><td>1.4%</td></tr>
          <tr><td>$20,000 – $35,000</td><td>1.75%</td></tr>
          <tr><td>$35,000 – $40,000</td><td>3.5%</td></tr>
          <tr><td>$40,000 – $75,000</td><td>5.525%</td></tr>
          <tr><td>$75,000 – $500,000</td><td>6.37%</td></tr>
          <tr><td>$500,000 – $1,000,000</td><td>8.97%</td></tr>
          <tr><td>$1,000,000 – $and up</td><td>10.75%</td></tr>
        </tbody>
      </table>
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="New Jersey Paycheck FAQs" items={faqItems} />
  </article>
  <CalculatorResource locale="en-US" category="states" />
</BaseLayout>

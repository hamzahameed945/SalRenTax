---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'en-US' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'Take-Home Pay on $100,000 in Every US State (2026 Study) \u2014 PayRenTax',
  'On a $100,000 salary in 2026, take-home pay ranges from $71,004 in Oregon to $79,180 in nine no-income-tax states \u2014 a $8,176 gap. Full 50-state ranking with real 2026 tax data.',
  '/en-us/study/take-home-pay-100k-by-state/',
);

const faqItems = [
    {
      question: 'How is take-home pay calculated in this study?',
      answer:
        'Each figure assumes a single filer with a $100,000 annual salary and no pre-tax deductions, using 2026 IRS federal brackets, the 2026 Social Security wage base ($184,500), and each state\u2019s 2026 income tax brackets. State figures are estimates.'
    },
    {
      question: 'Which state has the highest take-home pay on $100,000?',
      answer:
        'Nine states with no individual income tax tie for first: Alaska, Florida, Nevada, New Hampshire, South Dakota, Tennessee, Texas, Washington, and Wyoming, each leaving $79,180 after federal taxes and FICA.'
    },
    {
      question: 'Which state has the lowest take-home pay on $100,000?',
      answer:
        'Oregon, at $71,004 — $8,176 less than the top states, driven by its $8,176 state income tax bill.'
    },
    {
      question: 'Does this include local taxes?',
      answer:
        'No. City and county income taxes (for example, New York City\u2019s) are not modeled, so actual take-home in those places is lower.'
    }
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: 'Study', href: buildLocalePath(locale, 'study/take-home-pay-100k-by-state') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <p class="text-sm font-semibold uppercase tracking-wide text-emerald-700">2026 Study</p>
    <h1 class="mt-2 text-3xl font-bold text-slate-900">Take-Home Pay on $100,000 in Every US State</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      We ran a $100,000 salary through 2026 federal and state tax rules for all 50 states.
      The result: <strong>where you live changes your paycheck by up to $8,176 a year</strong>.
    </p>

    <div class="mt-6 grid gap-4 sm:grid-cols-3">
      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <p class="text-sm text-slate-500">Highest take-home</p>
        <p class="mt-1 text-2xl font-bold text-slate-900">$79,180</p>
        <p class="text-sm text-slate-500">9 states with no income tax</p>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <p class="text-sm text-slate-500">Lowest take-home</p>
        <p class="mt-1 text-2xl font-bold text-slate-900">$71,004</p>
        <p class="text-sm text-slate-500">Oregon</p>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <p class="text-sm text-slate-500">Max state-tax gap</p>
        <p class="mt-1 text-2xl font-bold text-slate-900">$8,176/yr</p>
        <p class="text-sm text-slate-500">Same salary, different state</p>
      </div>
    </div>

    <h2 class="mt-10 text-2xl font-bold text-slate-900">Full 50-state ranking</h2>
    <p class="mt-2 text-sm text-slate-500">Single filer, $100,000 salary, no deductions, 2026 tax rules. Click a state for its full calculator.</p>
    <div class="mt-4 overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">

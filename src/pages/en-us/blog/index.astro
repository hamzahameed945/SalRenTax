---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/navigation/Breadcrumbs.astro';
const locale = 'en-US' as const;

const blogPosts = [
  {
    title: 'How Much Rent Can I Afford in 2026?',
    slug: 'how-much-rent-can-i-afford-2026',
    excerpt: 'Use the 30% rule to turn your salary into a rent budget: $1,250 on $50k, $1,500 on $60k, $1,750 on $70k, $2,000 on $80k — plus when to use take-home pay instead of gross pay.',
    date: '2026-11-02',
    category: 'Rent',
    readTime: '8 min',
    image: '/og-default.png'
  },
{
title: 'Salary to Hourly: How to Convert Your Pay in 2026',
slug: 'salary-to-hourly-conversion-2026',
excerpt: 'Convert an annual salary to an hourly rate by dividing by your actual working hours: $50,000 a year is about $24.04 an hour on a 40-hour week, and $60,000 is about $28.85.',
date: '2026-11-03',
category: 'Salary',
readTime: '5 min',
image: '/og-default.png'
},
  {
    title: 'What Is Take-Home Pay? Gross Pay vs Net Pay Explained',
    slug: 'take-home-pay-explained-2026',
    excerpt: 'Take-home pay is what remains after payroll deductions are taken from gross pay — learn what is usually deducted and why two jobs with the same salary can pay differently.',
    date: '2026-11-03',
    category: 'Salary',
    readTime: '5 min',
    image: '/og-default.png'
  },
  {
    title: 'Biweekly vs Monthly Pay: How Pay Frequency Changes Your Budget',
    slug: 'biweekly-vs-monthly-pay-2026',
    excerpt: 'Biweekly pay means 26 smaller checks a year, monthly pay 12 larger ones, and semimonthly 24 — the annual total is the same, but budgeting feels very different.',
    date: '2026-11-03',
    category: 'Salary',
    readTime: '5 min',
    image: '/og-default.png'
  },
{
title: 'How to Read Your Paystub: Gross Pay, Deductions, and Net Pay',
slug: 'how-to-read-your-paystub-2026',
excerpt: 'A paystub lists gross pay, each deduction, and net pay for the period, plus year-to-date totals — learn what each section means and which numbers to check every payday.',
date: '2026-11-03',
category: 'Salary',
readTime: '5 min',
image: '/og-default.png'
},
  {
    title: 'Overtime Pay Explained: How Extra Hours Change Your Paycheck',
slug: 'overtime-pay-explained-2026',
excerpt: 'Overtime is pay for hours beyond your standard schedule, usually at a higher rate — learn how it is counted, why it changes take-home pay, and what to check before counting on it.',
date: '2026-11-03',
category: 'Salary',
readTime: '5 min',
image: '/og-default.png'
},
{
title: 'How to Ask for a Raise: Prepare, Time It, and Make Your Case',
    slug: 'how-to-ask-for-a-raise-2026',
excerpt: 'A raise request works best when it is prepared, timed well, and tied to your work: gather your contributions, check the range for your role, and ask for a specific outcome.',
date: '2026-11-03',
category: 'Salary',
readTime: '5 min',
image: '/og-default.png'
},
{
title: 'How to Convert Your Hourly Wage to an Annual Salary',
slug: 'hourly-to-salary-conversion-2026',
excerpt: 'Convert an hourly wage to an annual salary with a simple formula and a worked example.',
date: '2026-11-03',
category: 'Salary',
readTime: '5 min',
image: '/og-default.png'
},
{
  title: 'Bonus Pay Explained: How Work Bonuses Work and What They Mean for Your Pay',
  slug: 'bonus-pay-explained-2026',
  excerpt: 'A bonus is extra pay on top  of your regular salary or wages. Learn the common types, how a bonus fits into annual pay, and what to check on your pay stub.',
  date: '2026-11-04',
  category: 'Salary',
  readTime: '5 min',
  image: '/og-default.png'
},
  {
    title: 'Salary vs Hourly Pay: Which One Pays More?',
    slug: 'salary-vs-hourly-pay-2026',
    excerpt: 'Compare salary and hourly pay with simple math: divide a salary by 2,080 hours or multiply an hourly wage by 2,080 to see which one comes out ahead.',
    date: '2026-11-05',
    category: 'Salary',
    readTime: '5 min',
    image: '/og-default.png'
  },
  {
    title: 'What Is an Annual Salary? How Your Yearly Pay Is Calculated',
    slug: 'what-is-an-annual-salary-2026',
    excerpt: 'An annual salary is the total pay for a full year of work. Learn how it is calculated from an hourly wage and how it breaks down into monthly, biweekly, and weekly amounts.',
    date: '2026-11-06',
    category: 'Salary',
    readTime: '5 min',
    image: '/og-default.png'
  },
{
  title: 'How to Calculate Your Paycheck (2026 Guide)',
slug: 'how-to-calculate-your-paycheck-2026',
excerpt: 'Learn how to calculate your paycheck step by step: gross pay, overtime, deductions, and how pay frequency changes each check.',
date: '2026-11-07',
category: 'Salary',
readTime: '5 min',
image: '/og-default.png'
},
{
  title: 'How to Calculate a Salary Raise (2026 Guide)',
slug: 'how-to-calculate-a-salary-raise-2026',
excerpt: 'Turn a raise percentage into dollars: a 5% raise on $60,000 adds $3,000 a year — $250 a month — plus how to work out the percentage of any offer.',
date: '2026-11-08',
category: 'Salary',
readTime: '5 min',
image: '/og-default.png'
},
  {
    title: 'How Much House Can You Afford on Your Salary? (2026 Guide)',
    slug: 'how-much-house-can-you-afford-2026',
    excerpt: 'Turn your salary into a maximum monthly payment with the 28% rule: $1,400 a month on $60,000 — then see what that buys at a 7.28% rate with 20% down.',
    date: '2026-11-09',
    category: 'Salary',
    readTime: '5 min',
    image: '/og-default.png'
  },
{
title: 'How to Estimate Your Tax Refund in 2026 (Before You File)',
slug: 'how-to-estimate-your-tax-refund-2026',
excerpt: 'Estimate your 2026 tax refund from three numbers: your income, the $16,100 standard deduction, and what was withheld. A single filer on $75,000 with $9,000 withheld gets about $1,330 back.',
date: '2026-11-10',
category: 'Salary',
readTime: '5 min',
image: '/og-default.png'
},
{
title: 'How to Calculate Your Severance Pay in 2026',
slug: 'how-to-calculate-your-severance-pay-2026',
excerpt: 'Severance usually runs 1–2 weeks of pay per year of service: $8,173 to $16,346 on an $85,000 salary with 5 years of service — plus how it is taxed and what to negotiate before you sign.',
date: '2026-11-11',
category: 'Labor',
readTime: '5 min',
image: '/og-default.png'
},
];

const schemaWebPage = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "PayRenTax Blog",
  "description": "Guides on rent affordability, paychecks and salary calculations in the United States",
  "url": "https://payrentax.me/en-us/blog/",
  "inLanguage": "en-US"
};
---

<BaseLayout
  locale={locale}
  title="PayRenTax Blog | Rent Affordability, Paychecks and Salary Guides"
  description="Guides on how much rent you can afford, paycheck calculations and salary planning in the United States."
  canonical="/en-us/blog/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schemaWebPage)} />
  </Fragment>

  <Breadcrumbs locale={locale} trail={[]} />

  <div class="mx-auto max-w-6xl px-4 py-10">
    <header class="mb-12">
      <h1 class="text-4xl font-bold text-slate-900 mb-4">PayRenTax Blog</h1>
      <p class="text-xl text-slate-600 max-w-3xl">
        Practical guides on rent affordability, paychecks and salary planning.
      </p>
    </header>

    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {blogPosts.map((post) => (
        <article class="rounded-xl border border-slate-200 bg-white overflow-hidden shadow-sm hover:shadow-md transition-shadow">
          <img
            src={post.image}
            alt={post.title}
            class="w-full h-48 object-cover"
          />
          <div class="p-6">
            <div class="flex items-center gap-3 text-sm text-slate-500 mb-3">
              <span class="font-medium text-blue-600">{post.category}</span>
              <span>•</span>
              <time datetime={post.date}>
                {new Date(post.date).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}
              </time>
              <span>•</span>
              <span>{post.readTime}</span>
            </div>
            <h2 class="text-xl font-bold text-slate-900 mb-3">
              <a href={`/en-us/blog/${post.slug}/`} class="hover:text-blue-600 transition-colors">
                {post.title}
              </a>
            </h2>
            <p class="text-slate-600 mb-4">
              {post.excerpt}
            </p>
            <a
              href={`/en-us/blog/${post.slug}/`}
              class="inline-flex items-center text-blue-600 font-medium hover:text-blue-700 transition-colors"
            >
              Read the guide →
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

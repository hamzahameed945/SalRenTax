---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/navigation/Breadcrumbs.astro';
const locale = 'en-US' as const;

const blogPosts = [
  {
    title: 'How Much Rent Can I Afford in 2026?',
    slug: 'how-much-rent-can-i-afford-2026',
    excerpt: 'Use the 30% rule to turn your salary into a rent budget: $1,250 on $50k, $1,500 on $60k, $1,750 on $70k, $2,000 on $80k — plus when to use take-home pay instead of gross pay.',
    date: '2026-11-02',
    category: 'Rent',
    readTime: '8 min',
    image: '/og-default.png'
  },
{
title: 'Salary to Hourly: How to Convert Your Pay in 2026',
slug: 'salary-to-hourly-conversion-2026',
excerpt: 'Convert an annual salary to an hourly rate by dividing by your actual working hours: $50,000 a year is about $24.04 an hour on a 40-hour week, and $60,000 is about $28.85.',
date: '2026-11-03',
category: 'Salary',
readTime: '5 min',
image: '/og-default.png'
},
  {
    title: 'What Is Take-Home Pay? Gross Pay vs Net Pay Explained',
    slug: 'take-home-pay-explained-2026',
    excerpt: 'Take-home pay is what remains after payroll deductions are taken from gross pay — learn what is usually deducted and why two jobs with the same salary can pay differently.',
    date: '2026-11-03',
    category: 'Salary',
    readTime: '5 min',
    image: '/og-default.png'
  }
];

const schemaWebPage = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "PayRenTax Blog",
  "description": "Guides on rent affordability, paychecks and salary calculations in the United States",
  "url": "https://payrentax.me/en-us/blog/",
  "inLanguage": "en-US"
};
---

<BaseLayout
  locale={locale}
  title="PayRenTax Blog | Rent Affordability, Paychecks and Salary Guides"
  description="Guides on how much rent you can afford, paycheck calculations and salary planning in the United States."
  canonical="/en-us/blog/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schemaWebPage)} />
  </Fragment>

  <Breadcrumbs locale={locale} trail={[]} />

  <div class="mx-auto max-w-6xl px-4 py-10">
    <header class="mb-12">
      <h1 class="text-4xl font-bold text-slate-900 mb-4">PayRenTax Blog</h1>
      <p class="text-xl text-slate-600 max-w-3xl">
        Practical guides on rent affordability, paychecks and salary planning.
      </p>
    </header>

    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {blogPosts.map((post) => (
        <article class="rounded-xl border border-slate-200 bg-white overflow-hidden shadow-sm hover:shadow-md transition-shadow">
          <img
            src={post.image}
            alt={post.title}
            class="w-full h-48 object-cover"
          />
          <div class="p-6">
            <div class="flex items-center gap-3 text-sm text-slate-500 mb-3">
              <span class="font-medium text-blue-600">{post.category}</span>
              <span>•</span>
              <time datetime={post.date}>
                {new Date(post.date).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}
              </time>
              <span>•</span>
              <span>{post.readTime}</span>
            </div>
            <h2 class="text-xl font-bold text-slate-900 mb-3">
              <a href={`/en-us/blog/${post.slug}/`} class="hover:text-blue-600 transition-colors">
                {post.title}
              </a>
            </h2>
            <p class="text-slate-600 mb-4">
              {post.excerpt}
            </p>
            <a
              href={`/en-us/blog/${post.slug}/`}
              class="inline-flex items-center text-blue-600 font-medium hover:text-blue-700 transition-colors"
            >
              Read the guide →
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

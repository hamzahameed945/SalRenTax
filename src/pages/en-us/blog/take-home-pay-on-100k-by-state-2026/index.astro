---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import { buildLocalePath } from '../../../../i18n/utils';

const locale = 'en-US' as const;

const title = 'Take-Home Pay on $100,000 by State in 2026';

const description =
  'On a $100,000 salary in 2026, take-home pay runs from $71,004 in Oregon to $79,180 in nine states with no income tax — an $8,176 gap. See the full 50-state ranking and what it means for your paycheck.';

const canonical = '/en-us/blog/take-home-pay-on-100k-by-state-2026/';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: '2026-11-12',
  dateModified: '2026-11-12',
  author: {
    '@type': 'Organization',
    name: 'PayRenTax',
    url: 'https://payrentax.me',
  },
  publisher: {
    '@type': 'Organization',
    name: 'PayRenTax',
    url: 'https://payrentax.me',
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': 'https://payrentax.me/en-us/blog/take-home-pay-on-100k-by-state-2026/',
  },
};

const faqItems = [
  {
    q: 'How is take-home pay calculated in this study?',
    a: 'Each figure assumes a single filer with a $100,000 annual salary and no pre-tax deductions, using 2026 IRS federal brackets, the 2026 Social Security wage base of $184,500, and each state’s 2026 income tax brackets. State figures are estimates.',
  },
  {
    q: 'Which state has the highest take-home pay on $100,000?',
    a: 'Nine states with no individual income tax tie for first: Alaska, Florida, Nevada, New Hampshire, South Dakota, Tennessee, Texas, Washington, and Wyoming, each leaving $79,180 after federal taxes and FICA.',
  },
  {
    q: 'Which state has the lowest take-home pay on $100,000?',
    a: 'Oregon, at $71,004 — $8,176 less than the top states, driven by its $8,176 state income tax bill.',
  },
  {
    q: 'Does this include local taxes?',
    a: 'No. City and county income taxes (for example, New York City’s) are not modeled, so actual take-home in those places is lower.',
  },
  {
    q: 'Does moving to a no-income-tax state raise my take-home pay by the full gap?',
    a: 'Only the state-tax part changes. On $100,000, the gap between the highest and lowest states is $8,176 a year because that is the difference in state tax. Federal tax and FICA are the same in every state, and the study does not model cost of living, housing, or local taxes, which can be higher in a no-income-tax state.',
  },
];

---

<BaseLayout locale={locale} title={title} description={description} canonical={canonical}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqItems.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      })}
    />
  </Fragment>

  <main class="page">
    <Breadcrumbs locale={locale} trail={[{ label: 'Blog', href: buildLocalePath(locale, 'blog') }, { label: 'Take-Home Pay on $100,000 by State', href: buildLocalePath(locale, 'blog/take-home-pay-on-100k-by-state-2026') }]} />
    <article class="article">
      <header class="article-header">
        <p class="article-date">November 12, 2026</p>
        <h1>{title}</h1>
        <p class="article-intro">{description}</p>
      </header>

      <p>
        Two workers can earn the same $100,000 salary and take home
        very different amounts — the only difference is the state
        printed on their paystub. Our
        <a href="/en-us/study/take-home-pay-100k-by-state/">2026
        study</a> ran a $100,000 salary through federal and state tax
        rules for all 50 states, and the result is a gap of
        <strong>$8,176 a year</strong> between the best and worst
        states. This guide walks through the ranking, shows what the
        gap looks like per paycheck, and explains how the figures were
        worked out, using only the numbers from that study and simple
        arithmetic.
      </p>

      <div class="tldr-box">
        <p><strong>TL;DR:</strong></p>
        <ul>
          <li>
            Highest take-home on $100,000: <strong>$79,180</strong> in
            nine states with no individual income tax.
          </li>
          <li>
            Lowest take-home: <strong>$71,004</strong> in Oregon — an
            <strong>$8,176 a year</strong> gap, or about
            <strong>$681.33 a month</strong>.
          </li>
          <li>
            Federal tax and FICA are the same in every state — the
            whole gap comes from state income tax.
          </li>
          <li>
            California is not the worst: at $73,957 it sits 44th, ahead
            of Oregon, Hawaii, Maine and others on $100,000.
          </li>
          <li>
            Figures assume a single filer with no pre-tax deductions;
            local taxes are not counted.
          </li>
        </ul>
      </div>

      <nav class="toc" aria-label="On this page">
        <p><strong>On this page</strong></p>
        <ul>
          <li><a href="#the-gap">The $8,176 Gap: Same Salary, Different State</a></li>
          <li><a href="#top-10">The Top 10 States for Take-Home Pay on $100,000</a></li>
          <li><a href="#bottom-10">The Bottom 10 States</a></li>
          <li><a href="#how-calculated">How the Figures Are Calculated</a></li>
          <li><a href="#your-state">What to Do With Your State's Number</a></li>
          <li><a href="#faq">Frequently Asked Questions</a></li>
        </ul>
      </nav>

      <section id="the-gap" class="article-section">
        <h2>The $8,176 Gap: Same Salary, Different State</h2>
        <p>
          The headline result of the study is simple. A single filer
          earning $100,000 keeps <strong>$79,180</strong> in nine
          states — Alaska, Florida, Nevada, New Hampshire, South
          Dakota, Tennessee, Texas, Washington and Wyoming — and only
          <strong>$71,004</strong> in Oregon. The difference is
          <strong>$79,180 − $71,004 = $8,176 a year</strong>. That gap
          is the state income tax bill: $0 in the nine no-tax states
          and $8,176 in Oregon. Federal income tax and FICA
          (Social Security and Medicare) are identical in every state,
          so they cannot explain any of the difference.
        </p>

        <div class="formula-box">
          <p><strong>Take-home pay = $100,000 − federal tax − FICA − state tax</strong></p>
          <p><strong>Gap = $79,180 − $71,004 = $8,176 a year</strong></p>
          <p><strong>Monthly gap = $8,176 ÷ 12 = $681.33</strong></p>
        </div>

        <p>
          Spread over the year, the gap is easier to picture in monthly
          and per-paycheck terms:
        </p>

        <div class="example-box">
          <p><strong>Example: the $8,176 gap, per month and per paycheck</strong></p>
          <ul>
            <li>Monthly take-home in a no-tax state: $79,180 ÷ 12 = <strong>$6,598.33</strong></li>
            <li>Monthly take-home in Oregon: $71,004 ÷ 12 = <strong>$5,917.00</strong></li>
            <li>Monthly difference: $6,598.33 − $5,917.00 = <strong>$681.33</strong></li>
            <li>Biweekly paycheck in a no-tax state: $79,180 ÷ 26 = <strong>$3,045.38</strong></li>
            <li>Biweekly paycheck in Oregon: $71,004 ÷ 26 = <strong>$2,730.92</strong></li>
            <li>Difference per biweekly paycheck: <strong>about $314.46</strong></li>
          </ul>
        </div>

        <p>
          The effective tax rate tells the same story in percentages.
          In the nine no-tax states, total tax is $20,820 on $100,000,
          an effective rate of <strong>20.8%</strong>. In Oregon,
          total tax is $28,996, an effective rate of
          <strong>29.0%</strong>. Every other state falls between those
          two marks. Our guide on
          <a href="/en-us/blog/take-home-pay-explained-2026/">what
          take-home pay is</a> explains the deductions behind those
          totals, and our
          <a href="/en-us/blog/how-to-calculate-your-paycheck-2026/">paycheck
          guide</a> shows where each one appears on a paystub.
        </p>
      </section>

      <section id="top-10" class="article-section">
        <h2>The Top 10 States for Take-Home Pay on $100,000</h2>
        <p>
          Nine states tie for first place because they levy no
          individual income tax, so their workers keep the full
          $79,180 left after federal tax and FICA. The tenth spot goes
          to North Dakota, the best state that does tax income: its
          $691 state tax bill leaves <strong>$78,489</strong>, only
          $691 behind the leaders.
        </p>


---
import CalculatorResource from '../../../../components/content/CalculatorResource.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import SalaryToHourlyCalculator from '../../../../components/islands/SalaryToHourlyCalculator';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'es-ES' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'Calculadora de Salario a Hora España — PayRenTax',
  t.salary.salaryToHourly.intro,
  '/es-es/salary/calculadora-salario-hora/',
);

const faqItems = [
  {
    question: '¿Cómo calculo mi salario por hora en España?',
    answer:
      'Divide tu salario bruto anual entre las horas trabajadas al año. Con 40 horas semanales y 52 semanas (2.080 horas al año), si ganas €30.000 brutos, tu salario por hora sería €30.000 ÷ 2.080 = €14,42/hora.',
  },
  {
    question: '¿Cuál es el salario mínimo interprofesional (SMI) en 2026?',
    answer:
      'El Salario Mínimo Interprofesional (SMI) en España para 2026 está pendiente de actualización por el Gobierno. En 2025 fue de €1.184/mes en 14 pagas (€16.576/año), lo que equivale a €7,96/hora en jornada de 40h/semana. Consulta el BOE para el valor definitivo de 2026.',
  },
  {
    question: '¿Cuántas horas al año trabaja un empleado en España?',
    answer:
      'La jornada laboral máxima ordinaria en España es de 40 horas semanales (1.826 horas efectivas al año según el ET). Muchos convenios colectivos establecen jornadas inferiores. Hay 14 festivos nacionales y 30 días de vacaciones por convenio general.',
  },
  {
    question: '¿El salario por hora es bruto o neto?',
    answer:
      'Esta calculadora trabaja con salario bruto anual y devuelve un salario bruto por hora. El salario neto por hora es inferior tras descontar IRPF y Seguridad Social. Utiliza nuestra calculadora de nómina para estimar el neto.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  equivalentPageGroup="salary-to-hourly"
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: t.navigation.salary, href: buildLocalePath(locale, 'salary') },
      { label: t.salary.salaryToHourly.title, href: buildLocalePath(locale, 'salary/calculadora-salario-hora') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">{t.salary.salaryToHourly.h1}</h1>
    <p class="mt-3 max-w-2xl text-slate-600">{t.salary.salaryToHourly.intro}</p>

    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <SalaryToHourlyCalculator client:load locale={locale} currency="EUR" labels={t.salary.salaryToHourly.labels} />
    </div>

    <div class="mt-8">
      <InContentAd slotId="es-salary-hourly-1" />
    </div>

    <div class="mt-10 prose prose-slate max-w-none">
      <h2>Ejemplos de salario por hora — España 2026</h2>
      <table>
        <thead>
          <tr>
            <th>Salario bruto anual</th>
            <th>€/hora (40h/semana)</th>
            <th>€/hora (37,5h/semana)</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>€20.000</td><td>€9,62</td><td>€10,26</td></tr>
          <tr><td>€30.000</td><td>€14,42</td><td>€15,38</td></tr>
          <tr><td>€40.000</td><td>€19,23</td><td>€20,51</td></tr>
          <tr><td>€60.000</td><td>€28,85</td><td>€30,77</td></tr>
        </tbody>
      </table>
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.verifyProfessional} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="Preguntas frecuentes sobre el salario por hora" items={faqItems} />
  </article>
  <CalculatorResource locale="es-ES" category="salary" />
</BaseLayout>

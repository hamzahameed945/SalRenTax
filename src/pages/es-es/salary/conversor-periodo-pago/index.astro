---
import CalculatorResource from '../../../../components/content/CalculatorResource.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import PayFrequencyConverter from '../../../../components/islands/PayFrequencyConverter';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'es-ES' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'Conversor de Periodo de Pago España — PayRenTax',
  t.salary.payFrequency.intro,
  '/es-es/salary/conversor-periodo-pago/',
);

const faqItems = [
  {
    question: '¿Cómo convierto mi salario mensual a anual en España?',
    answer:
      'Multiplica tu salario mensual por 12 para obtener el bruto anual base. Sin embargo, en España muchos convenios contemplan 14 o más pagas, con pagas extra en verano y Navidad, por lo que debes considerar el total de pagas del año.',
  },
  {
    question: '¿Qué son las pagas extraordinarias en España?',
    answer:
      'El Estatuto de los Trabajadores establece un mínimo de 2 pagas extraordinarias al año (normalmente en junio y diciembre), equivalentes a una mensualidad cada una, salvo disposición más favorable en convenio. El importe puede ser prorrateado mensualmente.',
  },
  {
    question: '¿Con qué frecuencia se paga el salario en España?',
    answer:
      'En España el pago mensual es el más habitual para la gran mayoría de trabajadores. Algunos sectores (especialmente agricultura y hostelería) pueden pagar semanalmente o quincenalmente según el convenio colectivo aplicable.',
  },
  {
    question: '¿Cómo afecta la frecuencia de pago a las retenciones de IRPF?',
    answer:
      'La retención de IRPF se calcula sobre el salario anualizado, por lo que el porcentaje de retención es el mismo independientemente de si cobras mensual o semanalmente. La empresa aplica la parte proporcional en cada período de pago.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  equivalentPageGroup="pay-frequency"
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: t.navigation.salary, href: buildLocalePath(locale, 'salary') },
      { label: t.salary.payFrequency.title, href: buildLocalePath(locale, 'salary/conversor-periodo-pago') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">{t.salary.payFrequency.h1}</h1>
    <p class="mt-3 max-w-2xl text-slate-600">{t.salary.payFrequency.intro}</p>

    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <PayFrequencyConverter client:load t={t} locale={locale} currency="EUR" labels={t.salary.payFrequency.labels} />
    </div>

    <div class="mt-8">
      <InContentAd slotId="es-pay-freq-1" />
    </div>

    <div class="mt-10 prose prose-slate max-w-none">
      <h2>Tabla de conversión de períodos de pago — España</h2>
      <table>
        <thead>
          <tr>
            <th>Período</th>
            <th>Períodos al año</th>
            <th>Fórmula desde salario anual</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>Semanal</td><td>52</td><td>Anual ÷ 52</td></tr>
          <tr><td>Quincenal</td><td>26</td><td>Anual ÷ 26</td></tr>
          <tr><td>Mensual</td><td>12</td><td>Anual ÷ 12</td></tr>
          <tr><td>Anual</td><td>1</td><td>—</td></tr>
        </tbody>
      </table>
      <p class="text-sm text-slate-500 mt-4">
        Nota: En España con 14 pagas, el salario mensual base es el bruto anual ÷ 14, pero las pagas extra se pagan en meses específicos o se prorratean.
      </p>
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.verifyProfessional} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="Preguntas frecuentes sobre periodos de pago" items={faqItems} />
  </article>
  <CalculatorResource locale="es-ES" category="salary" />
</BaseLayout>

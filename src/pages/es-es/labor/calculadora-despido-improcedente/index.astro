---
import CalculatorResource from '../../../../components/content/CalculatorResource.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import EsFiniquitoCalculator from '../../../../components/islands/EsFiniquitoCalculator';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'es-ES' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'Calculadora de Despido Improcedente 2026 — PayRenTax',
  'Calcula la indemnización por despido improcedente en España 2026: 33 días/año (post-2012) + 45 días/año (pre-2012). Tope 24 mensualidades.',
  '/es-es/labor/calculadora-despido-improcedente/',
);

const faqItems = [
  {
    question: '¿Cuándo es improcedente un despido?',
    answer:
      'Un despido es improcedente cuando el empleador no puede justificarlo o no sigue el procedimiento legal correcto (falta de carta de despido, incumplimiento de preaviso, causas no acreditadas). El trabajador puede optar por la readmisión o por la indemnización.',
  },
  {
    question: '¿Qué pasa con contratos anteriores al 12 de febrero de 2012?',
    answer:
      'La reforma laboral (RDL 3/2012) cambió la indemnización de 45 a 33 días/año. Para trabajadores con contrato anterior, los años de servicio previos al 12-feb-2012 mantienen los 45 días/año (con tope de 42 mensualidades para ese tramo), y los años posteriores se calculan a 33 días/año.',
  },
  {
    question: '¿Es obligatorio aceptar la indemnización?',
    answer:
      'No. Ante un despido improcedente el trabajador puede optar entre la indemnización o la readmisión. Si el empleador reconoce la improcedencia al notificar el despido o antes del acto de conciliación, la indemnización queda exenta de IRPF.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  equivalentPageGroup="es-despido-improcedente"
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: t.navigation.labor, href: buildLocalePath(locale, 'labor') },
      { label: 'Despido improcedente', href: buildLocalePath(locale, 'labor/calculadora-despido-improcedente') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">Calculadora de Despido Improcedente 2026</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      Calcula la indemnización por despido improcedente en España: 33 días por año de servicio
      (contratos y años post 12-feb-2012) más 45 días por año de servicio anterior a esa fecha.
      Incluye también las pagas extra proporcionales y las vacaciones pendientes.
    </p>

    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <EsFiniquitoCalculator client:load defaultDismissal="unfairDismissal" />
    </div>

    <div class="mt-8">
      <InContentAd slotId="es-despido-1" />
    </div>

    <div class="mt-10 prose prose-slate max-w-none">
      <h2>Cálculo de la indemnización por despido improcedente</h2>
      <p>
        El artículo 56 del Estatuto de los Trabajadores, modificado por el RDL 3/2012, establece
        la siguiente fórmula de doble tramo:
      </p>
      <ul>
        <li>
          <strong>Años anteriores al 12-feb-2012:</strong> 45 días de salario por año trabajado,
          con un tope de 42 mensualidades para ese tramo.
        </li>
        <li>
          <strong>Años desde el 12-feb-2012:</strong> 33 días de salario por año trabajado,
          con un tope global combinado de 24 mensualidades.
        </li>
      </ul>
      <p>
        El salario regulador diario se calcula dividiendo el salario bruto anual (incluyendo
        los conceptos que integran el salario) entre 365 días.
      </p>
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.verifyProfessional} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="Preguntas frecuentes sobre despido improcedente" items={faqItems} />
  </article>
  <CalculatorResource locale="es-ES" category="labor" />
</BaseLayout>

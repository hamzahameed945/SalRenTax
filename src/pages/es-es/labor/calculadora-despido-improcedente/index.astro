---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import { buildLocalePath } from '../../../../i18n/utils';
import EsFiniquitoCalculator from '../../../../components/islands/EsFiniquitoCalculator';
const locale = 'es-ES' as const;
---
<BaseLayout locale={locale} title="Calculadora de Despido Improcedente 2026 — SalRenTax" description="Estima la indemnización por despido improcedente en España." canonical="/es-es/labor/calculadora-despido-improcedente/">
  <Breadcrumbs locale={locale} trail={[{label:'Calculadoras laborales',href:buildLocalePath(locale,'labor')}]} />
  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">Calculadora de Despido Improcedente 2026</h1>
    <p class="mt-3 max-w-2xl text-slate-600">La herramienta usa 33 días por año y limita la indemnización según un máximo de 24 mensualidades en este modelo simplificado.</p>
    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><EsFiniquitoCalculator client:load /></div>
    <div class="mt-8"><InContentAd slotId="es-despido-1" /></div>
    <div class="mt-10 prose prose-slate max-w-none"><h2>Indemnización por despido improcedente</h2><p>La herramienta usa 33 días por año y limita la indemnización según un máximo de 24 mensualidades en este modelo simplificado.</p></div>
  </article>
</BaseLayout>

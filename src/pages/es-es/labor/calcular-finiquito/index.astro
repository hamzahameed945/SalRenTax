---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import EsFiniquitoCalculator from '../../../../components/islands/EsFiniquitoCalculator';
import { buildLocalePath } from '../../../../i18n/utils';

const locale = 'es-ES' as const;
const title = 'Calcular Finiquito 2026 — SalRenTax';
const description = 'Calcula tu finiquito e indemnización estimada en España 2026.';
const canonical = '/es-es/labor/calcular-finiquito/';
const faqItems = [{ question: '¿Qué calcula esta herramienta?', answer: 'Estimación de finiquito con vacaciones pendientes, pagas extra proporcionales y, cuando corresponde, indemnización por despido.' }];
---
<BaseLayout locale={locale} title={title} description={description} canonical={canonical}>
  <Breadcrumbs locale={locale} trail={[
    { label: 'Calcular Finiquito', href: buildLocalePath(locale, 'labor/calcular-finiquito') },
  ]} />
  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">Calcular Finiquito 2026</h1>
    <p class="mt-3 max-w-2xl text-slate-600">Estimación de finiquito con vacaciones pendientes, pagas extra proporcionales y, cuando corresponde, indemnización por despido.</p>
    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <EsFiniquitoCalculator client:load />
    </div>
    <div class="mt-8"><InContentAd slotId="es-es-labor-calcular-finiquito-1" /></div>
    <div class="mt-10 prose prose-slate max-w-none">
      <h2>Información importante</h2>
      <p>Este calculador usa un modelo explícito y simplificado para apoyar una estimación inicial. Los casos reales pueden variar por deducciones, convenios, topes legales y otros datos personales.</p>
    </div>
    <CalculatorFAQ heading="Preguntas frecuentes" items={faqItems} />
  </article>
</BaseLayout>

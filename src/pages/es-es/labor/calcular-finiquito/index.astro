---
import CalculatorResource from '../../../../components/content/CalculatorResource.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import EsFiniquitoCalculator from '../../../../components/islands/EsFiniquitoCalculator';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';

const locale = 'es-ES' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  t.salary.finiquito.title,
  t.salary.finiquito.metaDescription,
  '/es-es/labor/calcular-finiquito/',
);

const faqItems = [
  {
    question: '¿Qué incluye el finiquito en España?',
    answer:
      'El finiquito debe incluir: los días trabajados del último mes pendientes de cobro, las vacaciones no disfrutadas, la parte proporcional de las pagas extraordinarias del período trabajado, y la indemnización por despido cuando corresponda.',
  },
  {
    question: '¿Cuánto es la indemnización por despido improcedente?',
    answer:
      'En España la indemnización por despido improcedente es de 33 días de salario por año trabajado con un máximo de 24 mensualidades (para contratos firmados desde el 12 de febrero de 2012). Para contratos o años de servicio anteriores a esa fecha se aplican 45 días/año con un tope de 42 mensualidades.',
  },
  {
    question: '¿Cuánto es la indemnización por despido objetivo?',
    answer:
      'La indemnización por despido objetivo (causas económicas, técnicas, organizativas o productivas) es de 20 días de salario por año de servicio, con un máximo de 12 mensualidades (Art. 53 ET).',
  },
  {
    question: '¿El finiquito está exento de IRPF?',
    answer:
      'La indemnización mínima legal por despido improcedente está exenta de IRPF (Art. 7.e LIRPF). El importe que supere ese mínimo tributa como renta irregular con una reducción del 30% si se ha percibido en un único año. Las vacaciones y pagas extra proporcionales sí están sujetas a retención normal.',
  },
  {
    question: '¿Cuáles son las vacaciones que me deben pagar al salir?',
    answer:
      'Tienes derecho al pago de los días de vacaciones devengados y no disfrutados, calculados proporcionalmente al tiempo trabajado ese año. El convenio colectivo puede establecer días de vacaciones superiores al mínimo legal de 30 días laborables anuales.',
  },
  {
    question: '¿Qué son las pagas extra proporcionales?',
    answer:
      'Al salir de una empresa, tienes derecho a cobrar la parte proporcional de las pagas extraordinarias correspondiente al tiempo trabajado desde que se devengó la última paga extra. Por ejemplo, si tienes 14 pagas y sales en septiembre, te corresponden 3 meses de devengo de la paga de diciembre.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  equivalentPageGroup="es-finiquito-calculator"
>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: t.navigation.labor, href: buildLocalePath(locale, 'labor') },
      { label: t.salary.finiquito.title, href: buildLocalePath(locale, 'labor/calcular-finiquito') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">{t.salary.finiquito.h1}</h1>
    <p class="mt-3 max-w-2xl text-slate-600">{t.salary.finiquito.intro}</p>

    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <EsFiniquitoCalculator client:load />
    </div>

    <div class="mt-8">
      <InContentAd slotId="es-finiquito-1" />
    </div>

    <div class="mt-10 prose prose-slate max-w-none">
      <h2>Tipos de indemnización por despido — España 2026</h2>
      <table>
        <thead>
          <tr><th>Tipo de despido</th><th>Días/año</th><th>Tope máximo</th><th>Base de cálculo</th></tr>
        </thead>
        <tbody>
          <tr>
            <td>Despido improcedente (post 12-feb-2012)</td>
            <td>33 días/año</td>
            <td>24 mensualidades</td>
            <td>Salario regulador diario</td>
          </tr>
          <tr>
            <td>Despido improcedente (pre 12-feb-2012)</td>
            <td>45 días/año</td>
            <td>42 mensualidades</td>
            <td>Salario regulador diario</td>
          </tr>
          <tr>
            <td>Despido objetivo (Art. 52 ET)</td>
            <td>20 días/año</td>
            <td>12 mensualidades</td>
            <td>Salario regulador diario</td>
          </tr>
          <tr>
            <td>Baja voluntaria</td>
            <td>Sin indemnización</td>
            <td>—</td>
            <td>—</td>
          </tr>
        </tbody>
      </table>
      <p class="text-sm">
        Fuente: Estatuto de los Trabajadores Arts. 53, 56; RDL 3/2012 de 10 de febrero.
      </p>

      <h2>Vacaciones mínimas legales — España</h2>
      <p>
        El ET establece un mínimo de 30 días laborables (aproximadamente 22 días hábiles) de vacaciones
        anuales. Al salir de la empresa, tienes derecho a cobrar los días devengados y no disfrutados,
        calculados proporcional al tiempo trabajado en el año natural.
      </p>
    </div>

    <p class="mt-8 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.verifyProfessional} {t.disclaimers.dataSource}
    </p>

    <CalculatorFAQ heading="Preguntas frecuentes sobre finiquito e indemnización" items={faqItems} />
  </article>
  <CalculatorResource locale="es-ES" category="labor" />
</BaseLayout>

---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/navigation/Breadcrumbs.astro';
import CalculatorFAQ from '../../../../components/calculator/CalculatorFAQ.astro';
import InContentAd from '../../../../components/ads/InContentAd.astro';
import JsonLd from '../../../../components/seo/JsonLd.astro';
import { getDictionary } from '../../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../../lib/seo/metadata';
import { buildLocalePath } from '../../../../i18n/utils';
import { buildFaqJsonLd } from '../../../../lib/seo/structuredData';
import { esFiniquitoEngine, type EsDismissalType } from '../../../../calculators/labor/engines/esFiniquito';

const locale = 'es-ES' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  'Calcular Finiquito 2026 — Indemnización por Despido — SalRenTax',
  'Calcula tu finiquito por baja voluntaria o la indemnización por despido improcedente en España 2026. Incluye vacaciones pendientes e indemnización.',
  '/es-es/labor/calcular-finiquito/',
);

const faqItems = [
  {
    question: '¿Qué incluye el finiquito en España?',
    answer: 'El finiquito incluye: los días trabajados del mes en curso, la parte proporcional de pagas extra, las vacaciones no disfrutadas y, si procede, la indemnización por despido.',
  },
  {
    question: '¿Cuánto es la indemnización por despido improcedente?',
    answer: 'Por despido improcedente, corresponden 33 días de salario por año trabajado, con un máximo de 24 mensualidades. Para contratos anteriores al 12 de febrero de 2012, el cálculo puede ser distinto.',
  },
  {
    question: '¿Tengo derecho a indemnización si me voy voluntariamente?',
    answer: 'En caso de baja voluntaria (renuncia), no corresponde indemnización. Solo se abona el finiquito: parte proporcional de pagas extra y vacaciones pendientes.',
  },
  {
    question: '¿Qué es el despido objetivo?',
    answer: 'El despido por causas objetivas (art. 52 ET) corresponde 20 días por año trabajado, con un máximo de 12 mensualidades. Se aplica por causas económicas, organizativas o técnicas.',
  },
];

const faqJsonLd = buildFaqJsonLd(faqItems);
---

<BaseLayout locale={locale} title={meta.title} description={meta.description} canonical={meta.canonical}>
  <JsonLd entries={[faqJsonLd]} />
  <Breadcrumbs
    locale={locale}
    trail={[
      { label: t.navigation.labor, href: buildLocalePath(locale, 'labor') },
      { label: 'Calcular finiquito', href: buildLocalePath(locale, 'labor/calcular-finiquito') },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">Calculadora de Finiquito e Indemnización 2026</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      Calcula una estimación de tu finiquito por baja voluntaria o la indemnización por despido objetivo
      o improcedente según el Estatuto de los Trabajadores.
    </p>

    <!-- Static calculator form rendered server-side style with client island -->
    <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm" id="finiquito-calc">
      <p class="text-sm text-slate-500 mb-4">Introduce tus datos para estimar el finiquito:</p>
      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Salario bruto anual (€)</label>
          <input id="grossAnnual" type="number" value="28000" class="w-full rounded-md border border-slate-300 px-3 py-2 text-slate-900" placeholder="p. ej. 28000" />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Años trabajados</label>
          <input id="yearsWorked" type="number" value="3" class="w-full rounded-md border border-slate-300 px-3 py-2 text-slate-900" placeholder="p. ej. 3" />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Días de vacaciones pendientes</label>
          <input id="daysHoliday" type="number" value="5" class="w-full rounded-md border border-slate-300 px-3 py-2 text-slate-900" placeholder="p. ej. 5" />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Tipo de finalización</label>
          <select id="dismissalType" class="w-full rounded-md border border-slate-300 px-3 py-2 text-slate-900">
            <option value="voluntary">Baja voluntaria</option>
            <option value="objectiveDismissal">Despido objetivo (20 días/año)</option>
            <option value="unfairDismissal">Despido improcedente (33 días/año)</option>
          </select>
        </div>
      </div>
      <button id="calcBtn" class="mt-6 rounded-md bg-accent px-6 py-2 font-semibold text-white hover:bg-accent-dark">Calcular finiquito</button>
      <div id="result" class="mt-6 rounded-xl bg-slate-50 p-6 hidden">
        <p class="text-sm text-slate-500 mb-2">Estimación del finiquito:</p>
        <p id="total" class="text-3xl font-bold text-accent"></p>
        <dl id="breakdown" class="mt-4 space-y-2 text-sm text-slate-700"></dl>
      </div>
    </div>

    <div class="mt-8">
      <InContentAd slotId="es-finiquito-1" />
    </div>

    <div class="mt-10 prose prose-slate max-w-none">
      <h2>¿Cómo se calcula el finiquito en España?</h2>
      <p>
        El finiquito es la liquidación de los haberes pendientes al finalizar la relación laboral.
        Su cálculo depende del motivo de la extinción del contrato:
      </p>
      <h3>Baja voluntaria</h3>
      <p>Solo incluye: parte proporcional de pagas extra + vacaciones no disfrutadas. No hay indemnización.</p>
      <h3>Despido objetivo (causas económicas, art. 52 ET)</h3>
      <p><strong>20 días por año trabajado</strong>, máximo 12 mensualidades.</p>
      <h3>Despido improcedente</h3>
      <p><strong>33 días por año trabajado</strong>, máximo 24 mensualidades.</p>
    </div>

    <p class="mt-6 text-xs text-slate-500">
      {t.disclaimers.general} {t.disclaimers.verifyProfessional}
    </p>

    <CalculatorFAQ heading="Preguntas frecuentes sobre finiquito e indemnización" items={faqItems} />
  </article>
</BaseLayout>

<script>
  const btn = document.getElementById('calcBtn');
  btn?.addEventListener('click', () => {
    const gross = parseFloat((document.getElementById('grossAnnual') as HTMLInputElement).value);
    const years = parseFloat((document.getElementById('yearsWorked') as HTMLInputElement).value);
    const days = parseFloat((document.getElementById('daysHoliday') as HTMLInputElement).value) || 0;
    const type = (document.getElementById('dismissalType') as HTMLSelectElement).value;

    if (!gross || gross <= 0 || !years || years < 0) return;

    const dailyRate = gross / 365;
    const proportionalPay = (gross / 12) * 0.5;
    const holidayPay = days * dailyRate;
    let severancePay = 0;
    if (type === 'objectiveDismissal') severancePay = 20 * dailyRate * Math.min(years, 12);
    if (type === 'unfairDismissal') severancePay = 33 * dailyRate * Math.min(years, 24);

    const total = proportionalPay + holidayPay + severancePay;
    const fmt = (v: number) => new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR' }).format(v);

    const resultEl = document.getElementById('result') as HTMLElement;
    const totalEl = document.getElementById('total') as HTMLElement;
    const breakdownEl = document.getElementById('breakdown') as HTMLElement;

    resultEl.classList.remove('hidden');
    totalEl.textContent = fmt(total);
    breakdownEl.innerHTML = `
      <div class="flex justify-between border-b border-slate-200 pb-1"><dt>Parte proporcional pagas extra</dt><dd>${fmt(proportionalPay)}</dd></div>
      <div class="flex justify-between border-b border-slate-200 pb-1"><dt>Vacaciones no disfrutadas</dt><dd>${fmt(holidayPay)}</dd></div>
      ${severancePay > 0 ? `<div class="flex justify-between border-b border-slate-200 pb-1"><dt>Indemnización</dt><dd>${fmt(severancePay)}</dd></div>` : ''}
    `;
  });
</script>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/navigation/Breadcrumbs.astro';
import { getDictionary } from '../../../i18n/dictionaries';
import { buildPageMetadata } from '../../../lib/seo/metadata';
import { buildLocalePath } from '../../../i18n/utils';

const locale = 'es-AR' as const;
const t = getDictionary(locale);
const meta = buildPageMetadata(
  `${t.labor.categoryTitle} Argentina — ${t.meta.siteTitleSuffix}`,
  t.labor.categoryIntro,
  '/es-ar/labor/',
);

const pages = [
  { slug: 'labor/aguinaldo-500000', title: 'Aguinaldo de $500.000', desc: 'Segunda cuota estimada: $250.000' },
  { slug: 'labor/aguinaldo-800000', title: 'Aguinaldo de $800.000', desc: 'Segunda cuota estimada: $400.000' },
  { slug: 'labor/aguinaldo-1000000', title: 'Aguinaldo de $1.000.000', desc: 'Segunda cuota estimada: $500.000' },
  { slug: 'labor/aguinaldo-1500000', title: 'Aguinaldo de $1.500.000', desc: 'Segunda cuota estimada: $750.000' },
  { slug: 'labor/aguinaldo-2000000', title: 'Aguinaldo de $2.000.000', desc: 'Segunda cuota estimada: $1.000.000' },
  { slug: 'labor/aguinaldo-3000000', title: 'Aguinaldo de $3.000.000', desc: 'Segunda cuota estimada: $1.500.000' },
  { slug: 'labor/aguinaldo-5000000', title: 'Aguinaldo de $5.000.000', desc: 'Segunda cuota estimada: $2.500.000' },
];
---

<BaseLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <Breadcrumbs
    locale={locale}
    trail={[{ label: t.navigation.labor, href: buildLocalePath(locale, 'labor') }]}
  />
  <section class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">{t.labor.categoryTitle} Argentina</h1>
    <p class="mt-3 text-slate-600">{t.labor.categoryIntro}</p>
    <ul class="mt-8 space-y-3">
      {pages.map((page) => (
        <li class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm hover:border-accent transition-colors">
          <a
            href={buildLocalePath(locale, page.slug)}
            class="font-semibold text-accent hover:underline"
          >
            {page.title}
          </a>
          <p class="mt-1 text-sm text-slate-500">{page.desc}</p>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

---
import { getDictionary } from '../../i18n/dictionaries';
import { ACTIVE_LOCALES, type LocaleCode } from '../../i18n/types';
import { buildLocalePath } from '../../i18n/utils';
import { CONTACT_EMAIL } from '../../lib/seo/site';
import { getActivePagesForLocale } from '../../seo/page-registry';

export interface Props {
  locale: LocaleCode;
}
const { locale } = Astro.props;
const t = getDictionary(locale);
// Only link to category pages that actually exist for this locale, so the footer never points at a 404.
const activePages = getActivePagesForLocale(locale);
const footerCategories = (['salary', 'rent', 'tax', 'labor'] as const).filter((category) =>
  activePages.some((page) => page.pageType === 'category' && page.category === category),
);
const year = new Date().getFullYear();
const countries: Record<LocaleCode, string> = {
  'en-US': 'United States',
  'en-GB': 'United Kingdom',
  'en-IE': 'Ireland',
  'pt-BR': 'Brazil',
  'es-ES': 'Spain',
  'es-MX': 'Mexico',
  'de-DE': 'Germany',
  'nl-NL': 'Netherlands',
};
---

<footer class="footer-styled">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <a href={buildLocalePath(locale)} class="footer-brand">
        {t.common.siteName}
      </a>
      <p class="mt-3 max-w-xs leading-6">
        PayRenTax offers free salary, tax, rent, and labor calculators that use country-specific
        information and explain the assumptions behind each estimate.
      </p>
      <p class="mt-4 text-xs leading-5">
        Calculator results are provided for general informational purposes. They are not a
        substitute for official tax calculations, payroll records, or professional advice.
      </p>
      <p class="mt-4 text-xs leading-5">
        <a class="footer-email" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      </p>
    </div>
    <div>
      <h2 class="footer-heading">Calculators</h2>
      <div class="footer-links">
        <a href="/search/">Search all calculators</a>
        {footerCategories.map((category) => (
          <a href={buildLocalePath(locale, category)}>{t.navigation[category]}</a>
        ))}
      </div>
    </div>
    <div>
      <h2 class="footer-heading">Countries</h2>
      <div class="footer-links">
        {ACTIVE_LOCALES.map((countryLocale) => (
          <a href={buildLocalePath(countryLocale)}>{countries[countryLocale]}</a>
        ))}
      </div>
    </div>
    <div>
      <h2 class="footer-heading">Company &amp; legal</h2>
      <div class="footer-links">
        <a href="/about/">About PayRenTax</a>
        <a href="/contact/">Contact</a>
        <a href="/data-sources/">Data sources</a>
        <a href="/how-calculators-work/">How calculators work</a>
        <a href="/updates/">Updates</a>
        <a href="/privacy/">Privacy policy</a>
        <a href="/disclaimer/">Disclaimer</a>
        <a href="/terms/">Terms of use</a>
        <a href="/cookie-policy/">Cookie information</a>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 sm:flex-row sm:items-center sm:justify-between">
      <span>
        &copy; {year} {t.common.siteName}
      </span>
      <span>
        Built to make financial calculations easier to understand, with clear assumptions and
        country-specific estimates.
      </span>
    </div>
  </div>
</footer>

<style>
  .footer-styled {
    margin-top: 0;
    border-top: 1px solid #e2e8f0;
    background: #f8fafc;
    color: #64748b;
    font-size: 0.875rem;
  }
  .footer-brand {
    color: #0f172a;
    font-size: 1.15rem;
    font-weight: 800;
    text-decoration: none;
  }
  .footer-email {
    color: #0f6e5b;
    font-weight: 600;
    text-decoration: none;
  }
  .footer-email:hover {
    text-decoration: underline;
  }
  .footer-heading {
    margin: 0 0 0.8rem;
    color: #0f172a;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .footer-links {
    display: grid;
    gap: 0.48rem;
  }
  .footer-links a {
    color: #64748b;
    text-decoration: none;
  }
  .footer-links a:hover {
    color: #0f6e5b;
    text-decoration: underline;
  }
  .footer-bottom {
    border-top: 1px solid #e2e8f0;
    padding: 1rem 0;
    font-size: 0.75rem;
  }
</style>

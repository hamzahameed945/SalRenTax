---
import { getDictionary } from '../../i18n/dictionaries';
import { buildLocalePath } from '../../i18n/utils';
import { buildCanonical } from '../../lib/seo/metadata';
import { buildBreadcrumbJsonLd } from '../../lib/seo/structuredData';
import JsonLd from '../seo/JsonLd.astro';
import type { LocaleCode } from '../../i18n/types';

export interface Crumb {
  label: string;
  href: string;
}

export interface Props {
  locale: LocaleCode;
  trail: Crumb[]; // does not include Home, which is added automatically
}
const { locale, trail } = Astro.props;
const t = getDictionary(locale);
const crumbs: Crumb[] = [
  { label: t.navigation.breadcrumbHome, href: buildLocalePath(locale) },
  ...trail,
];
const breadcrumbJsonLd = buildBreadcrumbJsonLd(
  crumbs.map((c) => ({ label: c.label, url: buildCanonical(c.href) })),
);
---

<JsonLd entries={[breadcrumbJsonLd]} />
<nav aria-label="Breadcrumb" class="mx-auto max-w-6xl px-4 pt-6 text-sm text-slate-500">
  <ol class="flex flex-wrap items-center gap-1">
    {crumbs.map((crumb, i) => (
      <li class="flex items-center gap-1">
        {i > 0 && <span aria-hidden="true">/</span>}
        {i === crumbs.length - 1 ? (
          <span aria-current="page" class="text-slate-700">
            {crumb.label}
          </span>
        ) : (
          <a href={crumb.href} class="hover:text-slate-800">
            {crumb.label}
          </a>
        )}
      </li>
    ))}
  </ol>
</nav>

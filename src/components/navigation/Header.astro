---
import { getDictionary } from '../../i18n/dictionaries';
import { getLocaleConfig } from '../../data/locales';
import { buildLocalePath } from '../../i18n/utils';
import type { LocaleCode } from '../../i18n/types';

export interface Props {
  locale: LocaleCode;
}
const { locale } = Astro.props;
const t = getDictionary(locale);
const config = getLocaleConfig(locale);
---

<header class="border-b border-slate-200 bg-white">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
    <a href={buildLocalePath(locale)} class="text-lg font-bold tracking-tight text-slate-900">
      {t.common.siteName}
    </a>
    <nav
      aria-label={t.navigation.breadcrumbHome}
      class="flex gap-6 text-sm font-medium text-slate-600"
    >
      {config.categories.map((category) => (
        <a href={buildLocalePath(locale, category)} class="hover:text-slate-900">
          {t.navigation[category]}
        </a>
      ))}
    </nav>
  </div>
</header>

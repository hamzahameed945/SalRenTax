---
import { getDictionary } from '../../i18n/dictionaries';
import { getLocaleConfig } from '../../data/locales';
import { buildLocalePath } from '../../i18n/utils';
import type { LocaleCode } from '../../i18n/types';

export interface Props {
  locale: LocaleCode;
}
const { locale } = Astro.props;
const t = getDictionary(locale);
const config = getLocaleConfig(locale);
---

<header class="header-glass">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
    <a href={buildLocalePath(locale)} class="header-logo">
      {t.common.siteName}
    </a>
    <nav
      aria-label={t.navigation.breadcrumbHome}
      class="header-nav"
    >
      {config.categories.map((category) => (
        <a href={buildLocalePath(locale, category)} class="header-nav-link">
          {t.navigation[category]}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .header-glass {
    position: relative;
    z-index: 10;
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(226, 232, 240, 0.6);
  }

  .header-logo {
    font-size: 1.125rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #0f172a;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .header-logo:hover {
    opacity: 0.7;
  }

  .header-nav {
    display: flex;
    gap: 1.5rem;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .header-nav-link {
    color: #475569;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .header-nav-link:hover {
    color: #0f172a;
  }
</style>

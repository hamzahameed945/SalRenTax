---
import { getDictionary } from '../../i18n/dictionaries';
import { getLocaleConfig } from '../../data/locales';
import { ACTIVE_LOCALES, type LocaleCode } from '../../i18n/types';
import { buildLocalePath } from '../../i18n/utils';
import { getActivePagesForLocale } from '../../seo/page-registry';

export interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const config = getLocaleConfig(locale);
const calculatorPages = getActivePagesForLocale(locale)
  .filter((page) => page.pageType === 'calculator')
  .slice(0, 8);
const localeLabels: Record<LocaleCode, string> = {
  'en-US': '🇺🇸 United States · English',
  'en-GB': '🇬🇧 United Kingdom · English',
  'en-IE': '🇮🇪 Ireland · English',
  'pt-BR': '🇧🇷 Brazil · Português',
  'es-ES': '🇪🇸 Spain · Español',
  'es-MX': '🇲🇽 Mexico · Español',
  'de-DE': '🇩🇪 Germany · Deutsch',
  'nl-NL': '🇳🇱 Netherlands · Nederlands',
};
---

<header class="header-glass">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4" style="min-height:4.5rem;">
    <a href="/" class="header-logo" aria-label={`${t.common.siteName} home`}>
      <img src="/logo.svg" alt={t.common.siteName} class="header-logo-img" />
    </a>

    <!-- Hamburger toggle (mobile only) -->
    <button class="hamburger" id="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">
      <span class="hamburger__line"></span>
      <span class="hamburger__line"></span>
      <span class="hamburger__line"></span>
    </button>

    <!-- Navigation -->
    <nav aria-label="Primary navigation" class="header-nav" id="nav-menu">
      <details class="header-menu">
        <summary>Calculators <span class="chevron" aria-hidden="true"></span></summary>
        <div class="header-menu-panel calculator-panel">
          {calculatorPages.map((page) => (
            <a href={buildLocalePath(locale, page.slug)}>{page.primaryKeyword}</a>
          ))}
          <a class="header-menu-all" href="/search/">
            Search all calculators →
          </a>
        </div>
      </details>
      {config.categories.map((category) => (
        <a href={buildLocalePath(locale, category)} class="header-nav-link">
          {t.navigation[category]}
        </a>
      ))}
      <a href="/how-calculators-work/" class="header-nav-link">
        How it works
      </a>

      <!-- Locale selector: shown inline in mobile drawer, separate on desktop -->
      <details class="locale-menu mobile-only-locale">
        <summary>Country &amp; language <span class="chevron" aria-hidden="true"></span></summary>
        <div class="locale-menu-panel">
          {ACTIVE_LOCALES.map((countryLocale) => (
            <a
              href={buildLocalePath(countryLocale)}
              class:list={{ 'is-current': countryLocale === locale }}
            >
              {localeLabels[countryLocale]}
            </a>
          ))}
        </div>
      </details>
    </nav>

    <!-- Desktop locale selector (outside nav, at far right) -->
    <details class="locale-menu desktop-locale">
      <summary>Country &amp; language <span class="chevron" aria-hidden="true"></span></summary>
      <div class="locale-menu-panel">
        {ACTIVE_LOCALES.map((countryLocale) => (
          <a
            href={buildLocalePath(countryLocale)}
            class:list={{ 'is-current': countryLocale === locale }}
          >
            {localeLabels[countryLocale]}
          </a>
        ))}
      </div>
    </details>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isOpen = menu.classList.toggle('is-open');
      toggle.classList.toggle('is-active', isOpen);
      toggle.setAttribute('aria-expanded', String(isOpen));
    });
    // Close menu when clicking a link
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.remove('is-open');
        toggle.classList.remove('is-active');
        toggle.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>

<style>
  /* ── Glass header ──────────────────────────────────────────────── */
  .header-glass {
    position: relative;
    z-index: 20;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(226, 232, 240, 0.8);
  }

  /* ── Logo ───────────────────────────────────────────────────────── */
  .header-logo {
    text-decoration: none;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
  }
  .header-logo-img {
    height: 3.2rem;
    width: auto;
    display: block;
  }
  .header-logo:hover .header-logo-img {
    opacity: 0.75;
    transition: opacity 0.2s ease;
  }

  /* ── Hamburger button ──────────────────────────────────────────── */
  .hamburger {
    display: none; /* hidden on desktop */
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
    border-radius: 0.5rem;
    transition: background 0.2s;
  }
  .hamburger:hover {
    background: rgba(15, 23, 42, 0.05);
  }
  .hamburger__line {
    display: block;
    width: 1.25rem;
    height: 2px;
    background: #334155;
    border-radius: 1px;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  .hamburger.is-active .hamburger__line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .hamburger.is-active .hamburger__line:nth-child(2) {
    opacity: 0;
  }
  .hamburger.is-active .hamburger__line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ── Nav (desktop) ─────────────────────────────────────────────── */
  .header-nav {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .header-nav-link,
  .header-menu summary,
  .locale-menu summary {
    color: #475569;
    text-decoration: none;
    cursor: pointer;
    list-style: none;
    display: inline-flex;
    align-items: center;
  }
  .header-nav-link:hover,
  .header-menu summary:hover,
  .locale-menu summary:hover {
    color: #0f6e5b;
  }

  /* Remove default marker from details/summary */
  .header-menu summary::-webkit-details-marker,
  .locale-menu summary::-webkit-details-marker {
    display: none;
  }
  .header-menu summary::marker,
  .locale-menu summary::marker {
    content: '';
    display: none;
  }

  /* ── Chevron ────────────────────────────────────────────────────── */
  .chevron {
    display: inline-block;
    width: 0.4em;
    height: 0.4em;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg);
    margin-left: 0.3rem;
    position: relative;
    top: -0.1em;
    opacity: 0.5;
    transition: transform 0.2s ease, top 0.2s ease;
  }
  details[open] > summary .chevron {
    transform: rotate(-135deg);
    top: 0.1em;
  }

  /* ── Dropdown panels ───────────────────────────────────────────── */
  .header-menu,
  .locale-menu {
    position: relative;
  }
  .header-menu-panel,
  .locale-menu-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.75rem);
    display: grid;
    min-width: 16rem;
    gap: 0.25rem;
    padding: 0.6rem;
    border: 1px solid #e2e8f0;
    border-radius: 0.75rem;
    background: white;
    box-shadow: 0 16px 40px rgba(15, 23, 42, 0.12);
  }
  .header-menu-panel {
    left: 0;
    right: auto;
  }
  .calculator-panel {
    min-width: 18rem;
  }
  .header-menu-panel a,
  .locale-menu-panel a {
    border-radius: 0.5rem;
    padding: 0.55rem 0.7rem;
    color: #334155;
    font-size: 0.82rem;
    text-decoration: none;
  }
  .header-menu-panel a:hover,
  .locale-menu-panel a:hover,
  .locale-menu-panel a.is-current {
    background: #f0fdf4;
    color: #0f6e5b;
  }
  .header-menu-panel a.header-menu-all {
    margin-top: 0.35rem;
    border-top: 1px solid #e2e8f0;
    color: #0f6e5b;
    font-weight: 700;
  }

  /* ── Desktop: hide mobile-only locale, show desktop-locale ────── */
  .mobile-only-locale {
    display: none;
  }
  .desktop-locale {
    flex-shrink: 0;
    font-size: 0.875rem;
    font-weight: 600;
  }

  /* ── Mobile (< 760px) ──────────────────────────────────────────── */
  @media (max-width: 760px) {
    .hamburger {
      display: flex;
    }

    /* Hide the desktop locale selector */
    .desktop-locale {
      display: none;
    }
    /* Show the mobile locale selector inside nav */
    .mobile-only-locale {
      display: block;
    }

    .header-nav {
      /* Hidden by default, shown when .is-open */
      display: none;
      flex-direction: column;
      align-items: stretch;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      width: 100%;
      gap: 0;
      padding: 0.5rem 1rem 0.75rem;
      background: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid rgba(226, 232, 240, 0.8);
      box-shadow: 0 8px 24px rgba(15, 23, 42, 0.1);
      z-index: 10;
    }
    .header-nav.is-open {
      display: flex;
    }

    .header-nav-link,
    .header-menu summary,
    .locale-menu summary {
      display: flex;
      padding: 0.65rem 0.5rem;
      border-radius: 0.5rem;
      white-space: nowrap;
    }
    .header-nav-link:hover,
    .header-menu summary:hover,
    .locale-menu summary:hover {
      background: #f8fafc;
    }

    /* Dropdowns in mobile open inline */
    .header-menu-panel,
    .locale-menu-panel {
      position: static;
      box-shadow: none;
      border: none;
      border-radius: 0;
      padding: 0 0 0 1rem;
      min-width: unset;
    }
    .header-menu-panel a,
    .locale-menu-panel a {
      padding: 0.45rem 0.5rem;
    }
  }
</style>

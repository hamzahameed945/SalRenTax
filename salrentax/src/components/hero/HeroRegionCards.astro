---
/**
 * HeroRegionCards — dark cinematic hero with per-region photo cards.
 * Inspired by: bold centered headline + fanned image cards below.
 */
---

<section class="hero-section" aria-label="Choose your region">

  <!-- Badge -->
  <div class="hero-badge">
    <span>Free · No sign-up · Country-specific rules</span>
  </div>

  <!-- Headline -->
  <h1 class="hero-headline">
    Calculate Your Salary,<br />Rent &amp; Taxes
  </h1>

  <!-- Sub-headline -->
  <p class="hero-sub">
    Calculators built with real tax law for each country — not generic estimates.
    Pick your region to get started.
  </p>

  <!-- Region Cards -->
  <div class="cards-row" role="list">

    <!-- United States -->
    <a
      href="/en-us/"
      class="region-card"
      role="listitem"
      aria-label="United States calculators"
    >
      <div class="card-img-wrap">
        <img
          src="https://images.unsplash.com/photo-1485738422979-f5c462d49f74?w=600&q=80&auto=format&fit=crop"
          alt="Statue of Liberty, New York"
          width="600"
          height="400"
          loading="eager"
          decoding="async"
          class="card-img"
        />
        <div class="card-overlay"></div>
      </div>
      <div class="card-body">
        <div class="card-flag">🇺🇸</div>
        <h2 class="card-title">United States</h2>
        <ul class="card-features">
          <li>Paycheck &amp; take-home pay</li>
          <li>Salary ↔ hourly conversion</li>
          <li>Pay frequency converter</li>
          <li>Salary raise calculator</li>
          <li>Rent affordability</li>
        </ul>
        <span class="card-cta">Explore US Calculators →</span>
      </div>
    </a>

    <!-- Germany -->
    <a
      href="/de-de/"
      class="region-card"
      role="listitem"
      aria-label="Germany calculators"
    >
      <div class="card-img-wrap">
        <img
          src="https://images.unsplash.com/photo-1467269204594-9661b134dd2b?w=600&q=80&auto=format&fit=crop"
          alt="Brandenburg Gate, Berlin"
          width="600"
          height="400"
          loading="eager"
          decoding="async"
          class="card-img"
        />
        <div class="card-overlay"></div>
      </div>
      <div class="card-body">
        <div class="card-flag">🇩🇪</div>
        <h2 class="card-title">Deutschland</h2>
        <ul class="card-features">
          <li>Brutto → Netto Rechner</li>
          <li>Sozialversicherung 2026</li>
          <li>Mindestlohn Rechner</li>
          <li>Gesetzlicher Mindestlohn</li>
        </ul>
        <span class="card-cta">Gehaltsrechner öffnen →</span>
      </div>
    </a>

    <!-- Spain — center / featured -->
    <a
      href="/es-es/"
      class="region-card region-card--featured"
      role="listitem"
      aria-label="Spain calculators"
    >
      <div class="card-img-wrap">
        <img
          src="https://images.unsplash.com/photo-1539037116277-4db20889f2d4?w=600&q=80&auto=format&fit=crop"
          alt="Sagrada Família, Barcelona"
          width="600"
          height="400"
          loading="eager"
          decoding="async"
          class="card-img"
        />
        <div class="card-overlay"></div>
      </div>
      <div class="card-body">
        <div class="card-flag">🇪🇸</div>
        <h2 class="card-title">España</h2>
        <ul class="card-features">
          <li>Calculadora de nómina IRPF</li>
          <li>Deducciones Seguridad Social</li>
          <li>Sueldo neto 2026</li>
          <li>Retenciones IRPF</li>
        </ul>
        <span class="card-cta">Ver calculadoras →</span>
      </div>
    </a>

    <!-- Mexico -->
    <a
      href="/es-mx/"
      class="region-card"
      role="listitem"
      aria-label="Mexico calculators"
    >
      <div class="card-img-wrap">
        <img
          src="https://images.unsplash.com/photo-1518105779142-d975f22f1b0a?w=600&q=80&auto=format&fit=crop"
          alt="Angel of Independence, Mexico City"
          width="600"
          height="400"
          loading="eager"
          decoding="async"
          class="card-img"
        />
        <div class="card-overlay"></div>
      </div>
      <div class="card-body">
        <div class="card-flag">🇲🇽</div>
        <h2 class="card-title">México</h2>
        <ul class="card-features">
          <li>Calculadora ISR 2026</li>
          <li>Sueldo neto mensual</li>
          <li>IMSS &amp; retenciones</li>
          <li>Tablas ISR actualizadas</li>
        </ul>
        <span class="card-cta">Ver calculadoras →</span>
      </div>
    </a>

  </div><!-- /cards-row -->

  <!-- Coming soon strip -->
  <p class="coming-soon-note">
    Coming soon: <strong>United Kingdom</strong> · <strong>Ireland</strong> · <strong>Brazil</strong> · <strong>Netherlands</strong>
  </p>

</section>

<style>
  /* ── Root section ────────────────────────────────────────────── */
  .hero-section {
    background: #0a0a0a;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 4rem 1.5rem 5rem;
    gap: 0;
  }

  /* ── Badge ────────────────────────────────────────────────────── */
  .hero-badge {
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 9999px;
    padding: 0.35rem 1.1rem;
    font-size: 0.8rem;
    color: rgba(255,255,255,0.55);
    letter-spacing: 0.02em;
    margin-bottom: 2rem;
  }

  /* ── Headline ─────────────────────────────────────────────────── */
  .hero-headline {
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    font-weight: 800;
    line-height: 1.1;
    color: #fff;
    text-align: center;
    letter-spacing: -0.03em;
    margin: 0 0 1.25rem;
    max-width: 820px;
  }

  /* ── Sub headline ─────────────────────────────────────────────── */
  .hero-sub {
    font-size: clamp(0.95rem, 2vw, 1.1rem);
    color: rgba(255,255,255,0.5);
    text-align: center;
    max-width: 540px;
    line-height: 1.65;
    margin: 0 0 3.5rem;
  }

  /* ── Cards row ────────────────────────────────────────────────── */
  .cards-row {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 0.75rem;
    width: 100%;
    max-width: 1100px;
  }

  /* ── Individual card ──────────────────────────────────────────── */
  .region-card {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    border-radius: 1rem;
    overflow: hidden;
    text-decoration: none;
    color: #fff;
    background: #111;
    cursor: pointer;
    /* default (collapsed) height */
    height: 380px;
    transition: flex 0.45s cubic-bezier(0.4,0,0.2,1),
                height 0.45s cubic-bezier(0.4,0,0.2,1),
                box-shadow 0.3s ease,
                transform 0.3s ease;
    box-shadow: 0 4px 24px rgba(0,0,0,0.5);
    outline-offset: 3px;
  }

  /* Featured / center card is taller by default */
  .region-card--featured {
    flex: 1.35 1 0;
    height: 430px;
  }

  /* Hover expand */
  .region-card:hover,
  .region-card:focus-visible {
    flex: 2.2 1 0;
    height: 460px;
    box-shadow: 0 12px 48px rgba(0,0,0,0.7);
    transform: translateY(-6px);
    outline: 2px solid rgba(255,255,255,0.3);
  }

  .region-card--featured:hover,
  .region-card--featured:focus-visible {
    height: 490px;
  }

  /* ── Card image ───────────────────────────────────────────────── */
  .card-img-wrap {
    position: absolute;
    inset: 0;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.6s ease, filter 0.4s ease;
    filter: grayscale(30%) brightness(0.55);
  }

  .region-card:hover .card-img,
  .region-card:focus-visible .card-img {
    transform: scale(1.06);
    filter: grayscale(0%) brightness(0.45);
  }

  /* Dark gradient overlay */
  .card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0,0,0,0.92) 0%,
      rgba(0,0,0,0.45) 55%,
      rgba(0,0,0,0.1) 100%
    );
  }

  /* ── Card body ────────────────────────────────────────────────── */
  .card-body {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.5rem 1.25rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .card-flag {
    font-size: 1.9rem;
    line-height: 1;
    margin-bottom: 0.15rem;
  }

  .card-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: #fff;
    margin: 0;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  /* Feature list — hidden until hover */
  .card-features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    /* start invisible & shifted down */
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.35s ease 0.1s, transform 0.35s ease 0.1s;
    pointer-events: none;
  }

  .region-card:hover .card-features,
  .region-card:focus-visible .card-features {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .card-features li {
    font-size: 0.8rem;
    color: rgba(255,255,255,0.72);
    padding-left: 1rem;
    position: relative;
  }

  .card-features li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: #4ade80;
    font-size: 0.75rem;
  }

  /* CTA arrow text */
  .card-cta {
    display: inline-block;
    margin-top: 0.6rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: #4ade80;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.3s ease 0.2s, transform 0.3s ease 0.2s;
  }

  .region-card:hover .card-cta,
  .region-card:focus-visible .card-cta {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Coming soon strip ────────────────────────────────────────── */
  .coming-soon-note {
    margin-top: 2.5rem;
    font-size: 0.78rem;
    color: rgba(255,255,255,0.3);
    text-align: center;
    letter-spacing: 0.01em;
  }

  .coming-soon-note strong {
    color: rgba(255,255,255,0.45);
    font-weight: 500;
  }

  /* ── Responsive — stack on mobile ────────────────────────────── */
  @media (max-width: 700px) {
    .cards-row {
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
    }

    .region-card,
    .region-card--featured {
      height: 260px;
      flex: none;
    }

    .region-card:hover,
    .region-card:focus-visible,
    .region-card--featured:hover,
    .region-card--featured:focus-visible {
      height: 300px;
      transform: none;
      flex: none;
    }

    /* Always show features on mobile (no hover) */
    .card-features,
    .card-cta {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 400px) {
    .hero-section {
      padding: 3rem 1rem 4rem;
    }
  }
</style>

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "payrentax",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-01",
  // Explicit so `wrangler deploy` never silently re-enables the
  // workers.dev URL on its own — it now only follows this file.
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Run the Worker (src/worker.ts) first on every request, not just on
    // asset misses, so the domain redirect always runs before anything is
    // served from ./dist.
    "run_worker_first": true
  }
}
